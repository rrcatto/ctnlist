# Runs @POD@-worker.service every minute (deploy/systemd/ctnlist-worker@.timer for the pod), written by ctnlist-podman.sh
# into ~/.config/systemd/user/.

[Unit]
Description=Run the ctnlist catto-mail worker (@KIT@) every minute

[Timer]
OnCalendar=minutely
AccuracySec=5s

[Install]
WantedBy=timers.target
