# The server's own nginx in front of a ctnlist pod (deploy/podman/README.md, step 3). Root puts these into the site's
# server block for HTTPS (with a control panel such as Virtualmin: the domain's own nginx file), in place of the
# site's "location /" and its PHP handling; <port> is the pod's port on 127.0.0.1 (ctnlist-podman.sh --port).
# Check with nginx -t, then reload.
#
# nginx keeps ports 80 and 443 and the certificate. The pod answers plain HTTP with a redirect to HTTPS, so a server
# block that answers both ports needs nothing more for that.

# 1. In the http context, once per server (e.g. /etc/nginx/conf.d/ctnlist-log.conf): an access log format without
#    query strings. The sign-in link (/auth/verify?token=...) carries a one-time token, and other links carry
#    subscriber identifiers. Otherwise the combined format, so log analysers (AWStats) still read the file.
log_format ctnlist_combined '$remote_addr - $remote_user [$time_local] "$request_method $uri $server_protocol" $status $body_bytes_sent "-" "$http_user_agent"';

# 2. In the site's server block: the site's access log in that format (keep the file the server block already names).
access_log /var/log/nginx/<site>.access.log ctnlist_combined;

# 3. In the site's server block, in place of its "location /" and any PHP location (^~ keeps a PHP location the
#    control panel writes again from taking .php addresses away from the pod). Certificate renewal keeps its own
#    files: leave the site's "location ^~ /.well-known/" as it is.
location ^~ / {
    proxy_pass http://127.0.0.1:<port>;
    proxy_set_header Host $host;
    # The visitor's address, and only that: whatever the visitor sent as X-Forwarded-For is not passed on.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Queue runs and subscriber imports can take minutes (the pod's PHP waits 300 seconds too).
    proxy_read_timeout 300s;
    # A subscriber import file (at most 20 MB) or a pasted address list; the pod refuses more.
    client_max_body_size 32m;
    # Mailpit's page (ctnlist-podman.sh --mailpit) follows new mail over a WebSocket.
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $http_connection;
}
