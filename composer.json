{
  "name": "rrcatto/ctnlist",
  "description": "Modernised ctnlist mailing-list application",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.4 <9.0",
    "ext-json": "*",
    "ext-pdo": "*",
    "bcosca/fatfree-core": "^3.9.2",
    "robmorgan/phinx": "^0.16.12",
    "symfony/mailer": "^7.4",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "classmap": ["classes/"]
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "platform": {
      "php": "8.4.0"
    }
  },
  "scripts": {
    "analyse": "php -d memory_limit=-1 vendor/bin/phpstan analyse",
    "migrate-paralegal": "vendor/bin/phinx migrate -c phinx/phinx-paralegal.php -e production",
    "migrate-banlist": "vendor/bin/phinx migrate -c phinx/phinx-banlist.php -e production",
    "status-paralegal": "vendor/bin/phinx status -c phinx/phinx-paralegal.php -e production",
    "status-banlist": "vendor/bin/phinx status -c phinx/phinx-banlist.php -e production",
    "test": "vendor/bin/phpunit"
  }
}
