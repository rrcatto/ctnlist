{
  "name": "rrcatto/ctnlist",
  "description": "Modernised ctnlist mailing-list application",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.4.1 <9.0",
    "ext-fileinfo": "*",
    "ext-filter": "*",
    "ext-gd": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "ext-pdo_pgsql": "*",
    "ext-session": "*",
    "doctrine/dbal": "^4.4",
    "doctrine/doctrine-bundle": "^3.3",
    "robmorgan/phinx": "^0.16.12",
    "symfony/asset": "8.1.*",
    "symfony/asset-mapper": "8.1.*",
    "symfony/console": "8.1.*",
    "symfony/dotenv": "8.1.*",
    "symfony/form": "8.1.*",
    "symfony/framework-bundle": "8.1.*",
    "symfony/html-sanitizer": "8.1.*",
    "symfony/http-client": "8.1.*",
    "symfony/mailer": "8.1.*",
    "symfony/rate-limiter": "8.1.*",
    "symfony/runtime": "8.1.*",
    "symfony/security-bundle": "8.1.*",
    "symfony/security-csrf": "8.1.*",
    "symfony/twig-bundle": "8.1.*",
    "symfony/validator": "8.1.*",
    "symfony/yaml": "8.1.*"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "platform": {
      "php": "8.4.1"
    },
    "allow-plugins": {
      "symfony/runtime": true
    }
  },
  "scripts": {
    "analyse": "php -d memory_limit=-1 vendor/bin/phpstan analyse",
    "migrate-paralegal": "vendor/bin/phinx migrate -c config/phinx/phinx-paralegal.php -e production",
    "migrate-banlist": "vendor/bin/phinx migrate -c config/phinx/phinx-banlist.php -e production",
    "status-paralegal": "vendor/bin/phinx status -c config/phinx/phinx-paralegal.php -e production",
    "status-banlist": "vendor/bin/phinx status -c config/phinx/phinx-banlist.php -e production",
    "test": "vendor/bin/phpunit"
  }
}
