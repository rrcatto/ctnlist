# Copy to <installation>/.env (one level above public_html), chmod 640, owned by
# the deploying user with the PHP-FPM group. Secrets below are blank on purpose:
# generate each one; never reuse values from documentation or another installation.
# Check the result with: CTNLIST_INSTANCE_DIR=<installation> bin/console ctnlist:diagnose --production

# Application: APP_ENV is prod, dev or test (production: prod and APP_DEBUG=false)
APP_ENV=prod
APP_DEBUG=false
APP_TIMEZONE=Africa/Johannesburg
# Required; generate, never type: openssl rand -hex 32
APP_SECRET=
# Required, unique per installation: openssl rand -hex 16
APP_INSTANCE_ID=
# Encrypts the secret settings stored from the Settings page (today the SMTP
# server, MAILER_DSN) and is required to decrypt all of them: 32 random bytes,
# Base64-encoded. Generate with: openssl rand -base64 32
# Only needed once a secret is saved there. Never change or lose it while
# encrypted settings exist (they become unreadable); see README "Settings page".
APP_SETTINGS_KEY=

APP_BASE_URL=https://example.com/
APP_DOMAIN=example.com
APP_LIST_NAME="Example Mailing List"
APP_ORGANISATION="Example Organisation"
APP_ADMIN_EMAIL=admin@example.com
APP_ARCHIVE_ENABLED=false

# Comma-separated reverse-proxy addresses whose X-Forwarded-* headers are
# trusted (client IP and HTTPS detection). Only the proxy in front of this
# server (127.0.0.1 when nginx terminates TLS on the same host and passes
# X-Forwarded-*); empty when no proxy sets them. Never 0.0.0.0/0.
TRUSTED_PROXIES=127.0.0.1

# Public site details
APP_ABOUT_US="About this organisation"
APP_STREET_ADDRESS=""
APP_TELEPHONE=""
APP_WHATSAPP=""
APP_WHATSAPP_URL=""
APP_ADVERTISE_URL=""
APP_FACEBOOK_URL=""
APP_X_URL=""
APP_BOOKING_URL=""
APP_CONTACT_URL="{BaseURL}contact-form/{suid}/{muid}"

# Main PostgreSQL database
DB_DRIVER=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ctnlist
DB_USER=ctnlist
# A generated password (openssl rand -base64 24); use DB_SSLMODE=require for a remote server.
DB_PASS=""
DB_SSLMODE=prefer

# Global suppression source: banlist (separate PostgreSQL database, below) or
# none (development only; suppression checks always pass).
SUPPRESSION_PROVIDER=banlist

# External configuration for the shared global suppression database.
# This directory is deliberately outside the ctnlist source tree.
GDB_ENV_DIRECTORY=/path/to/external/config
GDB_ENV_FILE=ban.env

# Mail transport. These, and the site, contact, subscription and sign-in
# settings below, can be overridden by administrators at Admin -> Settings
# (stored in the database; this file is never written).
# Transactional mail (sign-in links, notifications), e.g. smtps://USER:PASS@smtp.provider.tld:465
# (URL-encode special characters); or leave empty here and set it at Settings > SMTP (stored encrypted).
MAILER_DSN=
MAIL_FROM_ADDRESS=info@example.com
MAIL_FROM_NAME="Example Mailing List"
MAIL_ADMIN_ADDRESS=admin@example.com
MAIL_ADMIN_NAME="Administrator"

MAIL_BOUNCE_ADDRESS=bounce@example.com
MAIL_TEST_ADDRESS=admin@example.com


# catto-mail smarthost: delivers all campaign content (queue sends, proofs,
# resends, forwards) and validates addresses, through its HTTPS /v1 API and
# signed webhooks only. Infrastructure secrets: set them here, never in
# Settings; never commit them. A changed key applies from the next request.
#   CATTOMAIL_API_BASE_URL  the catto-mail HTTPS origin, e.g. https://mail.example.com
#   CATTOMAIL_API_KEY       this installation's catto-mail API key (shown once by catto-mail)
#   CATTOMAIL_WEBHOOK_SECRET          signing secret of the webhook endpoint
#                                     <APP_BASE_URL>cattomail/webhook registered in catto-mail
#   CATTOMAIL_WEBHOOK_SECRET_PREVIOUS the rotated-out secret, during catto-mail's overlap window only
#   CATTOMAIL_GLOBAL_OPTOUT_ENABLED   true only when the catto-mail operator has granted
#                                     this client the global-opt-out capability
#   CATTOMAIL_CA_FILE       optional CA bundle (development certificates only)
#   CATTOMAIL_API_CONNECT_HOST development/test only: reach the API host via this name (cattomail-dev network)
#   CATTOMAIL_TIMEOUT_SECONDS         API request timeout in seconds (min 1)
#   CATTOMAIL_RECONCILE_AFTER_SECONDS poll jobs without a final webhook after this long
#   CATTOMAIL_TRACK_OPENS / CATTOMAIL_TRACK_CLICKS  catto-mail open/click tracking per job
#   CATTOMAIL_WEBHOOK_BODY_RETENTION_DAYS raw bodies of processed webhook events are removed after this (min 7)
#   CATTOMAIL_DETAIL_RETENTION_DAYS   refused jobs' rendered content and superseded validation results (min 30)
CATTOMAIL_API_BASE_URL=
CATTOMAIL_API_KEY=
CATTOMAIL_WEBHOOK_SECRET=
CATTOMAIL_WEBHOOK_SECRET_PREVIOUS=
CATTOMAIL_GLOBAL_OPTOUT_ENABLED=false
CATTOMAIL_CA_FILE=
CATTOMAIL_API_CONNECT_HOST=
CATTOMAIL_TIMEOUT_SECONDS=15
CATTOMAIL_RECONCILE_AFTER_SECONDS=900
CATTOMAIL_TRACK_OPENS=false
CATTOMAIL_TRACK_CLICKS=false
CATTOMAIL_WEBHOOK_BODY_RETENTION_DAYS=90
CATTOMAIL_DETAIL_RETENTION_DAYS=365
# Site Log rows older than this many days are removed by ctnlist:maintenance; 0 keeps them (as v5 did).
APP_SITELOG_RETENTION_DAYS=0

# Optional JSON array for legacy cross-installation subscriber synchronisation.
SYNC_DATABASES_JSON='[]'

# Contact form
CONTACT_MAIL_ADDRESS=admin@example.com
CONTACT_MAIL_NAME="Example Organisation"
CONTACT_MAIL_SUBJECT="Your message has been received"
# Contact-form log; defaults to the installation's logs/contact.log.
#CONTACT_LOG_FILE=/var/www/<installation>/logs/contact.log
# Import logs and export files; defaults to the installation's logs/.
#APP_LOG_DIR=/var/www/<installation>/logs

# Passwordless authentication
AUTH_MAGIC_LINK_TTL=1800
AUTH_SESSION_TTL=86400
AUTH_SESSION_COOKIE=ctnlist_session
AUTH_MAGIC_LINK_MAX_PER_EMAIL=5
AUTH_MAGIC_LINK_EMAIL_WINDOW=900
AUTH_MAGIC_LINK_MAX_PER_IP=20
AUTH_MAGIC_LINK_IP_WINDOW=3600
# Forwards and resends per subscriber per hour; contact messages per hour per IP and per address.
FORWARD_RATE_LIMIT=10
CONTACT_RATE_LIMIT=5
PHP_SESSION_COOKIE=ctnlist_php_session

# Optional legacy message placeholders
SUBSCRIPTION_MESSAGE="Manage your list subscriptions: {preferences}"
SUBSCRIPTION_CONFIRM_MESSAGE="Confirm your list subscription: {confirm}"
SUBSCRIPTION_CONFIRM_LEVEL=0
SUBSCRIPTION_CONFIRM_AMOUNT=0
