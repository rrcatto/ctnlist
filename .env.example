APP_LIST_NAME="The Paralegal Zone"
APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=Africa/Johannesburg
APP_SECRET=replace-with-a-long-random-secret

APP_DOMAIN=domain
APP_BASE_URL=http://localhost/
APP_ADMIN_EMAIL=admin@domain

APP_ORGANISATION="organisation"
APP_TELEPHONE="cell"
APP_WHATSAPP="https://wa.me/+int-cell"

DB_DRIVER=pgsql
DB_HOST=hostname
DB_PORT=5432
DB_NAME=dbname
DB_USER=dbuser
DB_PASS=password
DB_SSLMODE=prefer

MAILER_DSN=smtp://username:password@hostname:587?require_tls=true
MAIL_FROM_ADDRESS=info@domain
MAIL_FROM_NAME="From"
MAIL_ADMIN_ADDRESS=admin@domain
MAIL_ADMIN_NAME="Admin"

AUTH_MAGIC_LINK_TTL=900
AUTH_MAGIC_LINK_MAX_PER_EMAIL=5
AUTH_MAGIC_LINK_MAX_PER_IP=20
AUTH_SESSION_TTL=2419200
AUTH_SESSION_COOKIE=ctnlist_session
