APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=Africa/Johannesburg
APP_BASE_URL=http://localhost/
APP_SECRET=replace-with-a-long-random-secret

DB_DRIVER=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ctnlist
DB_USER=ctnlist
DB_PASS=change-me
DB_SSLMODE=prefer

MAILER_DSN=smtp://username:password@127.0.0.1:587?require_tls=true
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=ctnlist
MAIL_ADMIN_ADDRESS=admin@example.com

AUTH_MAGIC_LINK_TTL=900
AUTH_MAGIC_LINK_MAX_PER_EMAIL=5
AUTH_MAGIC_LINK_MAX_PER_IP=20
AUTH_SESSION_TTL=2419200
AUTH_SESSION_COOKIE=ctnlist_session
