<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnWarning="true"
         failOnRisky="true">
    <php>
        <!-- The smoke suite drives the running podman stack over HTTP from
             inside the app container; override these for another instance. -->
        <env name="SMOKE_BASE_URL" value="http://web" force="false"/>
        <env name="SMOKE_DB_DSN" value="pgsql:host=db;port=5432;dbname=ctnlist" force="false"/>
        <env name="SMOKE_DB_USER" value="ctnlist" force="false"/>
        <env name="SMOKE_DB_PASS" value="ctnlist" force="false"/>
        <env name="SMOKE_ADMIN_EMAIL" value="admin@ctnlist.test" force="false"/>
    </php>
    <testsuites>
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="smoke">
            <directory>tests/Smoke</directory>
        </testsuite>
    </testsuites>
</phpunit>
