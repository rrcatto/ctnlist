#!/usr/bin/env bash
# ctnlist podman development environment helper.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

APP=ctnlist_app_1
DB=ctnlist_db_1
ADMIN_EMAIL_DEFAULT=admin@ctnlist.test

# podman-compose itself rather than `podman compose`, which prefers any
# docker-compose on the PATH (other container names, and it needs the Docker
# API socket). The container names above are podman-compose's. The containers
# run in the pod pod_ctnlist (Debian's podman-compose 1.0.6 creates none by
# default, and only reads the setting from the command line).
compose() {
    command -v podman-compose >/dev/null || { echo "bin/dev needs podman-compose (Debian, Ubuntu, Mint: sudo apt install podman-compose)." >&2; exit 1; }
    podman-compose --in-pod 1 -f "$ROOT/compose.yaml" "$@"
}
in_app() { podman exec -i "$APP" "$@"; }
in_app_tty() { if [ -t 0 ]; then podman exec -it "$APP" "$@"; else podman exec -i "$APP" "$@"; fi; }
psql_db() { podman exec -i "$DB" psql -v ON_ERROR_STOP=1 -U ctnlist -d ctnlist "$@"; }

random_hex() { od -An -tx1 -N"$1" /dev/urandom | tr -d ' \n'; }
random_base64() { head -c "$1" /dev/urandom | base64 | tr -d '\n'; }

# A self-signed certificate for the development HTTPS listener (port 8543),
# generated once per checkout and never committed.
ensure_tls() {
    local dir=dev/podman/tls
    [ -f "$dir/ctnlist-dev.crt" ] && [ -f "$dir/ctnlist-dev.key" ] && return 0
    mkdir -p "$dir"
    openssl req -x509 -newkey rsa:2048 -nodes -days 825 -subj "/CN=localhost" \
        -addext "subjectAltName=DNS:localhost,DNS:ctnlist-web,IP:127.0.0.1" \
        -keyout "$dir/ctnlist-dev.key" -out "$dir/ctnlist-dev.crt" 2>/dev/null
    chmod 644 "$dir/ctnlist-dev.crt" "$dir/ctnlist-dev.key"
    echo "Generated the development TLS certificate in $dir"
}

# catto-mail development route (README): a dedicated internal network that
# ctnlist's web (alias ctnlist-web, for webhooks) and app (for the API)
# containers join. catto-mail joins it from its side; nothing here touches
# catto-mail or its network.
CATTOMAIL_NETWORK=cattomail-dev
cattomail_link() {
    podman network exists "$CATTOMAIL_NETWORK" || podman network create --internal "$CATTOMAIL_NETWORK" >/dev/null
    for pair in "ctnlist_web_1:ctnlist-web" "ctnlist_app_1:ctnlist-app"; do
        local container="${pair%%:*}" alias="${pair##*:}"
        if podman inspect "$container" --format '{{range $k, $v := .NetworkSettings.Networks}}{{$k}} {{end}}' | grep -qw "$CATTOMAIL_NETWORK"; then
            echo "$container is already on $CATTOMAIL_NETWORK"
        else
            podman network connect --alias "$alias" "$CATTOMAIL_NETWORK" "$container"
            echo "Connected $container to $CATTOMAIL_NETWORK as $alias"
        fi
    done
}

# After the containers are recreated (bin/dev up): re-attach them to the
# shared catto-mail network, but only when it exists (catto-mail is optional
# in development; nothing is created and up never fails because of it).
cattomail_relink() {
    if podman network exists "$CATTOMAIL_NETWORK" 2>/dev/null; then
        cattomail_link | sed 's/^/catto-mail route: /'
    fi
}

# What the catto-mail development route needs, and what is missing. Shows
# which settings are present in dev/podman/ctnlist.env, never their values.
cattomail_status() {
    local env_file="dev/podman/ctnlist.env" ok=1
    say() { printf '  %-44s %s\n' "$1" "$2"; }
    echo "catto-mail development route"
    if ! podman network exists "$CATTOMAIL_NETWORK" 2>/dev/null; then
        say "network $CATTOMAIL_NETWORK" "missing (bin/dev cattomail-link creates it)"; ok=0
    else
        local members; members="$(podman network inspect "$CATTOMAIL_NETWORK" --format '{{range .Containers}}{{.Name}} {{end}}')"
        say "network $CATTOMAIL_NETWORK" "exists: ${members:-no containers}"
        for c in ctnlist_web_1 ctnlist_app_1; do
            if grep -qw "$c" <<<"$members"; then say "  $c" "attached"; else say "  $c" "NOT attached (bin/dev cattomail-link)"; ok=0; fi
        done
    fi
    local host; host="$(sed -n 's/^CATTOMAIL_API_CONNECT_HOST=//p' "$env_file" 2>/dev/null | tail -1)"
    [ -n "$host" ] || { say "CATTOMAIL_API_CONNECT_HOST" "not set (expected: catto-mail)"; ok=0; host=catto-mail; }
    if podman exec "$APP" getent hosts "$host" >/dev/null 2>&1; then say "catto-mail reachable as $host" "yes"
    else say "catto-mail reachable as $host" "NO: catto-mail must join $CATTOMAIL_NETWORK with that alias (catto-mail side)"; ok=0; fi
    for key in CATTOMAIL_API_BASE_URL CATTOMAIL_API_KEY CATTOMAIL_WEBHOOK_SECRET CATTOMAIL_CA_FILE; do
        if grep -q "^$key=." "$env_file" 2>/dev/null; then say "$key" "set"; else say "$key" "not set in $env_file"; ok=0; fi
    done
    if grep -q '^APP_BASE_URL=https://' "$env_file" 2>/dev/null; then say "APP_BASE_URL" "https (subscription mail possible)"
    else say "APP_BASE_URL" "not https: subscription mail needs https://localhost:8543/"; ok=0; fi
    echo "  catto-mail side (not checkable from here): ctnlist-web in APP_WEBHOOK_ALLOWED_PRIVATE_HOSTS,"
    echo "  an active client with the sending domain, its API key and the webhook endpoint http://ctnlist-web/cattomail/webhook."
    echo "  Then: Admin > Delivery > Check connection, or bin/dev console ctnlist:cattomail:check."
    [ "$ok" = 1 ]
}

# Save catto-mail's development certificate, read from its public HTTPS port,
# for CATTOMAIL_CA_FILE (it is self-signed).
cattomail_ca() {
    local endpoint="${1:-127.0.0.1:8443}"
    echo | openssl s_client -connect "$endpoint" -servername localhost -showcerts 2>/dev/null \
        | openssl x509 -outform PEM > dev/podman/cattomail-ca.pem
    openssl x509 -in dev/podman/cattomail-ca.pem -noout -subject -enddate
    echo "Saved dev/podman/cattomail-ca.pem; set CATTOMAIL_CA_FILE to its path inside the app container: <the compose.yaml shared-code path>/dev/podman/cattomail-ca.pem"
}

# Settings ctnlist no longer reads. ensure-env only warns about them; it never
# edits lines of an existing environment file other than an empty APP_SETTINGS_KEY.
OBSOLETE_ENV="MAIL_UNSUBSCRIBE_ADDRESS MAIL_SMTP_SERVERS_JSON MAIL_BATCH_SIZE MAIL_BATCH_DELAY MAIL_BOUNCE_LIMIT APP_STORE_URL MAIL_RATE_PER_MINUTE"

ensure_env() {
    ensure_dev_env
    local env_file="${CTNLIST_DEV_ENV_FILE:-dev/podman/ctnlist.env}" key
    for key in $OBSOLETE_ENV; do
        if grep -q "^$key=" "$env_file"; then
            echo "Note: $env_file sets $key, which ctnlist no longer uses; the line can be removed." >&2
        fi
    done
    # The smoke-test installation: the development settings with its own
    # database and never a catto-mail (the smoke tests expect none, and must
    # not send through a development catto-mail connected to the dev
    # installation). Regenerated every time (gitignored), rewritten in place
    # so a running container's bind mount sees it.
    if [ -z "${CTNLIST_DEV_ENV_FILE:-}" ]; then
        { echo "# Generated by bin/dev from ctnlist.env for the smoke-test installation; do not edit."
          grep -Ev '^(DB_NAME|CATTOMAIL_API_BASE_URL|CATTOMAIL_API_KEY|CATTOMAIL_WEBHOOK_SECRET|CATTOMAIL_WEBHOOK_SECRET_PREVIOUS|CATTOMAIL_CA_FILE|CATTOMAIL_API_CONNECT_HOST)=' "$env_file"
          echo "DB_NAME=ctnlist_smoke"
          printf '%s=\n' CATTOMAIL_API_BASE_URL CATTOMAIL_API_KEY CATTOMAIL_WEBHOOK_SECRET CATTOMAIL_WEBHOOK_SECRET_PREVIOUS CATTOMAIL_CA_FILE CATTOMAIL_API_CONNECT_HOST
        } > dev/podman/smoke.env.tmp
        cat dev/podman/smoke.env.tmp > dev/podman/smoke.env && rm -f dev/podman/smoke.env.tmp
        chmod 644 dev/podman/smoke.env
    fi
}

# Generate the instance .env from the template on first use, with secrets
# that are random per checkout and never committed. An existing file is kept;
# only a missing or empty APP_SETTINGS_KEY is filled in, never replaced. The
# file is rewritten in place (same inode), so a running container's bind
# mount keeps seeing it. CTNLIST_DEV_ENV_FILE overrides the path (tests).
ensure_dev_env() {
    local env_file="${CTNLIST_DEV_ENV_FILE:-dev/podman/ctnlist.env}"
    if [ -f "$env_file" ]; then
        if ! grep -q '^APP_SETTINGS_KEY=.' "$env_file"; then
            local content key
            key="$(random_base64 32)"
            if grep -q '^APP_SETTINGS_KEY=' "$env_file"; then
                # Fill the empty entry where it is; every other line stays as written.
                content="$(awk -v key="$key" '/^APP_SETTINGS_KEY=$/ && !done { print "APP_SETTINGS_KEY=" key; done = 1; next } !/^APP_SETTINGS_KEY=$/' "$env_file")"
            else
                content="$(cat "$env_file")"$'\n'"APP_SETTINGS_KEY=$key"
            fi
            # Rewritten in place (same inode), so a running container's bind mount sees it.
            printf '%s\n' "$content" > "$env_file"
            echo "Added APP_SETTINGS_KEY to $env_file"
        fi
        return 0
    fi
    sed -e "s/^APP_SECRET=$/APP_SECRET=$(random_hex 32)/" \
        -e "s/^APP_INSTANCE_ID=$/APP_INSTANCE_ID=$(random_hex 16)/" \
        -e "s|^APP_SETTINGS_KEY=$|APP_SETTINGS_KEY=$(random_base64 32)|" \
        dev/podman/ctnlist.env.dist > "$env_file"
    # Readable by www-data, which maps to an unrelated host UID under rootless podman.
    chmod 644 "$env_file"
    echo "Generated $env_file"
}

# The test databases, migrated alongside the development one: ctnlist_test
# (integration tests, each in a rolled-back transaction), ctnlist_banlist_test
# (the banlist checker) and ctnlist_smoke (the smoke installation).
ensure_test_db() {
    local db
    for db in ctnlist_test ctnlist_banlist_test ctnlist_smoke; do
        if [ "$(psql_db -Atc "SELECT 1 FROM pg_database WHERE datname = '$db'")" != "1" ]; then
            psql_db -qc "CREATE DATABASE $db"
        fi
    done
    podman exec -i -e DB_NAME=ctnlist_test "$APP" composer migrate-paralegal >/dev/null
    # The app container's working directory is the shared-code path.
    podman exec -i -e GDB_ENV_FILE=banlist-test.env "$APP" sh -c 'GDB_ENV_DIRECTORY="$PWD/dev/podman" composer migrate-banlist' >/dev/null
    podman exec -i -e DB_NAME=ctnlist_smoke "$APP" composer migrate-paralegal >/dev/null
    smoke_psql -q -v email="$ADMIN_EMAIL_DEFAULT" < dev/podman/seed-admin.sql >/dev/null
}

smoke_psql() { podman exec -i "$DB" psql -v ON_ERROR_STOP=1 -U ctnlist -d ctnlist_smoke "$@"; }

# The smoke tests' database is recreated for every test run with only the ALL
# list and the administrator (append-only consent rows cannot be deleted, so
# fixtures are discarded with the database).
reset_smoke_db() {
    psql_db -qc "DROP DATABASE IF EXISTS ctnlist_smoke WITH (FORCE)" -c "CREATE DATABASE ctnlist_smoke" >/dev/null
    podman exec -i -e DB_NAME=ctnlist_smoke "$APP" composer migrate-paralegal >/dev/null
    smoke_psql -q -v email="$ADMIN_EMAIL_DEFAULT" < dev/podman/seed-admin.sql >/dev/null
}

same_fingerprint() { [ "$1" = "$2" ] || { echo "before: $1"; echo "after:  $2"; return 1; }; }

# Row counts of the development database's application data (not the Site
# Log, sessions or sign-in records, which browsing the dev site changes).
dev_db_fingerprint() {
    psql_db -Atc "SELECT string_agg(t || '=' || n, ' ' ORDER BY t) FROM (
        SELECT 'subscribers' t, COUNT(*) n FROM subscribers UNION ALL SELECT 'list_subscribers', COUNT(*) FROM list_subscribers
        UNION ALL SELECT 'list_subscription_events', COUNT(*) FROM list_subscription_events UNION ALL SELECT 'lists', COUNT(*) FROM lists
        UNION ALL SELECT 'messages', COUNT(*) FROM messages UNION ALL SELECT 'templates', COUNT(*) FROM templates
        UNION ALL SELECT 'archives', COUNT(*) FROM archives UNION ALL SELECT 'queue', COUNT(*) FROM queue
        UNION ALL SELECT 'sendlog', COUNT(*) FROM sendlog UNION ALL SELECT 'smlog', COUNT(*) FROM smlog
        UNION ALL SELECT 'roles', COUNT(*) FROM roles UNION ALL SELECT 'subscriber_roles', COUNT(*) FROM subscriber_roles
        UNION ALL SELECT 'options', COUNT(*) FROM options UNION ALL SELECT 'subscriber_images', COUNT(*) FROM subscriber_images
        UNION ALL SELECT 'cattomail_runs', COUNT(*) FROM cattomail_runs UNION ALL SELECT 'cattomail_validation_jobs', COUNT(*) FROM cattomail_validation_jobs
        UNION ALL SELECT 'cattomail_webhook_events', COUNT(*) FROM cattomail_webhook_events UNION ALL SELECT 'cattomail_global_optouts', COUNT(*) FROM cattomail_global_optouts) c"
}

# PHP-FPM runs as www-data and must be able to create its cache under
# var/cache; tests run as root and would otherwise create it root-owned.
ensure_instance_dirs() {
    in_app install -d -o www-data -g www-data /var/www/ctnlist/var/cache /var/www/ctnlist-smoke/var/cache
}

wait_for_db() {
    for _ in $(seq 1 60); do
        if podman exec "$DB" pg_isready -q -U ctnlist -d ctnlist 2>/dev/null; then
            return 0
        fi
        sleep 1
    done
    echo "PostgreSQL did not become ready." >&2
    return 1
}

usage() {
    cat <<'EOF'
Usage: bin/dev <command> [args]

  up                 Build and start containers, composer install (first run), clear the cache, migrate (also the test databases), seed admin
  down               Stop and remove containers (data volumes are kept)
  restart            down + up
  ps | logs [svc]    Container status / follow logs (app, web, db, mailpit)
  migrate            Run Phinx migrations on the ctnlist database
  status             Show Phinx migration status
  seed-admin [email] Create/promote an administrator (default admin@ctnlist.test)
  composer <args>    Run Composer in the app container
  php <args>         Run PHP in the app container
  console <args>     Run bin/console (as www-data) for the dev installation
  analyse            Run PHPStan (composer analyse)
  test [args]        Run PHPUnit (recreates the smoke database ctnlist_smoke first)
  lint               php -l over public_html/index.php, src/ and tests/
  check              Quality gate: lint, Twig/YAML/container lint, composer validate+audit, PHPStan, all tests; then checks the dev database is untouched
  psql [args]        Open psql on the ctnlist database
  shell              Bash shell in the app container
  ensure-env         Create dev/podman/ctnlist.env if missing (fill APP_SETTINGS_KEY only if empty), warn about obsolete settings, regenerate smoke.env (run by up and test)
  cattomail-link     Attach web/app to the cattomail-dev network (catto-mail development route; up re-attaches automatically when it exists)
  cattomail-status   Show what the catto-mail development route has and lacks (never prints secret values)
  test-cattomail     Optional real end-to-end check against the local development catto-mail (sends one proof)
  cattomail-ca [h:p] Save catto-mail's development certificate (default 127.0.0.1:8443) for CATTOMAIL_CA_FILE
  reset-db           DESTROY the database volume and re-run migrations

App: http://localhost:8180   Mailpit: http://localhost:8125   DB: localhost:5434
EOF
}

cmd="${1:-help}"
shift || true

case "$cmd" in
    up)
        ensure_env
        ensure_tls
        compose up -d --build --force-recreate
        if [ ! -f vendor/autoload.php ]; then
            in_app composer install --no-interaction
        fi
        # The compiled container embeds absolute paths; rebuild it on every up.
        in_app rm -rf /var/www/ctnlist/var/cache /var/www/ctnlist-smoke/var/cache
        ensure_instance_dirs
        wait_for_db
        in_app composer migrate-paralegal
        psql_db -q -v email="$ADMIN_EMAIL_DEFAULT" < dev/podman/seed-admin.sql >/dev/null
        ensure_test_db
        cattomail_relink
        echo
        echo "App:     http://localhost:8180  (log in as $ADMIN_EMAIL_DEFAULT; the link arrives in Mailpit)"
        echo "Mailpit: http://localhost:8125"
        ;;
    down) compose down ;;
    ensure-env) ensure_env ;;
    cattomail-link) cattomail_link ;;
    cattomail-status) cattomail_status ;;
    test-cattomail) "$0" console ctnlist:cattomail:check --e2e "$@" ;;
    cattomail-ca) cattomail_ca "$@" ;;
    restart) "$0" down && "$0" up ;;
    ps) compose ps ;;
    logs) compose logs -f "$@" ;;
    migrate) wait_for_db; in_app composer migrate-paralegal; ensure_test_db ;;
    status) in_app composer status-paralegal ;;
    seed-admin)
        wait_for_db
        psql_db -v email="${1:-$ADMIN_EMAIL_DEFAULT}" < dev/podman/seed-admin.sql
        ;;
    composer) in_app_tty composer "$@" ;;
    php) in_app_tty php "$@" ;;
    console) if [ -t 0 ]; then podman exec -it -u www-data "$APP" bin/console "$@"; else podman exec -i -u www-data "$APP" bin/console "$@"; fi ;;
    analyse) in_app composer analyse ;;
    test) ensure_env; ensure_instance_dirs; reset_smoke_db; in_app vendor/bin/phpunit "$@" ;;
    lint)
        in_app sh -c 'for f in public_html/index.php $(find src tests -name "*.php"); do php -l "$f" >/dev/null || exit 1; done; echo "No syntax errors."'
        ;;
    check)
        # The quality gate: every step must pass; it stops at the first failure.
        step() { echo; echo "== $1"; shift; "$@" || { echo "FAILED: $*" >&2; exit 1; }; }
        step "PHP syntax" "$0" lint
        step "Twig templates" "$0" console lint:twig templates --show-deprecations
        step "YAML configuration" "$0" console lint:yaml config --parse-tags
        step "Service container" "$0" console lint:container
        step "Composer manifest" in_app composer validate --strict
        step "Composer advisories" in_app composer audit --locked
        step "PHPStan" "$0" analyse
        before="$(dev_db_fingerprint)"
        step "PHPUnit (unit, integration, smoke)" "$0" test
        after="$(dev_db_fingerprint)"
        # Tests use ctnlist_test and ctnlist_smoke only; the development database must be untouched.
        step "Development database untouched" same_fingerprint "$before" "$after"
        echo; echo "All checks passed."
        ;;
    psql) if [ -t 0 ]; then podman exec -it "$DB" psql -U ctnlist -d ctnlist "$@"; else psql_db "$@"; fi ;;
    shell) podman exec -it "$APP" bash ;;
    reset-db)
        read -r -p "This deletes all data in the ctnlist dev database. Type 'reset' to continue: " answer
        [ "$answer" = "reset" ] || { echo "Aborted."; exit 1; }
        compose down
        podman volume rm -f ctnlist_pgdata
        "$0" up
        ;;
    help|-h|--help) usage ;;
    *) usage; exit 1 ;;
esac
