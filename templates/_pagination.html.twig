{#
  Pager (v5 semantics: pages are base/N, ?r= rows per page kept in the query).
  Variables: pagination (App\Http\Pagination), base (list URL), query (appended, e.g. "?e=x").
  On narrow screens only the current page and its neighbours are listed.
#}
{% set query = query ?? '' %}
{% set current = pagination.page %}
{% set last = pagination.lastPage %}
{% macro page(number, base, query, current) %}
  {%- set distance = (number - current)|abs -%}
  <li class="page-item{{ number == current ? ' active' }}{{ distance > 1 ? ' d-none d-sm-block' }}">
    {%- if number == current -%}
      <span class="page-link" aria-current="page">{{ number }}</span>
    {%- else -%}
      <a class="page-link" href="{{ base }}/{{ number }}{{ query }}">{{ number }}</a>
    {%- endif -%}
  </li>
{%- endmacro %}
{% macro step(label, icon, number, base, query, enabled) %}
  <li class="page-item{{ enabled ? '' : ' disabled' }}">
    {%- if enabled -%}
      <a class="page-link" href="{{ base }}/{{ number }}{{ query }}" aria-label="{{ label }}"><i class="bi bi-{{ icon }}" aria-hidden="true"></i></a>
    {%- else -%}
      <span class="page-link" aria-hidden="true"><i class="bi bi-{{ icon }}"></i></span>
    {%- endif -%}
  </li>
{%- endmacro %}
{% import _self as pager %}
<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mt-3">
  <p class="small text-body-secondary mb-0">Page {{ current }} of {{ last }} &middot; {{ pagination.total }} {{ pagination.total == 1 ? 'record' : 'records' }}</p>
  {% if last > 1 %}
    <nav aria-label="Pagination">
      <ul class="pagination pagination-sm mb-0">
        {{ pager.step('First page', 'chevron-double-left', 1, base, query, current > 1) }}
        {{ pager.step('Previous page', 'chevron-left', current - 1, base, query, current > 1) }}
        {% for number in max(1, current - 2)..min(last, current + 2) %}
          {{ pager.page(number, base, query, current) }}
        {% endfor %}
        {{ pager.step('Next page', 'chevron-right', current + 1, base, query, current < last) }}
        {{ pager.step('Last page', 'chevron-double-right', last, base, query, current < last) }}
      </ul>
    </nav>
  {% endif %}
</div>
