{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}
{% block description %}The rules for the subscribers of {{ site.listName }} and for whoever writes and sends its messages.{% endblock %}

{# The acceptable use policy, built from docs/AUP.md by App\Util\Markdown, which escapes all of the document's text;
   PageController fills in the installation's name, domain and organisation. The only address on this page
   is the policy's abuse address: the footer leaves the administrator's out (footer_without_administrator). #}
{% block content %}
<article class="card app-policy">
  <div class="card-body d-block">
    {{ policy }}
  </div>
</article>
{% endblock %}
