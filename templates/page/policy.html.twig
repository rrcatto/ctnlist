{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}
{% block description %}{{ description }}{% endblock %}

{# A policy of the release (docs/AUP.md, docs/PRIVACY.md), built by App\Util\Markdown, which escapes all of the
   document's text; PageController fills in the installation's name, domain and organisation. On the acceptable use
   policy the only address is the policy's abuse address: the footer leaves the administrator's out
   (footer_without_administrator). #}
{% block content %}
<article class="card app-policy">
  <div class="card-body d-block">
    {{ policy }}
  </div>
</article>
{% endblock %}
