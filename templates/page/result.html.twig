{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block content %}
{% include 'layout/_page_header.html.twig' with {title: title} %}
<div class="alert theme-info" role="status"><div>{{ message }}</div></div>
{% set links = (links ?? [])|filter(link => link.permission is not defined or is_granted(link.permission)) %}
{% if links is not empty %}
  <div class="d-flex flex-wrap gap-3">
    {% for link in links %}
      <a class="btn {{ loop.first ? 'btn-solid theme-primary' : 'btn-outline theme-secondary' }}" href="{{ path(link.route) }}">{{ link.label }}</a>
    {% endfor %}
  </div>
{% endif %}
{% endblock %}
