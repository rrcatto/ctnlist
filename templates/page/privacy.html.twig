{% extends 'base.html.twig' %}

{% block title %}Privacy policy{% endblock %}

{% block content %}
<div class="row justify-content-center">
  <div class="col-xl-auto border border-dark p-1 m-1 bg-light">
    <h1 class="bg-primary p-3 m-2 text-center text-white"><i class="bi bi-eye" aria-hidden="true"></i> Privacy Policy</h1>
    <p class="bg-secondary p-3 m-2 text-center text-white"><i class="bi bi-shield-check" aria-hidden="true"></i> Your personal information is safe with us. We will not divulge it to anyone</p>
    <h1 class="bg-primary p-3 m-2 text-center text-white"><i class="bi bi-box-arrow-right" aria-hidden="true"></i> Opt Out of email subscription</h1>
    <p class="bg-secondary p-3 m-2 text-center text-white"><i class="bi bi-hand-index" aria-hidden="true"></i> You may opt out of receiving emails at any time</p>
  </div>
</div>
{% endblock %}
