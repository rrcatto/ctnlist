{% extends 'base.html.twig' %}

{% block title %}Forward message{% endblock %}

{% block content %}
{% include 'layout/_page_header.html.twig' with {title: 'Forward message', description: 'Send the current version of this message to friends. Each receives it once and may subscribe themselves.'} %}
{{ form_start(form, {attr: {class: 'card app-narrow ms-0'}}) }}
  <div class="card-body">
    {{ form_errors(form) }}
    {{ form_widget(form.token) }}
    {{ form_widget(form.muid) }}
    {{ form_row(form.emails, {row_attr: {class: 'mb-0'}}) }}
  </div>
  <div class="card-footer">
    <button class="btn-solid theme-primary" type="submit"><i class="bi bi-forward me-1" aria-hidden="true"></i>Forward current message</button>
  </div>
{{ form_end(form) }}
{% endblock %}
