{% extends 'base.html.twig' %}

{% block title %}Send message again{% endblock %}

{% block content %}
{% include 'layout/_page_header.html.twig' with {title: 'Send this message again', description: 'We email you the message once more.'} %}
<form action="{{ path('message_resend_submit') }}" method="post" class="card app-narrow ms-0">
  <div class="card-body d-flex flex-row align-items-center gap-5">
    <input type="hidden" name="csrf" value="{{ csrf_token('ctnlist') }}">
    <input type="hidden" name="subscriber_token" value="{{ token }}">
    <input type="hidden" name="muid" value="{{ muid }}">
    <i class="bi bi-arrow-repeat fs-3xl fg-primary" aria-hidden="true"></i>
    <p class="mb-0">The current version will be sent; it may differ from the archived version first received.</p>
  </div>
  <div class="card-footer">
    <button class="btn-solid theme-primary" type="submit"><i class="bi bi-envelope me-1" aria-hidden="true"></i>Send current version</button>
  </div>
</form>
{% endblock %}
