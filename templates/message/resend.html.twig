{% extends 'base.html.twig' %}

{% block title %}Send message again{% endblock %}

{% block content %}
<form action="{{ path('message_resend_submit') }}" method="post" class="card card-body">
  <input type="hidden" name="csrf" value="{{ csrf_token('ctnlist') }}">
  <input type="hidden" name="subscriber_token" value="{{ token }}">
  <input type="hidden" name="muid" value="{{ muid }}">
  <h1 class="h4">Send this message again</h1>
  <p>The current version will be sent; it may differ from the archived version first received.</p>
  <button class="btn btn-primary" type="submit">Send current version</button>
</form>
{% endblock %}
