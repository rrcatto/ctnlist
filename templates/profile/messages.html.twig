{% extends 'base.html.twig' %}

{% block title %}Messages sent to me{% endblock %}

{% block content %}
{% if messages is empty %}
  <p>No messages have been recorded as sent to this account.</p>
{% else %}
  <div class="table-responsive">
    <table class="table table-striped align-middle">
      <thead><tr><th>Subject</th><th>Sent</th><th>Actions</th></tr></thead>
      <tbody>
      {% for message in messages %}
        {% set suffix = app.user.uuid ~ '/' ~ message.m_uniqid %}
        <tr>
          <td>{{ message.m_subject }}</td>
          <td>{{ message.sml_date_sent }}</td>
          <td class="d-flex flex-wrap gap-1">
            <a class="btn btn-sm btn-outline-primary" href="{{ site.baseUrl }}resend/{{ suffix }}">Send again</a>
            <a class="btn btn-sm btn-outline-secondary" href="{{ site.baseUrl }}forward/{{ suffix }}">Forward</a>
            <a class="btn btn-sm btn-outline-success" href="{{ site.baseUrl }}like/{{ suffix }}">Like</a>
            <a class="btn btn-sm btn-outline-danger" href="{{ site.baseUrl }}dislike/{{ suffix }}">Dislike</a>
          </td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
{% endif %}
{% endblock %}
