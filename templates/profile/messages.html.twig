{% extends 'base.html.twig' %}

{% block title %}Messages sent to me{% endblock %}

{% block content %}
{% embed 'layout/_page_header.html.twig' with {title: 'Messages sent to me', description: 'Send a message to yourself again, forward it, or tell us what you thought of it.'} %}
  {% block actions %}<a class="btn btn-outline-secondary" href="{{ path('profile') }}"><i class="bi bi-arrow-left me-1" aria-hidden="true"></i>My profile</a>{% endblock %}
{% endembed %}
{% if messages is empty %}
  {% include 'layout/_empty_state.html.twig' with {icon: 'envelope', message: 'No messages have been recorded as sent to this account.'} %}
{% else %}
  <div class="list-group">
    {% for message in messages %}
      {% set ids = {token: app.user.uuid, muid: message.m_uniqid} %}
      <div class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2 py-3">
        <div class="me-auto">
          <div class="fw-semibold text-break">{{ message.m_subject }}</div>
          <div class="small text-body-secondary">Sent {{ message.sml_date_sent|slice(0, 16) }}</div>
        </div>
        <div class="d-flex flex-wrap gap-1">
          <a class="btn btn-sm btn-outline-primary" href="{{ path('message_resend', ids) }}"><i class="bi bi-arrow-repeat me-1" aria-hidden="true"></i>Send again</a>
          <a class="btn btn-sm btn-outline-secondary" href="{{ path('message_forward', ids) }}"><i class="bi bi-forward me-1" aria-hidden="true"></i>Forward</a>
          <a class="btn btn-sm btn-outline-success" href="{{ path('message_reaction', ids|merge({reaction: 'like'})) }}" aria-label="Like {{ message.m_subject }}"><i class="bi bi-hand-thumbs-up" aria-hidden="true"></i></a>
          <a class="btn btn-sm btn-outline-danger" href="{{ path('message_reaction', ids|merge({reaction: 'dislike'})) }}" aria-label="Dislike {{ message.m_subject }}"><i class="bi bi-hand-thumbs-down" aria-hidden="true"></i></a>
        </div>
      </div>
    {% endfor %}
  </div>
{% endif %}
{% endblock %}
