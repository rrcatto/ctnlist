{% extends 'base.html.twig' %}

{% block title %}Unsubscribe{% endblock %}

{% block content %}
{% include 'layout/_page_header.html.twig' with {title: 'Unsubscribe from ' ~ list.l_name, description: 'Stop receiving ' ~ list.l_name ~ ' at ' ~ email ~ '. Your other lists are not affected.'} %}
<form method="post" class="card app-narrow ms-0">
  <div class="card-body">
    <p class="mb-0">You can subscribe again at any time from the subscribe page.</p>
  </div>
  <div class="card-footer">
    <button class="btn btn-danger" type="submit"><i class="bi bi-envelope-x me-1" aria-hidden="true"></i>Unsubscribe from {{ list.l_name }}</button>
  </div>
</form>
{% endblock %}
