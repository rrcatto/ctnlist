{#
  Subscribe page.
  Visitors: `lists` (one list when coming from a message) and the subscribe
  form (SubscribeType, POST /subscribe/request), which emails a link to
  confirm the chosen list; nothing is subscribed until it is confirmed.
  Signed-in subscribers: `memberships`, each with a subscribe/unsubscribe link.
#}
{% extends 'base.html.twig' %}
{% import 'admin/_macros.html.twig' as ui %}

{% block title %}Subscribe{% endblock %}

{% block content %}
{% if memberships is defined %}
  {% embed 'layout/_page_header.html.twig' with {title: 'Subscribe', description: 'Choose the lists you want to receive. Each list needs its own confirmation, and you can unsubscribe at any time.'} %}
    {% block actions %}<a class="btn-outline theme-secondary" href="{{ path('profile') }}"><i class="bi bi-person me-1" aria-hidden="true"></i>My profile</a>{% endblock %}
  {% endembed %}
  <div class="list-group app-narrow ms-0">
    {% for membership in memberships %}
      {% set state = ui.membership_state(membership)|trim %}
      <div class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-3 py-5">
        <div class="me-auto">
          <div class="fw-semibold">{{ membership.l_name }} {{ ui.membership_badge(state) }}</div>
          {% if membership.l_description %}<div class="small fg-2">{{ membership.l_description }}</div>{% endif %}
        </div>
        {% if state == 'confirmed' %}
          <a class="btn-sm btn-outline theme-secondary" href="{{ path('consent_unsubscribe', {token: app.user.uuid, shortcode: membership.l_shortcode}) }}">Unsubscribe</a>
        {% else %}
          <a class="btn-sm btn-solid theme-primary" href="{{ path('consent_confirm', {token: app.user.uuid, shortcode: membership.l_shortcode}) }}">{{ state == 'pending' ? 'Confirm' : 'Subscribe' }}</a>
        {% endif %}
      </div>
    {% else %}
      <div class="list-group-item fg-2">There are no lists to subscribe to.</div>
    {% endfor %}
  </div>
{% else %}
  {% set single = lists|length == 1 %}
  {% include 'layout/_page_header.html.twig' with {
    title: single ? 'Subscribe to ' ~ (lists|first).l_name : 'Subscribe',
    description: 'Enter your email address and we will send you a link to confirm your subscription. You are only subscribed once you confirm.'
  } %}
  {% if single and (lists|first).l_description %}<p class="app-narrow ms-0">{{ (lists|first).l_description }}</p>{% endif %}
  {% if lists is empty %}
    {% include 'layout/_empty_state.html.twig' with {icon: 'envelope', message: 'There are no lists to subscribe to.'} %}
  {% else %}
    {{ form_start(form, {attr: {class: 'card app-narrow ms-0'}}) }}
      <div class="card-body">
        {{ form_errors(form) }}
        {{ form_widget(form.messageId) }}
        {{ form_row(form.email) }}
        {% if single %}
          <div class="d-none">{{ form_widget(form.listId) }}</div>
          {{ form_errors(form.listId) }}
        {% else %}
          {% set descriptions = {} %}
          {% for list in lists %}{% set descriptions = descriptions|merge({('l' ~ list.l_id): list.l_description}) %}{% endfor %}
          <fieldset class="mb-0"{% if not form.listId.vars.valid %} aria-describedby="{{ form.listId.vars.id }}_error1"{% endif %}>
            <legend class="form-label fs-md required">{{ form.listId.vars.label }}</legend>
            {{ form_errors(form.listId) }}
            {% for choice in form.listId %}
              {% set description = descriptions['l' ~ choice.vars.value] ?? '' %}
              <div class="form-field mb-3">
                <input class="radio" type="radio" id="{{ choice.vars.id }}" name="{{ choice.vars.full_name }}" value="{{ choice.vars.value }}"{{ choice.vars.checked ? ' checked' }}{% if description %} aria-describedby="{{ choice.vars.id }}_help"{% endif %}>
                <div class="form-field-content">
                  <label class="fw-semibold" for="{{ choice.vars.id }}">{{ choice.vars.label }}</label>
                  {% if description %}<small class="form-text" id="{{ choice.vars.id }}_help">{{ description }}</small>{% endif %}
                </div>
              </div>
              {% do choice.setRendered %}
            {% endfor %}
            {% do form.listId.setRendered %}
          </fieldset>
        {% endif %}
      </div>
      <div class="card-footer d-flex flex-wrap align-items-center gap-5">
        <button class="btn-solid theme-primary" type="submit"><i class="bi bi-envelope-check me-1" aria-hidden="true"></i>Subscribe</button>
        <a class="small" href="{{ path('login') }}">Already subscribed? Sign in to manage your lists</a>
      </div>
    {{ form_end(form) }}
  {% endif %}
{% endif %}
{% endblock %}
