{% extends 'base.html.twig' %}

{% block title %}Unsubscribe{% endblock %}

{% block content %}
<form action="{{ path('consent_unsubscribe_submit') }}" method="post" class="card card-body app-narrow">
  <input type="hidden" name="csrf" value="{{ csrf_token('ctnlist') }}">
  <input type="hidden" name="subscriber_token" value="{{ token }}">
  <input type="hidden" name="list_shortcode" value="{{ list.l_shortcode }}">
  <input type="hidden" name="muid" value="{{ muid }}">
  <h1 class="h4">Unsubscribe from {{ list.l_name }}</h1>
  {% for value, label in {
      list: 'This list only',
      global: 'All ctnlist installations using the global suppression database',
      bounce: 'Address does not exist',
      spam: 'Stop sending me spam',
  } %}
    <div class="form-field mb-3">
      <input class="radio" type="radio" name="scope" value="{{ value }}" id="unsub-{{ value }}"{{ loop.first ? ' checked' }}>
      <label for="unsub-{{ value }}">{{ label }}</label>
    </div>
  {% endfor %}
  <div class="mb-5 mt-5"><label class="form-label" for="unsub-reason">Reason or comments</label><textarea class="form-control" id="unsub-reason" name="reason" rows="4"></textarea></div>
  <button class="btn-solid theme-danger" type="submit">Unsubscribe</button>
</form>
{% if global_optout_available %}{% include 'consent/_global_optout.html.twig' %}{% endif %}
{% endblock %}
