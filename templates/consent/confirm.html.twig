{% extends 'base.html.twig' %}

{% block title %}Confirm subscription{% endblock %}

{% block content %}
<form action="{{ path('consent_confirm_submit') }}" method="post" class="card card-body app-narrow">
  <input type="hidden" name="csrf" value="{{ csrf_token('ctnlist') }}">
  <input type="hidden" name="subscriber_token" value="{{ token }}">
  <input type="hidden" name="list_shortcode" value="{{ list.l_shortcode }}">
  <input type="hidden" name="muid" value="{{ muid }}">
  <h1 class="h4">Confirm subscription to {{ list.l_name }}</h1>
  <button class="btn-solid theme-success" type="submit">Confirm subscription</button>
</form>
{% endblock %}
