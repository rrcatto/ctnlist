{% extends 'base.html.twig' %}

{% block title %}Archive{% endblock %}

{% block content %}
{% if forward_token is not null %}
  <form name="forwardarchiveform" action="{{ path('message_forward_archive') }}" method="post" role="form" class="card card-body mb-4">
    <input type="hidden" name="csrf" value="{{ csrf_token('ctnlist') }}">
    <input type="hidden" name="aid" value="{{ archive.a_id }}">
    <input type="hidden" name="subscriber_token" value="{{ forward_token }}">
    <input type="hidden" name="muid" value="{{ muid }}">
    <h2 class="h5">Forward Archive Message</h2>
    <label class="form-label" for="bemail">Forward to these emails</label>
    <textarea class="form-control mb-3" rows="5" name="bemail" id="bemail"></textarea>
    <button class="btn btn-primary" type="submit">Forward Message</button>
  </form>
{% endif %}
<p>Date created: {{ archive.a_datecreated }}</p>
<p>Subject: {{ archive.a_subject }}</p>
{# The archived message HTML, rendered when the message was first queued. #}
{{ archive.a_html|raw }}
{% endblock %}
