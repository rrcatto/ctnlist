<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ site.listName }} | {% block title %}{% endblock %}</title>
  <meta name="description" content="{% block description %}{{ site.listName }} mailing list: subscribe, manage your subscription and read past messages.{% endblock %}">
  <link rel="icon" href="{{ asset('images/favicon.svg') }}" type="image/svg+xml">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" integrity="sha384-CK2SzKma4jA5H/MXDUU7i1TqZlCFaD4T01vtyDFvPlD97JQyS+IsSh1nI2EFbpyk" crossorigin="anonymous">
  {% block stylesheets %}{% endblock %}
  {{ importmap('app') }}
</head>
<body class="d-flex flex-column min-vh-100">
  <a class="visually-hidden-focusable position-absolute top-0 start-0 m-2 btn btn-light" href="#main">Skip to content</a>

  <header class="app-header sticky-top shadow-sm">
    {% include 'layout/_navbar.html.twig' %}
    {% include 'layout/_admin_menu.html.twig' %}
  </header>

  <main id="main" class="flex-grow-1 py-4">
    <div class="container app-content">
      {% include 'layout/_flash.html.twig' %}
      {% block content %}{% endblock %}
    </div>
  </main>

  {% include 'layout/_footer.html.twig' %}

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
  {% block javascripts %}{% endblock %}
</body>
</html>
