{#
  Application form theme (set in config/packages/twig.yaml): Bootstrap 6 markup
  on Symfony's Bootstrap base layout. Symfony ships no Bootstrap 6 theme, so
  this file does what its bootstrap_5_layout.html.twig did, with v6's classes:
  - a row is a .form-field (label, control, help and errors laid out by its
    grid); a choice shown as radios or checkboxes is a .form-group of them;
  - selects are .form-control, checkboxes .check and radios .radio, each in
    its own .form-field with its label;
  - every widget, also one rendered with form_widget() outside form_row(),
    is linked to its help text and errors (aria-describedby) and marked
    aria-invalid and .is-invalid when it has errors;
  - forms are validated on the server only (novalidate), so every error is
    shown at its field the same way;
  - labels of required fields get the .required marker (app.css).
#}
{% use 'bootstrap_base_layout.html.twig' %}

{%- block form_start -%}
    {%- set attr = attr|merge({novalidate: 'novalidate'}) -%}
    {{- parent() -}}
{%- endblock form_start -%}

{# Widgets #}

{% block form_widget_simple -%}
    {%- if type is not defined or type != 'hidden' %}
        {%- set attr = attr|merge({class: (attr.class|default('') ~ ' form-control' ~ (type|default('') == 'color' ? ' form-control-color'))|trim}) -%}
    {% endif -%}
    {{- parent() -}}
{%- endblock form_widget_simple %}

{%- block widget_attributes -%}
    {%- set described = [] -%}
    {%- if help is defined and help -%}
        {%- set described = described|merge([id ~ '_help']) -%}
    {%- endif -%}
    {%- if errors|length > 0 -%}
        {%- set described = described|merge(errors|map((_, index) => id ~ '_error' ~ (index + 1))) -%}
        {%- set attr = attr|merge({'aria-invalid': 'true'}) -%}
    {%- endif -%}
    {%- if described|length > 0 and attr['aria-describedby'] is not defined -%}
        {%- set attr = attr|merge({'aria-describedby': described|join(' ')}) -%}
    {%- endif -%}
    {%- if not valid %}
        {% set attr = attr|merge({class: (attr.class|default('') ~ ' is-invalid')|trim}) %}
    {% endif -%}
    {{ parent() }}
{%- endblock widget_attributes -%}

{%- block button_widget -%}
    {%- set attr = attr|merge({class: attr.class|default('btn-solid theme-secondary')|trim}) -%}
    {{- parent() -}}
{%- endblock button_widget %}

{%- block submit_widget -%}
    {%- set attr = attr|merge({class: attr.class|default('btn-solid theme-primary')|trim}) -%}
    {{- parent() -}}
{%- endblock submit_widget %}

{%- block checkbox_widget -%}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' check')|trim}) -%}
    <div class="form-field">
        {{- form_label(form, null, {widget: parent()}) -}}
    </div>
{%- endblock checkbox_widget %}

{%- block radio_widget -%}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' radio')|trim}) -%}
    <div class="form-field">
        {{- form_label(form, null, {widget: parent()}) -}}
    </div>
{%- endblock radio_widget %}

{%- block choice_widget_collapsed -%}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' form-control')|trim}) -%}
    {{- parent() -}}
{%- endblock choice_widget_collapsed -%}

{%- block choice_widget_expanded -%}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' form-group')|trim}) -%}
    <div {{ block('widget_container_attributes') }}>
        {%- for child in form %}
            {{- form_widget(child, {
                parent_label_class: label_attr.class|default(''),
                translation_domain: choice_translation_domain,
                valid: valid,
            }) -}}
        {% endfor -%}
    </div>
{%- endblock choice_widget_expanded %}

{# Labels #}

{%- block form_label -%}
    {% if label is not same as(false) -%}
        {%- if compound is defined and compound -%}
            {%- set element = 'legend' -%}
        {%- else -%}
            {%- set label_attr = label_attr|merge({for: id}) -%}
        {%- endif -%}
        {%- set label_attr = label_attr|merge({class: (label_attr.class|default('') ~ ' form-label')|trim}) -%}
    {%- endif -%}
    {{- parent() -}}
{%- endblock form_label %}

{%- block checkbox_radio_label -%}
    {#- Rendered with its widget only (checkbox_widget, radio_widget), so the label is not printed twice. -#}
    {%- if widget is defined -%}
        {%- if not compound -%}
            {% set label_attr = label_attr|merge({for: id}) %}
        {%- endif -%}
        {%- if required -%}
            {%- set label_attr = label_attr|merge({class: (label_attr.class|default('') ~ ' required')|trim}) -%}
        {%- endif -%}
        {%- if parent_label_class is defined and parent_label_class -%}
            {%- set label_attr = label_attr|merge({class: (label_attr.class|default('') ~ ' ' ~ parent_label_class)|trim}) -%}
        {%- endif -%}

        {{ widget|raw }}
        <label{% with {attr: label_attr} %}{{ block('attributes') }}{% endwith %}>
            {%- if label is not same as(false) -%}
                {{- block('form_label_content') -}}
            {%- endif -%}
        </label>
    {%- endif -%}
{%- endblock checkbox_radio_label %}

{# Rows #}

{%- block form_row_render -%}
    {%- if compound is defined and compound -%}
        {%- set element = 'fieldset' -%}
    {%- endif -%}
    {#- A row_attr class adds to the row (a grid column, a margin); without one the row keeps Bootstrap 5's 1rem below it. -#}
    {%- set row_class = ((compound is defined and compound ? 'form-group ' : 'form-field ') ~ row_attr.class|default('mb-5'))|trim -%}
    <{{ element|default('div') }}{% with {attr: row_attr|merge({class: row_class})} %}{{ block('attributes') }}{% endwith %}>
        {{- form_label(form) -}}
        {{- form_widget(form, widget_attr) -}}
        {{- form_help(form) -}}
        {{- form_errors(form) -}}
    </{{ element|default('div') }}>
{%- endblock form_row_render %}

{%- block button_row -%}
    <div{% with {attr: row_attr|merge({class: row_attr.class|default('mb-5')|trim})} %}{{ block('attributes') }}{% endwith %}>
        {{- form_widget(form) -}}
    </div>
{%- endblock button_row %}

{# Errors #}

{%- block form_errors -%}
    {%- if errors|length > 0 -%}
        {%- for error in errors -%}
            {%- if form is rootform -%}
                <div class="alert theme-danger" id="{{ id ~ '_error' ~ loop.index }}"><div>{{ error.message }}</div></div>
            {%- else -%}
                <div class="invalid-feedback d-block" id="{{ id ~ '_error' ~ loop.index }}">{{ error.message }}</div>
            {%- endif -%}
        {%- endfor -%}
    {%- endif %}
{%- endblock form_errors %}

{# Help #}

{%- block form_help -%}
    {%- if help -%}
        {%- set help_attr = help_attr|merge({class: (help_attr.class|default('') ~ ' form-text')|trim}) -%}
    {%- endif -%}
    {{- parent() -}}
{%- endblock form_help %}
