{% extends 'base.html.twig' %}

{% block title %}Send Log{% endblock %}

{% block content %}
{% import 'layout/_htmx.html.twig' as hx %}
{% include 'layout/_page_header.html.twig' with {title: 'Send Log', description: 'Every email handed to the mail server, newest first. Choose a type to filter the log.'} %}

<div class="card mb-7">
  <div class="card-body">
    <div class="d-flex flex-wrap align-items-center gap-3">
      <strong class="me-1">All time:</strong>
      {% for row in by_type %}
        <a href="{{ path('report_sendlog', {t: row.sl_type}) }}" class="btn btn-sm {{ row.sl_type == filters.t ? 'btn-solid theme-primary' : 'btn-outline theme-secondary border' }}">{{ row.sl_type }} <span class="badge theme-secondary ms-1">{{ row.sl_total }}</span></a>
      {% else %}
        <span class="fg-2">Nothing has been sent yet.</span>
      {% endfor %}
    </div>
    {% if by_month is not empty %}
      <details class="mt-5">
        <summary class="small fw-semibold">Totals by month</summary>
        <div class="table-responsive mt-3">
          <table class="table table-sm align-middle mb-0">
            <thead class=""><tr><th scope="col">Month</th><th scope="col">Emails by type</th></tr></thead>
            <tbody>
            {% for month, totals in by_month %}
              <tr>
                <th scope="row" class="text-nowrap fw-normal">{{ month }}</th>
                <td>{% for row in totals %}<span class="text-nowrap me-5">{{ row.sl_type }} <span class="badge badge-subtle theme-secondary">{{ row.sl_total }}</span></span>{% endfor %}</td>
              </tr>
            {% endfor %}
            </tbody>
          </table>
        </div>
      </details>
    {% endif %}
  </div>
</div>

<form action="{{ path('report_sendlog') }}" method="get" class="card card-body bg-1 mb-7" role="search" aria-label="Filter the Send Log" {{ hx.search(path('report_sendlog'), 'sendlog-results') }}>
  <div class="row g-5 align-items-end">
    <div class="md:col-5"><label class="form-label" for="f-e">Email address contains</label><input class="form-control" id="f-e" type="search" name="e" value="{{ filters.e }}"></div>
    <div class="md:col-4"><label class="form-label" for="f-t">Message type</label>
      <select class="form-control" id="f-t" name="t">
        <option value=""{{ filters.t is empty ? ' selected' }}>All types</option>
        {% for type in types %}<option value="{{ type }}"{{ type == filters.t ? ' selected' }}>{{ type }}</option>{% endfor %}
      </select>
    </div>
    <div class="md:col-3"><label class="form-label" for="f-r">Rows per page</label><input class="form-control" id="f-r" type="number" min="1" max="200" name="r" value="{{ pagination.perPage }}"></div>
    <div class="col-12 d-flex align-items-center gap-3">
      <noscript><button class="btn-solid theme-primary" type="submit"><i class="bi bi-search me-1" aria-hidden="true"></i>Search</button></noscript>
      <a class="btn-outline theme-secondary" href="{{ path('report_sendlog') }}">Clear</a>
      <span class="small fg-2 htmx-indicator" role="status">Searching…</span>
    </div>
  </div>
</form>

{% include 'report/_sendlog_results.html.twig' %}
{% endblock %}
