{% extends 'base.html.twig' %}

{% block title %}Send Log{% endblock %}

{% block content %}
{% include 'layout/_page_header.html.twig' with {title: 'Send Log', description: 'Every email handed to the mail server, newest first. Choose a type to filter the log.'} %}

<div class="card mb-4">
  <div class="card-body">
    <div class="d-flex flex-wrap align-items-center gap-2">
      <strong class="me-1">All time:</strong>
      {% for row in by_type %}
        <a href="{{ path('report_sendlog', {t: row.sl_type}) }}" class="btn btn-sm {{ row.sl_type == filters.t ? 'btn-primary' : 'btn-light border' }}">{{ row.sl_type }} <span class="badge text-bg-secondary ms-1">{{ row.sl_total }}</span></a>
      {% else %}
        <span class="text-body-secondary">Nothing has been sent yet.</span>
      {% endfor %}
    </div>
    {% if by_month is not empty %}
      <details class="mt-3">
        <summary class="small fw-semibold">Totals by month</summary>
        <div class="table-responsive mt-2">
          <table class="table table-sm align-middle mb-0">
            <thead class="table-light"><tr><th scope="col">Month</th><th scope="col">Emails by type</th></tr></thead>
            <tbody>
            {% for month, totals in by_month %}
              <tr>
                <th scope="row" class="text-nowrap fw-normal">{{ month }}</th>
                <td>{% for row in totals %}<span class="text-nowrap me-3">{{ row.sl_type }} <span class="badge text-bg-light border">{{ row.sl_total }}</span></span>{% endfor %}</td>
              </tr>
            {% endfor %}
            </tbody>
          </table>
        </div>
      </details>
    {% endif %}
  </div>
</div>

<form action="{{ path('report_sendlog') }}" method="get" class="card card-body bg-body-tertiary mb-4" role="search" aria-label="Filter the Send Log">
  <div class="row g-3 align-items-end">
    <div class="col-md-5"><label class="form-label" for="f-e">Email address contains</label><input class="form-control" id="f-e" type="search" name="e" value="{{ filters.e }}"></div>
    <div class="col-md-4"><label class="form-label" for="f-t">Message type</label>
      <select class="form-select" id="f-t" name="t">
        <option value=""{{ filters.t is empty ? ' selected' }}>All types</option>
        {% for type in types %}<option value="{{ type }}"{{ type == filters.t ? ' selected' }}>{{ type }}</option>{% endfor %}
      </select>
    </div>
    <div class="col-md-3"><label class="form-label" for="f-r">Rows per page</label><input class="form-control" id="f-r" type="number" min="1" max="200" name="r" value="{{ pagination.perPage }}"></div>
    <div class="col-12 d-flex gap-2">
      <button class="btn btn-primary" type="submit"><i class="bi bi-search me-1" aria-hidden="true"></i>Search</button>
      <a class="btn btn-outline-secondary" href="{{ path('report_sendlog') }}">Clear</a>
    </div>
  </div>
</form>

{% if rows is empty %}
  {% include 'layout/_empty_state.html.twig' with {icon: 'envelope', message: 'No emails match that search.'} %}
{% else %}
  <div class="table-responsive">
    <table class="table table-hover align-middle">
      <thead class="table-light"><tr><th scope="col">Sent</th><th scope="col">Type</th><th scope="col">Email</th><th scope="col">List</th><th scope="col">Subject</th><th scope="col">Subscriber UUID</th></tr></thead>
      <tbody>
      {% for row in rows %}
        <tr>
          <td class="text-nowrap">{{ row.sl_datesent }}</td>
          <td>{{ row.sl_type }}</td>
          <td>{{ row.sl_email }}</td>
          <td>{% if row.sl_list_shortcode %}<code>{{ row.sl_list_shortcode }}</code>{% endif %}</td>
          <td>{{ row.sl_subject }}</td>
          <td><code class="small">{{ row.sl_s_uuid }}</code></td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
  {% include '_pagination.html.twig' with {base: path('report_sendlog'), query: query} %}
{% endif %}
{% endblock %}
