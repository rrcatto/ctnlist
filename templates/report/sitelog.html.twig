{% extends 'base.html.twig' %}

{% block title %}Site Log{% endblock %}

{% block content %}
{% include 'layout/_page_header.html.twig' with {title: 'Site Log', description: 'Every page request, newest first.'} %}

<form method="get" action="{{ path('report_sitelog') }}" class="card card-body bg-1 mb-7" role="search" aria-label="Filter the Site Log">
  <div class="row g-5 align-items-end">
    <div class="md:col-6 lg:col-4"><label class="form-label" for="f-q">Keyword</label><input class="form-control" id="f-q" type="search" name="q" value="{{ filters.q }}" aria-describedby="f-q-help"><div class="form-text" id="f-q-help">Searches email, URL, IP, host and user agent.</div></div>
    <div class="md:col-6 lg:col-4"><label class="form-label" for="f-e">Email contains</label><input class="form-control" id="f-e" name="e" value="{{ filters.e }}"></div>
    <div class="md:col-6 lg:col-4"><label class="form-label" for="f-u">URL contains</label><input class="form-control" id="f-u" name="u" value="{{ filters.u }}"></div>
    <div class="md:col-6 lg:col-3"><label class="form-label" for="f-ip">IP address contains</label><input class="form-control" id="f-ip" name="ip" value="{{ filters.ip }}"></div>
    <div class="md:col-4 lg:col-3"><label class="form-label" for="f-li">Login state</label>
      <select class="form-control" id="f-li" name="li">
        {% for value, label in {'': 'All', '1': 'Logged in', '0': 'Not logged in'} %}<option value="{{ value }}"{{ filters.li == value ? ' selected' }}>{{ label }}</option>{% endfor %}
      </select>
    </div>
    <div class="col-6 md:col-4 lg:col-2"><label class="form-label" for="f-from">From date</label><input class="form-control" id="f-from" type="date" name="from" value="{{ filters.from }}"></div>
    <div class="col-6 md:col-4 lg:col-2"><label class="form-label" for="f-to">To date</label><input class="form-control" id="f-to" type="date" name="to" value="{{ filters.to }}"></div>
    <div class="md:col-4 lg:col-2"><label class="form-label" for="f-r">Rows per page</label><input class="form-control" id="f-r" type="number" min="1" max="200" name="r" value="{{ pagination.perPage }}"></div>
    <div class="col-12 d-flex gap-3">
      <button class="btn-solid theme-primary" type="submit"><i class="bi bi-search me-1" aria-hidden="true"></i>Search</button>
      <a class="btn-outline theme-secondary" href="{{ path('report_sitelog') }}">Clear</a>
    </div>
  </div>
</form>

{% if rows is empty %}
  {% include 'layout/_empty_state.html.twig' with {icon: 'globe', message: 'No site accesses match that search.'} %}
{% else %}
  <div class="table-responsive">
    <table class="table table-hover align-middle">
      <thead class=""><tr><th scope="col">Accessed</th><th scope="col">Email</th><th scope="col">URL</th><th scope="col">Network</th><th scope="col">Login</th><th scope="col">User agent</th></tr></thead>
      <tbody>
      {% for row in rows %}
        <tr>
          <td class="text-nowrap">{{ row.stl_logged_at }}</td>
          <td>{{ row.stl_email }}</td>
          <td><code>{{ row.stl_url }}</code></td>
          <td class="text-nowrap">{{ row.stl_ip }}{% if row.stl_xfwdfor %}<br><small class="fg-2">Forwarded: {{ row.stl_xfwdfor }}</small>{% endif %}{% if row.stl_host %}<br><small class="fg-2">Host: {{ row.stl_host }}</small>{% endif %}</td>
          <td>{{ row.stl_logged_in ? 'Yes' : 'No' }}</td>
          <td class="small fg-2">{{ row.stl_agent }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
  {% include '_pagination.html.twig' with {base: path('report_sitelog'), query: query} %}
{% endif %}
{% endblock %}
