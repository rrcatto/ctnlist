{% extends 'base.html.twig' %}

{% block title %}Site Log{% endblock %}

{% block content %}
{% import 'layout/_htmx.html.twig' as hx %}
{% include 'layout/_page_header.html.twig' with {title: 'Site Log', description: 'Every page request and form submission, newest first, with the answer the site gave.'} %}

<form method="get" action="{{ path('report_sitelog') }}" class="card card-body bg-1 mb-7" role="search" aria-label="Filter the Site Log" {{ hx.search(path('report_sitelog'), 'sitelog-results') }}>
  <div class="row g-5 align-items-end">
    <div class="md:col-6 lg:col-4"><label class="form-label" for="f-q">Keyword</label><input class="form-control" id="f-q" type="search" name="q" value="{{ filters.q }}" aria-describedby="f-q-help"><div class="form-text" id="f-q-help">Searches email, URL, IP, host, user agent and the address typed into a refused form.</div></div>
    <div class="md:col-6 lg:col-4"><label class="form-label" for="f-e">Email contains</label><input class="form-control" id="f-e" name="e" value="{{ filters.e }}"></div>
    <div class="md:col-6 lg:col-4"><label class="form-label" for="f-u">URL contains</label><input class="form-control" id="f-u" name="u" value="{{ filters.u }}"></div>
    <div class="md:col-6 lg:col-3"><label class="form-label" for="f-ip">IP address contains</label><input class="form-control" id="f-ip" name="ip" value="{{ filters.ip }}"></div>
    <div class="md:col-4 lg:col-3"><label class="form-label" for="f-li">Login state</label>
      <select class="form-control" id="f-li" name="li">
        {% for value, label in {'': 'All', '1': 'Logged in', '0': 'Not logged in'} %}<option value="{{ value }}"{{ filters.li == value ? ' selected' }}>{{ label }}</option>{% endfor %}
      </select>
    </div>
    <div class="md:col-4 lg:col-3"><label class="form-label" for="f-fl">Refused as automated</label>
      <select class="form-control" id="f-fl" name="fl">
        {% for value, label in {'': 'All requests', '1': 'Refused form submissions only'} %}<option value="{{ value }}"{{ filters.fl == value ? ' selected' }}>{{ label }}</option>{% endfor %}
      </select>
    </div>
    <div class="col-6 md:col-4 lg:col-2"><label class="form-label" for="f-from">From date</label><input class="form-control" id="f-from" type="date" name="from" value="{{ filters.from }}"></div>
    <div class="col-6 md:col-4 lg:col-2"><label class="form-label" for="f-to">To date</label><input class="form-control" id="f-to" type="date" name="to" value="{{ filters.to }}"></div>
    <div class="md:col-4 lg:col-2"><label class="form-label" for="f-r">Rows per page</label><input class="form-control" id="f-r" type="number" min="1" max="200" name="r" value="{{ pagination.perPage }}"></div>
    <div class="col-12 d-flex align-items-center gap-3">
      <noscript><button class="btn-solid theme-primary" type="submit"><i class="bi bi-search me-1" aria-hidden="true"></i>Search</button></noscript>
      <a class="btn-outline theme-secondary" href="{{ path('report_sitelog') }}">Clear</a>
      <span class="small fg-2 htmx-indicator" role="status">Searching…</span>
    </div>
  </div>
</form>

{% include 'report/_sitelog_results.html.twig' %}
{% endblock %}
