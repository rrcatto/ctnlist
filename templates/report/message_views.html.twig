{% extends 'base.html.twig' %}

{% block title %}Message activity{% endblock %}

{% block content %}
{% import 'layout/_htmx.html.twig' as hx %}
{% set base = path('report_message_views', {muid: muid}) %}
{% embed 'layout/_page_header.html.twig' with {title: 'Message activity', description: 'Subscribers who have opened this message, with their reactions and the contact forms they sent from it, most recent read first.'} %}
  {% block actions %}
    {% if is_granted('messages.manage') %}<a class="btn-outline theme-secondary" href="{{ path('admin_message', {muid: muid}) }}"><i class="bi bi-envelope me-1" aria-hidden="true"></i>View the message</a>{% endif %}
  {% endblock %}
{% endembed %}

<form name="messageviewsform" action="{{ base }}" method="get" class="card card-body bg-1 mb-7" role="search" aria-label="Filter message activity" {{ hx.search(base, 'message-views-results') }}>
  <div class="row g-5 align-items-end">
    <div class="md:col-6"><label class="form-label" for="f-e">Email address contains</label><input class="form-control" id="f-e" type="search" name="e" value="{{ email }}"></div>
    <div class="md:col-6 d-flex align-items-center gap-3">
      <noscript><button class="btn-solid theme-primary" type="submit"><i class="bi bi-search me-1" aria-hidden="true"></i>Search</button></noscript>
      <a class="btn-outline theme-secondary" href="{{ base }}">Clear</a>
      <span class="small fg-2 htmx-indicator" role="status">Searching…</span>
    </div>
  </div>
</form>

{% include 'report/_message_views_results.html.twig' %}
{% endblock %}
