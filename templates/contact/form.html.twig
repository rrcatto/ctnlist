{% extends 'base.html.twig' %}

{% block title %}Contact{% endblock %}

{% block content %}
{% include 'layout/_page_header.html.twig' with {title: 'Contact', description: 'Send us a request or a question; we reply by email. Fields marked * are required.'} %}
{{ form_start(form, {attr: {class: 'card card-body'}}) }}
  {{ form_widget(form.suid) }}
  {{ form_widget(form.muid) }}
  <div class="row g-5">
    <div class="md:col-6">{{ form_row(form.name) }}</div>
    <div class="md:col-6">{{ form_row(form.email) }}</div>
    <div class="md:col-6">{{ form_row(form.cell) }}</div>
    <div class="md:col-6">{{ form_row(form.company) }}</div>
    <div class="md:col-6">{{ form_row(form.website) }}</div>
    <div class="md:col-6">{{ form_row(form.topic) }}</div>
    <div class="col-12">{{ form_row(form.message) }}</div>
    <div class="col-12"><button class="btn-solid theme-primary" type="submit"><i class="bi bi-send me-1" aria-hidden="true"></i>Send request</button></div>
  </div>
{{ form_end(form) }}
{% endblock %}
