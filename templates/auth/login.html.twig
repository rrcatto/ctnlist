{% extends 'base.html.twig' %}

{% block title %}Sign in{% endblock %}

{% block content %}
{{ form_start(form, {attr: {class: 'app-narrow'}}) }}
  <fieldset class="border rounded p-4">
    <legend>Sign in by email</legend>
    <p>Enter your email address. We will send you a one-time sign-in link valid for {{ link_lifetime }}.</p>
    {{ form_errors(form) }}
    {{ form_row(form.email) }}
    <button class="btn btn-primary" type="submit"><i class="bi bi-envelope-arrow-up me-1" aria-hidden="true"></i>Email me a sign-in link</button>
  </fieldset>
{{ form_end(form) }}
{% endblock %}
