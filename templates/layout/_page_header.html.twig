{#
  Page header: title, optional short description and actions (primary first).
  {% embed 'layout/_page_header.html.twig' with {title: 'Messages', description: '…'} %}
    {% block actions %}<a class="btn btn-primary" href="…">New message</a>{% endblock %}
  {% endembed %}
#}
<div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-4">
  <div class="me-auto">
    <h1 class="h3 mb-1">{{ title }}</h1>
    {% if description ?? false %}<p class="text-body-secondary mb-0">{{ description }}</p>{% endif %}
  </div>
  <div class="d-flex flex-wrap gap-2">{% block actions %}{% endblock %}</div>
</div>
