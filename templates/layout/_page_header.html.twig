{#
  Page header: title, optional short description and actions (primary first).
  {% embed 'layout/_page_header.html.twig' with {title: 'Messages', description: '…'} %}
    {% block actions %}<a class="btn-solid theme-primary" href="…">New message</a>{% endblock %}
  {% endembed %}
#}
<div class="d-flex flex-wrap align-items-start justify-content-between gap-5 mb-7">
  <div class="me-auto">
    <h1 class="h3 mb-1">{{ title }}</h1>
    {% if description ?? false %}<p class="fg-2 mb-0">{{ description }}</p>{% endif %}
  </div>
  <div class="d-flex flex-wrap gap-3">{% block actions %}{% endblock %}</div>
</div>
