{# Site footer: the list, its configured contact details and the policy links. #}
<footer class="app-footer border-top bg-body-tertiary mt-auto">
  <div class="container py-4">
    <div class="row gy-3">
      <div class="col-md-7">
        <div class="fw-semibold mb-1">{{ site.listName }}</div>
        {% if site.aboutUs %}<p class="small text-body-secondary mb-2">{{ site.aboutUs }}</p>{% endif %}
        <a class="small" href="{{ path('subscribe') }}"><i class="bi bi-person-plus me-1" aria-hidden="true"></i>Subscribe to the mailing list</a>
      </div>
      <div class="col-md-5">
        <ul class="list-unstyled small text-body-secondary mb-0">
          {% if site.streetAddress %}<li class="mb-1"><i class="bi bi-geo-alt me-2" aria-hidden="true"></i>{{ site.streetAddress }}</li>{% endif %}
          {% if site.telephone %}<li class="mb-1"><i class="bi bi-telephone me-2" aria-hidden="true"></i>{{ site.telephone }}</li>{% endif %}
          {% if site.whatsApp %}<li class="mb-1"><i class="bi bi-whatsapp me-2" aria-hidden="true"></i>{% if site.whatsAppUrl %}<a href="{{ site.whatsAppUrl }}" target="_blank" rel="noopener">{{ site.whatsApp }}</a>{% else %}{{ site.whatsApp }}{% endif %}</li>{% endif %}
          {% if site.adminEmail %}<li class="mb-1"><i class="bi bi-envelope me-2" aria-hidden="true"></i><a href="mailto:{{ site.adminEmail }}">{{ site.adminName ?: site.adminEmail }}</a></li>{% endif %}
          {% if site.facebookUrl %}<li class="mb-1"><i class="bi bi-facebook me-2" aria-hidden="true"></i><a href="{{ site.facebookUrl }}" target="_blank" rel="noopener">Facebook</a></li>{% endif %}
        </ul>
      </div>
    </div>
    <div class="d-flex flex-column flex-sm-row justify-content-between gap-2 border-top mt-3 pt-3 small text-body-secondary">
      <span>&copy; 2009&ndash;{{ 'now'|date('Y') }} {{ site.organisation ?: site.listName }}. All rights reserved.</span>
      <nav aria-label="Footer">
        <a href="{{ path('privacy') }}">Privacy</a>
        <span class="mx-1" aria-hidden="true">&middot;</span>
        <a href="{{ path('contact') }}">Contact</a>
      </nav>
    </div>
  </div>
</footer>
