{# Site footer: the list, its configured contact details and the policy links. #}
<footer class="app-footer border-top bg-1 mt-auto">
  <div class="container py-7">
    <div class="row gy-5">
      <div class="md:col-7">
        <div class="fw-semibold mb-1">{{ site.listName }}</div>
        {% if site.aboutUs %}<p class="small fg-2 mb-3">{{ site.aboutUs }}</p>{% endif %}
        <a class="small" href="{{ path('subscribe') }}"><i class="bi bi-person-plus me-1" aria-hidden="true"></i>Subscribe to the mailing list</a>
      </div>
      <div class="md:col-5">
        <ul class="list-unstyled small fg-2 mb-0">
          {% if site.streetAddress %}<li class="mb-1"><i class="bi bi-geo-alt me-3" aria-hidden="true"></i>{{ site.streetAddress }}</li>{% endif %}
          {% if site.telephone %}<li class="mb-1"><i class="bi bi-telephone me-3" aria-hidden="true"></i>{{ site.telephone }}</li>{% endif %}
          {% if site.whatsApp %}<li class="mb-1"><i class="bi bi-whatsapp me-3" aria-hidden="true"></i>{% if site.whatsAppUrl %}<a href="{{ site.whatsAppUrl }}" target="_blank" rel="noopener">{{ site.whatsApp }}</a>{% else %}{{ site.whatsApp }}{% endif %}</li>{% endif %}
          {% if site.adminEmail %}<li class="mb-1"><i class="bi bi-envelope me-3" aria-hidden="true"></i><a href="mailto:{{ site.adminEmail }}">{{ site.adminName ?: site.adminEmail }}</a></li>{% endif %}
          {% if site.facebookUrl %}<li class="mb-1"><i class="bi bi-facebook me-3" aria-hidden="true"></i><a href="{{ site.facebookUrl }}" target="_blank" rel="noopener">Facebook</a></li>{% endif %}
        </ul>
      </div>
    </div>
    <div class="d-flex flex-column sm:flex-row justify-content-between gap-3 border-top mt-5 pt-5 small fg-2">
      <span>&copy; 2009&ndash;{{ 'now'|date('Y') }} {{ site.organisation ?: site.listName }}. All rights reserved.</span>
      <nav aria-label="Footer">
        <a href="{{ path('privacy') }}">Privacy</a>
        <span class="mx-1" aria-hidden="true">&middot;</span>
        <a href="{{ path('contact') }}">Contact</a>
      </nav>
    </div>
  </div>
</footer>
