{#
  Administration bar. Every item names the ACL permission its controller
  requires (#[IsGranted]); only items the signed-in user is granted are shown,
  so custom roles see exactly the tools they may use (administrators get all
  permissions through AclVoter). This only hides links: the controllers still
  enforce the permissions. A group with one visible item becomes a plain link.
  `routes` lists the pages that highlight the group; an item with `badge`
  also shows its counter on the group.
#}
{% set admin_groups = [
  {label: 'Messages', icon: 'envelope', routes: ['admin_messages', 'admin_message', 'admin_proof', 'report_message_views', 'message_forward_admin'], items: [
    {label: 'All messages', route: 'admin_messages', permission: 'messages.manage', counter: 'messages'},
    {label: 'New message', route: 'admin_message', permission: 'messages.manage'},
  ]},
  {label: 'Templates', icon: 'file-earmark-text', routes: ['admin_templates', 'admin_template'], items: [
    {label: 'All templates', route: 'admin_templates', permission: 'templates.manage', counter: 'templates'},
    {label: 'New template', route: 'admin_template', permission: 'templates.manage'},
  ]},
  {label: 'Sending', icon: 'send', routes: ['admin_queue', 'admin_queue_message', 'admin_queue_rotation', 'admin_queue_process', 'admin_queue_stop', 'admin_delivery', 'admin_delivery_message', 'admin_delivery_job', 'admin_delivery_recipient'], items: [
    {label: 'Queue', route: 'admin_queue', permission: 'queue.process', counter: 'queue', badge: true},
    {label: 'Queue multiple messages', route: 'admin_queue_rotation', permission: 'messages.queue'},
    {label: 'Start sending', route: 'admin_queue_process', permission: 'queue.process'},
    {label: 'Stop sending', route: 'admin_queue_stop', permission: 'queue.process'},
    {label: 'Delivery (catto-mail)', route: 'admin_delivery', permission: 'logs.view'},
  ]},
  {label: 'Subscribers', icon: 'people', routes: ['admin_subscribers', 'admin_subscribers_active', 'admin_subscriber', 'admin_bulk_subscribe', 'admin_bulk_unsubscribe', 'admin_import', 'admin_export', 'admin_sync', 'admin_validation', 'admin_validation_job'], items: [
    {label: 'All subscribers', route: 'admin_subscribers', permission: 'subscribers.view', counter: 'subscribers'},
    {label: 'Active readers', route: 'admin_subscribers_active', permission: 'subscribers.view', counter: 'activeReaders'},
    {label: 'Bulk subscribe', route: 'admin_bulk_subscribe', permission: 'subscribers.manage'},
    {label: 'Bulk unsubscribe', route: 'admin_bulk_unsubscribe', permission: 'subscribers.manage'},
    {label: 'Import', route: 'admin_import', permission: 'subscribers.manage'},
    {label: 'Export', route: 'admin_export', permission: 'subscribers.manage'},
    {label: 'Synchronise', route: 'admin_sync', permission: 'subscribers.manage'},
    {label: 'Address validation', route: 'admin_validation', permission: 'subscribers.manage'},
  ]},
  {label: 'Lists', icon: 'list-ul', routes: ['admin_lists'], items: [
    {label: 'Lists', route: 'admin_lists', permission: 'lists.manage'},
  ]},
  {label: 'Reports', icon: 'bar-chart', routes: ['report_sendlog', 'report_sitelog'], items: [
    {label: 'Send Log', route: 'report_sendlog', permission: 'logs.view', counter: 'sendlog'},
    {label: 'Site Log', route: 'report_sitelog', permission: 'logs.view'},
  ]},
  {label: 'Roles & ACL', icon: 'shield-lock', routes: ['admin_roles', 'admin_role'], items: [
    {label: 'Roles & ACL', route: 'admin_roles', permission: 'roles.manage'},
  ]},
  {label: 'Settings', icon: 'sliders', routes: ['admin_settings'], items: [
    {label: 'Settings', route: 'admin_settings', permission: 'settings.manage'},
  ]},
] %}
{% set route = app.request.attributes.get('_route') %}
{% set visible_groups = [] %}
{% if app.user %}
  {% for group in admin_groups %}
    {% set items = group.items|filter(item => is_granted(item.permission)) %}
    {% if items is not empty %}
      {% set visible_groups = visible_groups|merge([group|merge({items: items})]) %}
    {% endif %}
  {% endfor %}
{% endif %}
{% if visible_groups is not empty %}
<nav class="navbar lg:navbar-expand bg-1 app-adminbar" data-bs-theme="dark" aria-label="Administration">
  <div class="container">
    <span class="navbar-text fg-3 me-5 d-none lg:d-inline"><i class="bi bi-gear me-1" aria-hidden="true"></i>Admin</span>
    <button class="navbar-toggler btn-text btn-sm px-0 fg-2" type="button" data-bs-toggle="drawer" data-bs-target="#admin-nav" aria-controls="admin-nav" aria-expanded="false" aria-label="Toggle administration menu">
      <i class="bi bi-gear" aria-hidden="true"></i>Administration
    </button>
    {# Below the lg breakpoint the administration menu is a drawer; from lg up Bootstrap lays it out inline. #}
    <dialog class="drawer drawer-end" tabindex="-1" id="admin-nav" aria-labelledby="admin-nav-label">
      <div class="drawer-header">
        <h2 class="drawer-title h5" id="admin-nav-label">Administration</h2>
        <button type="button" class="btn-close" data-bs-dismiss="drawer" aria-label="Close"></button>
      </div>
      <div class="drawer-body">
        <ul class="nav navbar-nav">
          {% for group in visible_groups %}
            {% set group_active = route in group.routes %}
            {% if group.items|length == 1 %}
              {% set item = group.items|first %}
              <li class="nav-item">
                <a class="nav-link{{ group_active ? ' active' }}" href="{{ path(item.route) }}"{% if route == item.route %} aria-current="page"{% endif %}><i class="bi bi-{{ group.icon }}" aria-hidden="true"></i>{{ item.label }}</a>
              </li>
            {% else %}
              {% set menu_id = 'admin-menu-' ~ loop.index %}
              <li class="nav-item">
                <button class="nav-link{{ group_active ? ' active' }}" type="button" id="{{ menu_id }}" data-bs-toggle="menu" aria-expanded="false">
                  <i class="bi bi-{{ group.icon }}" aria-hidden="true"></i>{{ group.label }}
                  {%- set badge_item = group.items|filter(item => (item.badge ?? false))|first %}
                  {%- if badge_item %}
                    <span class="badge rounded-pill theme-secondary">{{ attribute(counters, badge_item.counter) }}</span>
                  {%- endif %}
                  <i class="bi bi-chevron-down small" aria-hidden="true"></i>
                </button>
                <div class="menu" aria-labelledby="{{ menu_id }}">
                  {% for item in group.items %}
                    <a class="menu-item justify-content-between{{ route == item.route ? ' active' }}" href="{{ path(item.route) }}"{% if route == item.route %} aria-current="page"{% endif %}>
                      <span>{{ item.label }}</span>
                      {% if item.counter is defined %}<span class="badge rounded-pill badge-subtle theme-secondary">{{ attribute(counters, item.counter) }}</span>{% endif %}
                    </a>
                  {% endfor %}
                </div>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>
    </dialog>
  </div>
</nav>
{% endif %}
