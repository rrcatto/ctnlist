{# Shown instead of an empty table. Variables: message, optional icon (Bootstrap Icons name) and hint. #}
<div class="text-center fg-2 border border-dashed rounded-5 py-12 px-5">
  <i class="bi bi-{{ icon ?? 'inbox' }} fs-3xl d-block mb-3" aria-hidden="true"></i>
  <p class="fw-semibold fg-body mb-1">{{ message }}</p>
  {% if hint ?? false %}<p class="small mb-0">{{ hint }}</p>{% endif %}
</div>
