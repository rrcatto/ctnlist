{# A value a person copies elsewhere, with its copy button (owner decision 2026-10-27; assets/app.js).
   `value` the text; `id` a unique element id; `label` what it is, for screen readers. Without
   JavaScript the button stays hidden and the value can be selected as usual. #}
<span class="app-copy"><code id="{{ id }}">{{ value }}</code><button class="btn-outline theme-secondary btn-sm" type="button" data-copy="{{ id }}" hidden><i class="bi bi-clipboard me-1" aria-hidden="true"></i><span data-copy-label>Copy</span><span class="visually-hidden"> {{ label|default('the value') }}</span></button></span>
