{#
  A send job's state, its actions and its recipients (Admin\DeliveryController::job()): the page
  includes it, and it is the htmx region send-job, drawn again by the status filter, the pager and
  the actions, and every 15 seconds while catto-mail is still working on the job.
#}
{% import 'admin/_cattomail_macros.html.twig' as cm %}
{% import 'layout/_htmx.html.twig' as hx %}
{% set here = path('admin_delivery_job', {id: job.csj_id, page: pagination.page}) ~ (status ? '?s=' ~ status : '') %}
{% set working = job.csj_status not in ['completed', 'failed', 'cancelled'] %}
<div id="send-job" class="app-region"{% if working %} {{ hx.refresh(here, 'send-job', '15s') }}{% endif %}>
<div class="d-flex flex-wrap align-items-center gap-3 mb-5">
  <p class="mb-0">{{ cm.category(category) }} {{ cm.job_status(job.csj_status) }} <span class="small fg-2 ms-3">{{ job.csj_remote_id ? 'catto-mail job ' ~ job.csj_remote_id : 'not created at catto-mail yet' }}{{ job.csj_completed_at ? ' · finished ' ~ job.csj_completed_at|slice(0, 16) }}</span></p>
  <div class="d-flex flex-wrap gap-3 ms-auto">
    {% if job.csj_remote_id %}
      <form method="post" action="{{ path('admin_delivery_refresh', {id: job.csj_id}) }}" {{ hx.post(path('admin_delivery_refresh', {id: job.csj_id}), 'send-job') }}>
        <input type="hidden" name="csrf" value="{{ csrf_token('ctnlist') }}">
        <button class="btn-sm btn-outline theme-secondary" type="submit"><i class="bi bi-arrow-repeat me-1" aria-hidden="true"></i>Ask catto-mail now</button>
      </form>
    {% endif %}
    {% if job.csj_status in ['open', 'ready'] and is_granted('queue.process') %}
      <form method="post" action="{{ path('admin_delivery_retry', {id: job.csj_id}) }}" data-confirm="Hand this job to catto-mail now? Its stored keys make sure nothing is created or sent twice." {{ hx.post(path('admin_delivery_retry', {id: job.csj_id}), 'send-job') }}>
        <input type="hidden" name="csrf" value="{{ csrf_token('ctnlist') }}">
        <button class="btn-sm btn-outline theme-primary" type="submit"><i class="bi bi-send me-1" aria-hidden="true"></i>Retry sending</button>
      </form>
    {% endif %}
    {% if job.csj_status == 'failed' and is_granted('queue.process') %}
      <form method="post" action="{{ path('admin_delivery_requeue', {id: job.csj_id}) }}" data-confirm="Return the subscribers of this failed job to the queue?" {{ hx.post(path('admin_delivery_requeue', {id: job.csj_id}), 'send-job') }}>
        <input type="hidden" name="csrf" value="{{ csrf_token('ctnlist') }}">
        <button class="btn-sm btn-outline theme-primary" type="submit"><i class="bi bi-arrow-counterclockwise me-1" aria-hidden="true"></i>Return to queue</button>
      </form>
    {% endif %}
  </div>
</div>
{% if working %}<p class="small fg-2">This page updates itself every 15 seconds while catto-mail works on the job.</p>{% endif %}
{% if job.csj_error %}<div class="alert {{ job.csj_status == 'failed' ? 'theme-danger' : 'theme-warning' }} small text-break" role="alert"><div>{{ job.csj_status == 'failed' ? 'catto-mail refused this job: ' : 'Last attempt failed (it is retried automatically): ' }}{{ job.csj_error }}</div></div>{% endif %}
<p class="small">Part of the <a href="{{ path('admin_delivery_run', {uuid: run.uuid}) }}">{{ run.kind }} run</a> (job {{ job.csj_seq }}){% if job.csj_remote_id %} · <a href="{{ path('admin_delivery_webhooks', {j: job.csj_remote_id}) }}">its webhook events</a>{% endif %}</p>
{% if category == 'Stuck' %}<div class="alert theme-warning small" role="note"><div>This job has not moved on for a long time. The worker keeps retrying it; you can also retry or check it now. Nothing is sent twice.</div></div>{% endif %}
{% if summary is not empty %}<p class="small">{% for s, n in summary %}{% if n > 0 %}<span class="me-5 text-nowrap">{{ cm.message_status(s) }} {{ n }}</span>{% endif %}{% endfor %}</p>{% endif %}

{% if recipients is empty %}
  {% include 'layout/_empty_state.html.twig' with {icon: 'people', message: 'No recipients to show.'} %}
{% else %}
  <div class="table-responsive">
    <table class="table table-hover align-middle">
      <thead class=""><tr><th scope="col">Recipient</th><th scope="col">Type</th><th scope="col">Status</th><th scope="col" class="text-end"><span class="visually-hidden">Events</span></th></tr></thead>
      <tbody>
      {% for r in recipients %}
        <tr>
          <td class="text-break">{% if r.crp_s_uuid and is_granted('subscribers.manage') %}<a href="{{ path('admin_subscriber', {token: r.crp_s_uuid}) }}">{{ r.crp_email }}</a>{% else %}{{ r.crp_email }}{% endif %}</td>
          <td class="small">{{ r.crp_type }}</td>
          <td>{{ cm.message_status(r.crp_status) }}</td>
          <td class="text-end">{% if r.crp_remote_message_id %}<a class="btn-sm btn-outline theme-secondary" href="{{ path('admin_delivery_recipient', {uuid: r.crp_uuid}) }}">Events</a>{% endif %}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
  {% include '_pagination.html.twig' with {base: path('admin_delivery_job', {id: job.csj_id}), query: status ? '?s=' ~ status : '', region: 'send-job'} %}
{% endif %}
</div>
