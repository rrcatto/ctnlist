{% extends 'base.html.twig' %}

{% block title %}Queue multiple messages{% endblock %}

{% block content %}
{% include 'layout/_page_header.html.twig' with {title: 'Queue multiple messages', description: 'Queues up to four messages in rotation across their combined audience, up to a total number of emails. Nothing is sent until sending is started.'} %}

{{ form_start(form, {attr: {class: 'card'}}) }}
  <div class="card-body">
    {{ form_errors(form) }}
    <div class="row g-3">
      {% for slot in 1..4 %}{{ form_row(form['message' ~ slot]) }}{% endfor %}
      {{ form_row(form.volume) }}
    </div>
  </div>
  <div class="card-footer d-flex flex-wrap gap-2">
    <button class="btn btn-primary" type="submit"><i class="bi bi-list-check me-1" aria-hidden="true"></i>Queue messages</button>
    <a class="btn btn-outline-secondary" href="{{ path('admin_queue') }}">Cancel</a>
  </div>
{{ form_end(form) }}
{% endblock %}
