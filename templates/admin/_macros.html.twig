{# Status badges shared by the administration pages. #}

{# A list membership state: confirmed, pending, unsubscribed or not joined. #}
{% macro membership_badge(state) %}
  {%- set styles = {confirmed: 'theme-success', pending: 'theme-warning', unsubscribed: 'theme-secondary'} -%}
  <span class="badge {{ styles[state] ?? 'badge-subtle theme-secondary' }}">{{ state }}</span>
{%- endmacro %}

{# State of a membership row from MembershipRepository::forSubscriber(). #}
{% macro membership_state(membership) %}
  {{- membership.ls_uuid is null ? 'not joined' : (membership.unsubscribed ? 'unsubscribed' : (membership.confirmed ? 'confirmed' : 'pending')) -}}
{% endmacro %}

{% macro system_badge(system) %}
  {%- if system %}<span class="badge theme-inverse"><i class="bi bi-lock-fill me-1" aria-hidden="true"></i>System</span>{% else %}<span class="badge badge-subtle theme-secondary">Custom</span>{% endif -%}
{% endmacro %}

{% macro active_badge(active) %}
  {%- if active %}<span class="badge theme-success">Active</span>{% else %}<span class="badge theme-secondary">Inactive</span>{% endif -%}
{% endmacro %}

