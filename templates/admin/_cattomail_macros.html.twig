{# Badges for catto-mail states (vocabulary from catto-mail; never reinterpreted). #}
{% macro classification(value) %}
  {%- set styles = {deliverable: 'theme-success', probably_deliverable: 'badge-subtle theme-success', risky: 'theme-warning', unknown: 'theme-secondary',
      temporarily_unverifiable: 'theme-info', undeliverable: 'theme-danger'} -%}
  {%- if value -%}<span class="badge {{ styles[value] ?? 'badge-subtle theme-secondary' }}">{{ value|replace({'_': ' '}) }}</span>{%- else -%}<span class="badge badge-subtle theme-secondary">pending</span>{%- endif -%}
{% endmacro %}

{% macro job_status(value) %}
  {%- set styles = {open: 'badge-subtle theme-secondary', ready: 'badge-subtle theme-secondary', pending: 'badge-subtle theme-secondary', queued: 'theme-info', processing: 'theme-primary',
      dispatched: 'theme-primary', completed: 'theme-success', failed: 'theme-danger', cancelled: 'theme-secondary'} -%}
  <span class="badge {{ styles[value] ?? 'badge-subtle theme-secondary' }}">{{ value }}</span>
{%- endmacro %}

{% macro message_status(value) %}
  {%- set styles = {staged: 'badge-subtle theme-secondary', handed_off: 'theme-info', not_sent: 'theme-secondary', remote_accepted: 'theme-success',
      deferred: 'theme-warning', soft_bounced: 'theme-warning', outcome_unknown: 'theme-secondary', hard_bounced: 'theme-danger',
      complained: 'theme-danger', failed: 'theme-danger', suppressed: 'theme-inverse'} -%}
  <span class="badge {{ styles[value] ?? 'badge-subtle theme-secondary' }}">{{ value|replace({'_': ' '}) }}</span>
{%- endmacro %}

{# An administrator's view of a job (App\Maintenance\StuckWork::jobCategory()). #}
{% macro category(value) %}
  {%- set styles = {Pending: 'theme-info', Stuck: 'theme-warning', Failed: 'theme-danger', Cancelled: 'theme-secondary', Completed: 'theme-success',
      'Awaiting reconciliation': 'theme-primary'} -%}
  <span class="badge {{ styles[value] ?? 'badge-subtle theme-secondary' }}">{{ value }}</span>
{%- endmacro %}
