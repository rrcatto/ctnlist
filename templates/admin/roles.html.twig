{% extends 'base.html.twig' %}
{% import 'admin/_macros.html.twig' as ui %}

{% block title %}Roles and ACL{% endblock %}

{% block content %}
{% include 'layout/_page_header.html.twig' with {title: 'Roles and access control', description: 'Roles grant permissions; subscribers hold roles. Pages and actions check permissions, so a custom role can be given exactly the tools it needs. System roles are fixed.'} %}

<div class="card mb-7">
  <div class="card-header fw-semibold">Roles</div>
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class=""><tr><th scope="col">Role</th><th scope="col">Type</th><th scope="col" class="text-end">Members</th><th scope="col" class="text-end">Permissions</th><th scope="col" class="text-end"><span class="visually-hidden">Actions</span></th></tr></thead>
      <tbody>
      {% for role in roles %}
        <tr>
          <td>
            <a class="fw-semibold" href="{{ path('admin_role', {id: role.r_id}) }}">{{ role.r_name }}</a> <code class="small">{{ role.r_key }}</code>
            {% if role.r_description %}<div class="small fg-2 d-none md:d-block">{{ role.r_description }}</div>{% endif %}
          </td>
          <td>{{ ui.system_badge(role.r_system) }}</td>
          <td class="text-end">{{ member_counts[role.r_id] ?? 0 }}</td>
          <td class="text-end">{{ (granted[role.r_id] ?? [])|length }}</td>
          <td class="text-end"><a class="btn-sm btn-outline theme-secondary" href="{{ path('admin_role', {id: role.r_id}) }}">{{ role.r_system ? 'View' : 'Manage' }}</a></td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
</div>

<div class="card mb-7" id="assign">
  <div class="card-header fw-semibold">Assign a role to a subscriber</div>
  <div class="card-body">
    {# Searches as you type (layout/_htmx.html.twig, search): the attributes are given here because Symfony renders the form tag. #}
    {{ form_start(search_form, {attr: {class: 'row g-3 align-items-start mb-5', role: 'search', 'aria-label': 'Find a subscriber',
        'hx-get': path('admin_roles'), 'hx-trigger': 'input delay:300ms, submit', 'hx-target': '#role-search-results', 'hx-swap': 'outerHTML', 'hx-replace-url': 'true', 'hx-sync': 'this:replace'}}) }}
      <div class="md:col-8">{{ form_row(search_form.q, {row_attr: {class: 'mb-0'}}) }}</div>
      <div class="md:col-4 d-flex align-items-center gap-3 md:pt-7 md:mt-3">
        <noscript><button class="btn-solid theme-primary" type="submit"><i class="bi bi-search me-1" aria-hidden="true"></i>Search</button></noscript>
        {% if search %}<a class="btn-outline theme-secondary" href="{{ path('admin_roles') }}#assign">Clear</a>{% endif %}
        <span class="small fg-2 htmx-indicator" role="status">Searching…</span>
      </div>
    {{ form_end(search_form) }}

    {% include 'admin/_role_search_results.html.twig' %}
  </div>
</div>

<div class="row g-7 mb-7">
  <div class="lg:col-6">
    {{ form_start(form, {attr: {class: 'card h-100', id: 'create-role'}}) }}
      <div class="card-header fw-semibold">Create custom role</div>
      <div class="card-body">
        {{ form_errors(form) }}
        {{ form_row(form.key) }}
        {{ form_row(form.name) }}
        {{ form_row(form.description, {row_attr: {class: 'mb-0'}}) }}
      </div>
      <div class="card-footer"><button class="btn-solid theme-primary" type="submit"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Create role</button></div>
    {{ form_end(form) }}
  </div>
  <div class="lg:col-6">
    <div class="card h-100">
      <div class="card-header fw-semibold">Who can change what</div>
      <div class="card-body small">
        <p><code>roles.manage</code> opens these pages: create, rename and delete custom roles, assign roles and remove custom roles from subscribers.</p>
        <p><code>acl.manage</code> additionally allows changing a custom role’s permissions (it needs <code>roles.manage</code> to reach them).</p>
        <p class="mb-0">Only administrators can hand out permissions they do not hold themselves. System roles are fixed: <strong>Subscriber</strong> is held by everyone, and <strong>Administrator</strong> holds every permission.</p>
      </div>
    </div>
  </div>
</div>

<details>
  <summary class="h5 mb-5">Permissions by role</summary>
  <div class="table-responsive">
    <table class="table table-sm table-hover align-middle">
      <thead class="">
        <tr>
          <th scope="col">Permission</th>
          {% for role in roles %}<th scope="col" class="text-center">{{ role.r_name }}</th>{% endfor %}
        </tr>
      </thead>
      <tbody>
      {% for permission in permissions %}
        <tr>
          <th scope="row" class="fw-normal"><code>{{ permission.ap_key }}</code><div class="small fg-2">{{ permission.ap_name }}</div></th>
          {% for role in roles %}
            <td class="text-center">
              {% if permission.ap_id in (granted[role.r_id] ?? []) %}<i class="bi bi-check-circle-fill fg-success" aria-hidden="true"></i><span class="visually-hidden">granted</span>{% else %}<span class="fg-3" aria-hidden="true">–</span><span class="visually-hidden">not granted</span>{% endif %}
            </td>
          {% endfor %}
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
</details>
{% endblock %}
