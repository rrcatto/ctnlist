{% extends 'base.html.twig' %}

{% block title %}Settings{% endblock %}

{#
  Settings page: one tab per group, each with its own form and Save button.
  The active tab is kept in the URL hash, e.g. #smtp (assets/app.js), so
  saving returns to it. Secret values are never written into the page: SMTP passwords are
  shown only as set / not set, and an empty password field keeps the
  current one.
#}
{% macro source(field) %}
  {%- if field.source == 'database' -%}
    <span class="badge text-bg-primary" title="{{ field.override.by ? 'Changed by ' ~ field.override.by : '' }}{{ field.override.at ? ' on ' ~ field.override.at|slice(0, 16) : '' }}">Database</span>
  {%- elseif field.source == 'env' -%}
    <span class="badge text-bg-light border">.env</span>
  {%- else -%}
    <span class="badge text-bg-secondary">Default</span>
  {%- endif -%}
{% endmacro %}

{# Label row: label and source badge on one line. #}
{% macro head(setting, field, for) %}
  {% import _self as s %}
  <div class="d-flex align-items-center gap-2 mb-1">
    <label class="form-label fw-semibold mb-0 text-truncate" for="{{ for }}">{{ setting.label }}</label>
    {{- s.source(field) -}}
  </div>
{% endmacro %}

{# Under the control: help, the variable name, and for overrides the inherited value with a reset button. #}
{% macro foot(name, setting, field, withHelp = true) %}
  {% if withHelp and setting.help is defined %}<div class="form-text">{{ setting.help }}</div>{% endif %}
  <div class="form-text d-flex flex-wrap align-items-center column-gap-2">
    <code class="text-body-secondary">{{ name }}</code>
    {% if field.source == 'database' %}
      <span aria-hidden="true">·</span>
      <span>Without the override:
        {% if setting.secret ?? false %}{{ field.env_set ? 'the value in .env' : 'not set' }}
        {% elseif field.env is not same as('') %}<code>{{ field.env|length > 60 ? field.env|slice(0, 60) ~ '…' : field.env }}</code> (.env)
        {% elseif field.default %}<code>{{ field.default|length > 60 ? field.default|slice(0, 60) ~ '…' : field.default }}</code> (default)
        {% else %}<em>empty</em>{% endif %}</span>
      <button class="btn btn-link btn-sm p-0 align-baseline" type="submit" formaction="{{ path('admin_setting_reset', {name: name}) }}" formnovalidate><i class="bi bi-arrow-counterclockwise me-1" aria-hidden="true"></i>Reset override</button>
    {% endif %}
  </div>
{% endmacro %}

{% block content %}
{% import _self as s %}
{% set widths = {full: 'col-12', half: 'col-md-6', third: 'col-md-6 col-xl-4', quarter: 'col-sm-6 col-xl-3'} %}
{% include 'layout/_page_header.html.twig' with {title: 'Settings', description: 'Each setting comes from the database (a value changed here), else the installation’s .env file, else a built-in default. Changes apply from the next page or email; .env is never changed. Setting a value back to .env, or resetting it, makes .env apply again. Secret keys, database settings, URLs and paths stay in .env.'} %}

<ul class="nav nav-tabs flex-nowrap text-nowrap overflow-x-auto app-tabs" role="tablist" data-remember-tab>
  {% for key, group in groups %}
    {% set overridden = group.settings|keys|filter(n => fields[n].source == 'database')|length %}
    <li class="nav-item" role="presentation">
      <button class="nav-link{{ loop.first ? ' active' }}" id="tab-{{ key }}" data-bs-toggle="tab" data-bs-target="#pane-{{ key }}" data-tab-hash="{{ key }}" type="button" role="tab" aria-controls="pane-{{ key }}" aria-selected="{{ loop.first ? 'true' : 'false' }}">
        {{ group.tab }}{% if overridden %} <span class="badge rounded-pill text-bg-primary ms-1" title="{{ overridden }} set here">{{ overridden }}</span>{% endif %}
      </button>
    </li>
  {% endfor %}
</ul>

<div class="tab-content border border-top-0 rounded-bottom p-3 p-md-4 mb-4">
  {% for key, group in groups %}
    {% set overridden = group.settings|keys|filter(n => fields[n].source == 'database') %}
    <div class="tab-pane fade{{ loop.first ? ' show active' }}" id="pane-{{ key }}" role="tabpanel" aria-labelledby="tab-{{ key }}">
      <form method="post" action="{{ path('admin_settings_save', {group: key}) }}">
        <input type="hidden" name="csrf" value="{{ csrf_token('ctnlist') }}">
        <h2 class="h5 mb-1">{{ group.label }}</h2>
        <p class="small text-body-secondary mb-4">{{ group.description }}</p>

        {% if key == 'smtp' and cipher_problem %}
          <div class="alert alert-warning small" role="note"><i class="bi bi-key me-1" aria-hidden="true"></i>SMTP settings can only be changed here once an encryption key is configured: {{ cipher_problem }}</div>
        {% endif %}

        <div class="row g-4">
          {% for name, setting in group.settings %}
            {% set field = fields[name] %}
            {% set id = 'setting-' ~ name|lower %}
            {% if setting.heading is defined %}
              <div class="col-12 mb-n2"><h3 class="h6 mb-0">{{ setting.heading }}</h3></div>
            {% endif %}

            {% if setting.type == 'dsn' %}
              {% set dsn = field.dsn %}
              <div class="col-12">
                <fieldset class="border rounded p-3">
                  <legend class="fs-6 fw-semibold float-none w-auto px-1 mb-0 d-flex align-items-center gap-2">{{ setting.label }} {{ s.source(field) }}</legend>
                  {% if field.secret_problem %}<div class="alert alert-danger small py-2 mt-2" role="alert"><i class="bi bi-exclamation-octagon me-1" aria-hidden="true"></i>The stored value cannot be used: {{ field.secret_problem }} Mail that needs it fails until it is entered again or the override is reset.</div>{% endif %}
                  {% if dsn.other %}<div class="alert alert-secondary small py-2 mt-2">Currently <code>{{ dsn.other }}</code>, which is not an SMTP server; enter a server to replace it.</div>{% endif %}
                  <div class="row g-3 mt-0">
                    <div class="col-md-6 col-xl-5"><label class="form-label small" for="{{ id }}-host">Server</label><input class="form-control" id="{{ id }}-host" name="smtp_host" value="{{ dsn.host }}" placeholder="mail.example.com" autocomplete="off"></div>
                    <div class="col-6 col-md-2"><label class="form-label small" for="{{ id }}-port">Port</label><input class="form-control" id="{{ id }}-port" name="smtp_port" inputmode="numeric" value="{{ dsn.port }}" placeholder="587"></div>
                    <div class="col-6 col-md-4 col-xl-5">
                      <label class="form-label small" for="{{ id }}-scheme">Security</label>
                      <select class="form-select" id="{{ id }}-scheme" name="smtp_scheme">
                        <option value="smtp"{{ dsn.scheme == 'smtp' ? ' selected' }}>SMTP / STARTTLS</option>
                        <option value="smtps"{{ dsn.scheme == 'smtps' ? ' selected' }}>SMTP over TLS</option>
                      </select>
                    </div>
                    <div class="col-md-6 col-xl-5"><label class="form-label small" for="{{ id }}-user">Username</label><input class="form-control" id="{{ id }}-user" name="smtp_username" value="{{ dsn.username }}" autocomplete="off"></div>
                    <div class="col-md-6 col-xl-4">
                      <label class="form-label small" for="{{ id }}-password">Password <span class="badge {{ dsn.has_password ? 'text-bg-success' : 'text-bg-light border' }}">{{ dsn.has_password ? 'set' : 'not set' }}</span></label>
                      <input class="form-control" id="{{ id }}-password" type="password" name="smtp_password" autocomplete="new-password" placeholder="{{ dsn.has_password ? 'Leave empty to keep the current password' : 'Not set' }}">
                    </div>
                    <div class="col-md-12 col-xl-3"><label class="form-label small" for="{{ id }}-options">Options</label><input class="form-control" id="{{ id }}-options" name="smtp_options" value="{{ dsn.options }}" placeholder="e.g. verify_peer=0"></div>
                  </div>
                  <div class="form-text mt-2">{{ setting.help ?? '' }} Clear the server to use the failover servers only.</div>
                  {{ s.foot(name, setting, field, false) }}
                </fieldset>
              </div>

            {% elseif setting.type == 'servers' %}
              {% set rows = field.servers|merge([
                {index: '', active: true, host: '', port: '', security: 'tls', username: '', has_password: false, batchsize: '600', delay: '10', sendrate: ''},
                {index: '', active: true, host: '', port: '', security: 'tls', username: '', has_password: false, batchsize: '600', delay: '10', sendrate: ''}
              ]) %}
              <div class="col-12">
                <fieldset class="border rounded p-3">
                  <legend class="fs-6 fw-semibold float-none w-auto px-1 mb-0 d-flex align-items-center gap-2">{{ setting.label }} {{ s.source(field) }}</legend>
                  {% if field.secret_problem %}<div class="alert alert-danger small py-2 mt-2" role="alert"><i class="bi bi-exclamation-octagon me-1" aria-hidden="true"></i>The stored value cannot be used: {{ field.secret_problem }} Mail that needs it fails until it is entered again or the override is reset.</div>{% endif %}
                  <p class="form-text mt-1 mb-3">{{ setting.help ?? '' }} Fill in an empty block to add a server.</p>
                  <div class="row g-3">
                    {% for row in rows %}
                      {% set rid = id ~ '-' ~ loop.index0 %}
                      {% set prefix = 'servers[' ~ loop.index0 ~ ']' %}
                      <div class="col-xl-6">
                        <div class="border rounded p-3 h-100 {{ row.host ? 'bg-body' : 'bg-body-tertiary' }}">
                          <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="fw-semibold small">{{ row.host ? 'Server ' ~ loop.index : 'New server' }}</span>
                            <div class="d-flex gap-3">
                              <div class="form-check form-switch mb-0"><input class="form-check-input" type="checkbox" role="switch" id="{{ rid }}-active" name="{{ prefix }}[active]" value="1"{{ row.active ? ' checked' }}><label class="form-check-label small" for="{{ rid }}-active">Active</label></div>
                              {% if row.host %}<div class="form-check mb-0"><input class="form-check-input" type="checkbox" id="{{ rid }}-remove" name="{{ prefix }}[remove]" value="1"><label class="form-check-label small text-danger" for="{{ rid }}-remove">Remove</label></div>{% endif %}
                            </div>
                          </div>
                          <input type="hidden" name="{{ prefix }}[index]" value="{{ row.index }}">
                          <div class="row g-2">
                            <div class="col-3 col-sm-2"><label class="form-label small" for="{{ rid }}-position">Order</label><input class="form-control" id="{{ rid }}-position" name="{{ prefix }}[position]" inputmode="numeric" value="{{ loop.index }}"></div>
                            <div class="col-9 col-sm-6"><label class="form-label small" for="{{ rid }}-host">Server</label><input class="form-control" id="{{ rid }}-host" name="{{ prefix }}[host]" value="{{ row.host }}" autocomplete="off"></div>
                            <div class="col-4 col-sm-4"><label class="form-label small" for="{{ rid }}-port">Port</label><input class="form-control" id="{{ rid }}-port" name="{{ prefix }}[port]" inputmode="numeric" value="{{ row.port }}"></div>
                            <div class="col-8 col-sm-12">
                              <label class="form-label small" for="{{ rid }}-security">Security</label>
                              <select class="form-select" id="{{ rid }}-security" name="{{ prefix }}[security]">
                                {% for value, label in {'': 'None', tls: 'STARTTLS (required)', ssl: 'SMTP over TLS'} %}<option value="{{ value }}"{{ row.security == value ? ' selected' }}>{{ label }}</option>{% endfor %}
                              </select>
                            </div>
                            <div class="col-sm-6"><label class="form-label small" for="{{ rid }}-user">Username</label><input class="form-control" id="{{ rid }}-user" name="{{ prefix }}[username]" value="{{ row.username }}" autocomplete="off"></div>
                            <div class="col-sm-6">
                              <label class="form-label small" for="{{ rid }}-password">Password{% if row.host %} <span class="badge {{ row.has_password ? 'text-bg-success' : 'text-bg-light border' }}">{{ row.has_password ? 'set' : 'not set' }}</span>{% endif %}</label>
                              <input class="form-control" id="{{ rid }}-password" type="password" name="{{ prefix }}[password]" autocomplete="new-password"{% if row.has_password %} placeholder="Leave empty to keep the current password"{% endif %}>
                            </div>
                            <div class="col-4"><label class="form-label small" for="{{ rid }}-batch">Batch size</label><input class="form-control" id="{{ rid }}-batch" name="{{ prefix }}[batchsize]" inputmode="numeric" value="{{ row.batchsize }}"></div>
                            <div class="col-4"><label class="form-label small" for="{{ rid }}-delay">Delay (s)</label><input class="form-control" id="{{ rid }}-delay" name="{{ prefix }}[delay]" inputmode="numeric" value="{{ row.delay }}"></div>
                            <div class="col-4"><label class="form-label small" for="{{ rid }}-rate">Per minute</label><input class="form-control" id="{{ rid }}-rate" name="{{ prefix }}[sendrate]" inputmode="numeric" value="{{ row.sendrate }}" placeholder="site rate"></div>
                          </div>
                        </div>
                      </div>
                    {% endfor %}
                  </div>
                  {{ s.foot(name, setting, field, false) }}
                </fieldset>
              </div>

            {% else %}
              <div class="{{ widths[setting.width ?? 'half'] }}">
                {% if setting.type == 'bool' %}
                  <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="form-label fw-semibold mb-0">{{ setting.label }}</span>{{ s.source(field) }}
                  </div>
                  <div class="form-check form-switch">
                    <input type="hidden" name="{{ name }}" value="false">
                    <input class="form-check-input" type="checkbox" role="switch" id="{{ id }}" name="{{ name }}" value="true"{{ field.value in ['true', '1', 'yes', 'on'] ? ' checked' }}>
                    <label class="form-check-label" for="{{ id }}">Enabled</label>
                  </div>
                {% else %}
                  {{ s.head(setting, field, id) }}
                  {% if setting.type == 'textarea' %}
                    <textarea class="form-control" id="{{ id }}" name="{{ name }}" rows="3"{% if field.default %} placeholder="Default: {{ field.default }}"{% endif %}>{{ field.value }}</textarea>
                  {% else %}
                    <input class="form-control" id="{{ id }}" name="{{ name }}"
                      type="{{ setting.type == 'email' ? 'email' : (setting.type == 'url' ? 'url' : (setting.type == 'int' ? 'number' : 'text')) }}"
                      {%- if setting.type == 'int' and setting.min is defined %} min="{{ setting.min }}"{% endif %}
                      {%- if field.default and setting.type != 'int' %} placeholder="Default: {{ field.default }}"{% endif %} value="{{ field.value }}">
                  {% endif %}
                {% endif %}
                {{ s.foot(name, setting, field) }}
              </div>
            {% endif %}
          {% endfor %}
        </div>

        <div class="d-flex flex-wrap align-items-center gap-2 border-top pt-3 mt-4">
          <button class="btn btn-primary" type="submit"><i class="bi bi-check-lg me-1" aria-hidden="true"></i>Save changes</button>
          {% if overridden is not empty %}
            <button class="btn btn-outline-secondary" type="submit" formaction="{{ path('admin_settings_reset', {group: key}) }}" formnovalidate data-confirm="Reset every {{ group.label|lower }} override to .env or its default?"><i class="bi bi-arrow-counterclockwise me-1" aria-hidden="true"></i>Reset section</button>
            <span class="small text-body-secondary ms-sm-auto">{{ overridden|length }} {{ overridden|length == 1 ? 'setting' : 'settings' }} set here</span>
          {% endif %}
        </div>
      </form>
    </div>
  {% endfor %}
</div>
{% endblock %}
