{# The form that starts a connection to the mail service (Admin\DeliveryConnectionController::connect).
   `form` is a MailServiceType view; `label` the button's text; `obstacle` why it cannot be used, if so. #}
{{ form_start(form, {action: path('admin_delivery_connect'), attr: {class: 'app-narrow ms-0'}}) }}
  {{ form_errors(form) }}
  {{ form_row(form.service) }}
  <button class="btn-solid theme-primary" type="submit"{{ obstacle ? ' disabled' }}><i class="bi bi-plug me-1" aria-hidden="true"></i>{{ label|default('Connect') }}</button>
{{ form_end(form) }}
