{% extends 'base.html.twig' %}

{% block title %}Edit list {{ list.l_shortcode }}{% endblock %}

{% block content %}
<nav aria-label="breadcrumb"><ol class="breadcrumb small mb-5"><li class="breadcrumb-item"><a class="breadcrumb-link" href="{{ path('admin_lists') }}">Lists</a></li><li class="breadcrumb-divider"></li><li class="breadcrumb-item"><span class="breadcrumb-link active" aria-current="page">{{ list.l_shortcode }}</span></li></ol></nav>
{% include 'layout/_page_header.html.twig' with {title: 'Edit list ' ~ list.l_shortcode, description: 'The shortcode is permanent: it appears in links and mail headers.'} %}
<div class="app-narrow">
  {{ form_start(form, {attr: {class: 'card'}}) }}
    <div class="card-body">
      {{ form_errors(form) }}
      <div class="mb-5">
        <span class="form-label d-block">Shortcode</span>
        <code class="fs-md">{{ list.l_shortcode }}</code>
      </div>
      {{ form_row(form.name) }}
      {{ form_row(form.description, {row_attr: {class: 'mb-0'}}) }}
    </div>
    <div class="card-footer d-flex gap-3">
      <button class="btn-solid theme-primary" type="submit"><i class="bi bi-check-lg me-1" aria-hidden="true"></i>Save list</button>
      <a class="btn-outline theme-secondary" href="{{ path('admin_lists') }}">Cancel</a>
    </div>
  {{ form_end(form) }}
</div>
{% endblock %}
