{% extends 'base.html.twig' %}

{% block title %}Webhook events{% endblock %}

{% block content %}
{% embed 'layout/_page_header.html.twig' with {title: 'Webhook events', description: 'Signed events received from catto-mail, de-duplicated by event id and processed after the acknowledgement. Unknown event types are kept and ignored; the raw bodies stay in the database.'} %}
  {% block actions %}<a class="btn btn-outline-secondary" href="{{ path('admin_delivery') }}"><i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Integration</a>{% endblock %}
{% endembed %}

<form class="card card-body bg-body-tertiary mb-3" method="get" action="{{ path('admin_delivery_webhooks') }}" role="search">
  <div class="row g-2 align-items-end">
    <div class="col-sm-6 col-md-4">
      <label class="form-label small" for="webhook-filter">Show</label>
      <select class="form-select" id="webhook-filter" name="f">
        {% for value, label in filters %}<option value="{{ value }}"{{ value == filter ? ' selected' }}>{{ label }}</option>{% endfor %}
      </select>
    </div>
    <div class="col-auto d-flex gap-2">
      <button class="btn btn-primary" type="submit"><i class="bi bi-search me-1" aria-hidden="true"></i>Search</button>
      <a class="btn btn-outline-secondary" href="{{ path('admin_delivery_webhooks') }}">Clear</a>
    </div>
  </div>
</form>

{% if events is empty %}
  {% include 'layout/_empty_state.html.twig' with {icon: 'broadcast', message: 'No webhook events.', hint: filter ? 'Try showing all events.' : 'Events appear once catto-mail can reach this site\'s webhook endpoint.'} %}
{% else %}
  <div class="table-responsive">
    <table class="table table-hover align-middle">
      <thead class="table-light"><tr><th scope="col">Type</th><th scope="col">Event id</th><th scope="col">Received</th><th scope="col">Processed</th><th scope="col">Outcome</th><th scope="col">Related</th></tr></thead>
      <tbody>
      {% for event in events %}
        <tr>
          <td><code>{{ event.cwe_type }}</code></td>
          <td class="small text-break">{{ event.cwe_event_id }}</td>
          <td class="small text-nowrap">{{ event.cwe_received_at|slice(0, 16) }}</td>
          <td class="small text-nowrap">{{ event.cwe_processed_at ? event.cwe_processed_at|slice(0, 16) : '—' }}</td>
          <td class="small text-break">
            {% if event.cwe_processed_at %}
              {% if event.cwe_outcome starts with 'failed:' %}<span class="badge text-bg-danger">failed</span> {{ event.cwe_outcome|slice(7, 150) }}
              {% elseif event.cwe_outcome starts with 'ignored' %}<span class="badge text-bg-secondary">ignored</span> {{ event.cwe_outcome|slice(0, 150) }}
              {% else %}{{ event.cwe_outcome }}{% endif %}
            {% else %}
              <span class="badge text-bg-warning">pending</span>{% if event.cwe_attempts %} {{ event.cwe_attempts }} attempt{{ event.cwe_attempts == 1 ? '' : 's' }}{% endif %}{% if event.cwe_error %}: {{ event.cwe_error|slice(0, 150) }}{% endif %}
            {% endif %}
          </td>
          <td class="small text-nowrap">
            {% if event.send_job_id %}<a href="{{ path('admin_delivery_job', {id: event.send_job_id}) }}">Send job {{ event.send_job_id }}</a>
            {% elseif event.validation_job_id and is_granted('subscribers.manage') %}<a href="{{ path('admin_validation_job', {id: event.validation_job_id}) }}">Validation job {{ event.validation_job_id }}</a>
            {% else %}—{% endif %}
          </td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
  {% include '_pagination.html.twig' with {base: path('admin_delivery_webhooks'), query: filter ? '?f=' ~ filter|url_encode : ''} %}
{% endif %}
{% endblock %}
