{% extends 'base.html.twig' %}

{% block title %}Webhook events{% endblock %}

{% block content %}
{% import 'layout/_htmx.html.twig' as hx %}
{% embed 'layout/_page_header.html.twig' with {title: 'Webhook events', description: 'Signed events received from catto-mail, de-duplicated by event id and processed after the acknowledgement. Unknown event types are kept and ignored. Raw bodies are never shown here; they are kept in the database until processed and then for the retention period.'} %}
  {% block actions %}<a class="btn-outline theme-secondary" href="{{ path('admin_delivery') }}"><i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Integration</a>{% endblock %}
{% endembed %}

<form class="card card-body bg-1 mb-5" method="get" action="{{ path('admin_delivery_webhooks') }}" role="search" aria-label="Filter webhook events" {{ hx.search(path('admin_delivery_webhooks'), 'webhook-events') }}>
  <div class="row g-3 align-items-end">
    <div class="sm:col-6 md:col-4">
      <label class="form-label small" for="webhook-filter">Show</label>
      {% if related %}<input type="hidden" name="j" value="{{ related }}">{% endif %}
      <select class="form-control" id="webhook-filter" name="f">
        {% for value, label in filters %}<option value="{{ value }}"{{ value == filter ? ' selected' }}>{{ label }}</option>{% endfor %}
      </select>
    </div>
    <div class="col-auto d-flex align-items-center gap-3">
      <noscript><button class="btn-solid theme-primary" type="submit"><i class="bi bi-search me-1" aria-hidden="true"></i>Search</button></noscript>
      <a class="btn-outline theme-secondary" href="{{ path('admin_delivery_webhooks') }}">Clear</a>
      <span class="small fg-2 htmx-indicator" role="status">Loading…</span>
    </div>
  </div>
</form>

{% include 'admin/_delivery_webhooks.html.twig' %}
{% endblock %}
