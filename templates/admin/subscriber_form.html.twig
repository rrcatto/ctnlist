{% extends 'base.html.twig' %}
{% import 'admin/_macros.html.twig' as ui %}

{% macro options(choices, current, blank) %}
  <option value=""{{ current is empty ? ' selected' }}>{{ blank }}</option>
  {% for choice in choices %}<option value="{{ choice }}"{{ choice == current ? ' selected' }}>{{ choice }}</option>{% endfor %}
{% endmacro %}

{% block title %}Subscriber{% endblock %}

{% block content %}
{% import _self as form %}
{% embed 'layout/_page_header.html.twig' with {title: 'Subscriber', description: profile.s_email} %}
  {% block actions %}
    {% if is_granted('subscribers.view') %}<a class="btn btn-outline-secondary" href="{{ path('admin_subscribers') }}"><i class="bi bi-arrow-left me-1" aria-hidden="true"></i>All subscribers</a>{% endif %}
  {% endblock %}
{% endembed %}

<form action="{{ path('admin_subscriber_save') }}" method="post">
  <input type="hidden" name="csrf" value="{{ csrf_token('ctnlist') }}">
  <input type="hidden" name="subscriber_token" value="{{ token }}">
  <input type="hidden" name="muid" value="{{ muid }}">
  <div class="row g-4">
    <div class="col-lg-7">
      <div class="card h-100">
        <div class="card-header fw-semibold">Profile</div>
        <div class="card-body">
          <div class="row g-3">
            <div class="col-12"><label class="form-label" for="s-email">Email</label><input class="form-control" id="s-email" type="email" value="{{ profile.s_email }}" readonly aria-describedby="s-email-help"><div class="form-text" id="s-email-help">The email address identifies the subscriber and cannot be changed here.</div></div>
            <div class="col-md-6"><label class="form-label" for="s-fname">First name</label><input class="form-control" id="s-fname" name="s_fname" value="{{ profile.s_fname }}"></div>
            <div class="col-md-6"><label class="form-label" for="s-lname">Last name</label><input class="form-control" id="s-lname" name="s_lname" value="{{ profile.s_lname }}"></div>
            <div class="col-md-4"><label class="form-label" for="s-gender">Gender</label><select class="form-select" id="s-gender" name="s_gender">{{ form.options(genders, profile.s_gender, '') }}</select></div>
            <div class="col-md-4"><label class="form-label" for="s-province">Province</label><select class="form-select" id="s-province" name="s_province">{{ form.options(provinces, profile.s_province, 'Select Province') }}</select></div>
            <div class="col-md-4"><label class="form-label" for="s-country">Country</label><select class="form-select" id="s-country" name="s_country">{{ form.options(countries, profile.s_country, 'Select Country') }}</select></div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-lg-5">
      <div class="card mb-4">
        <div class="card-header fw-semibold">List memberships</div>
        <ul class="list-group list-group-flush">
          {% for membership in memberships %}
            <li class="list-group-item d-flex justify-content-between align-items-center gap-2">
              <span>{{ membership.l_name }} <code class="small">{{ membership.l_shortcode }}</code></span>
              {{ ui.membership_badge(ui.membership_state(membership)) }}
            </li>
          {% else %}
            <li class="list-group-item text-body-secondary">There are no active lists.</li>
          {% endfor %}
        </ul>
        <div class="card-footer small text-body-secondary">Only the subscriber can confirm a membership; adding a list sends an invitation.</div>
      </div>

      {% if administrator %}
        <div class="card">
          <div class="card-header fw-semibold">Administration</div>
          <div class="card-body">
            <div class="mb-3">
              <label class="form-label" for="list_id">Add to list</label>
              {% include 'admin/_list_select.html.twig' with {name: 'list_id', selected: (lists|first).l_id ?? 0} %}
              <div class="form-text">Saving adds a pending membership (if there is none yet) and sends the invitation to confirm.</div>
            </div>
            <div>
              <label class="form-label" for="s-priority">Priority</label>
              <input class="form-control" id="s-priority" type="number" name="s_priority" value="{{ priority }}">
              <div class="form-text">Saving sets the priority to this value plus 100 (the v5 engagement rule).</div>
            </div>
          </div>
        </div>
      {% endif %}
    </div>
  </div>

  <div class="d-flex flex-wrap gap-2 border-top pt-3 mt-4">
    <button class="btn btn-primary" type="submit"><i class="bi bi-check-lg me-1" aria-hidden="true"></i>Save subscriber</button>
  </div>
</form>
{% endblock %}
