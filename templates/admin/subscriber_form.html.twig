{% extends 'base.html.twig' %}

{#
  The subscriber page (Admin\SubscriberController::subscriberPage()) for administrators or the
  subscriber themselves. The address is the identity and is not edited. The profile form (SubscriberType)
  is the left column; each card on the right has forms of its own and is an htmx region, drawn again
  by its buttons: list memberships (only the subscriber confirms; administrators invite to a list),
  roles (holders of roles.manage) and delivery.
#}
{% block title %}Subscriber{% endblock %}

{% block content %}
{% embed 'layout/_page_header.html.twig' with {title: 'Subscriber', description: email} %}
  {% block actions %}
    {% if is_granted('subscribers.view') %}<a class="btn-outline theme-secondary" href="{{ path('admin_subscribers') }}"><i class="bi bi-arrow-left me-1" aria-hidden="true"></i>All subscribers</a>{% endif %}
  {% endblock %}
{% endembed %}

<div class="row g-7">
  <div class="lg:col-7">
    {{ form_start(form) }}
      {% if not form.vars.valid %}
        <div class="alert theme-danger" role="alert"><div>{% if form.vars.errors|length %}{{ form_errors(form) }}{% else %}Please correct the fields marked below; nothing was saved.{% endif %}</div></div>
      {% endif %}
      <div class="card">
        <div class="card-header fw-semibold">Profile</div>
        <div class="card-body">
          <div class="row g-5">
            <div class="col-12">
              <span class="form-label d-block">Email</span>
              <span class="fw-semibold text-break">{{ email }}</span>
              <div class="form-text">The email address identifies the subscriber and cannot be changed here.</div>
            </div>
            <div class="md:col-6">{{ form_row(form.firstName, {row_attr: {class: 'mb-0'}}) }}</div>
            <div class="md:col-6">{{ form_row(form.lastName, {row_attr: {class: 'mb-0'}}) }}</div>
            <div class="md:col-4">{{ form_row(form.gender, {row_attr: {class: 'mb-0'}}) }}</div>
            <div class="md:col-4">{{ form_row(form.province, {row_attr: {class: 'mb-0'}}) }}</div>
            <div class="md:col-4">{{ form_row(form.country, {row_attr: {class: 'mb-0'}}) }}</div>
            {% if form.priority is defined %}
              <div class="md:col-6">{{ form_row(form.priority, {row_attr: {class: 'mb-0'}}) }}</div>
            {% endif %}
          </div>
        </div>
        <div class="card-footer">
          <button class="btn-solid theme-primary" type="submit"><i class="bi bi-check-lg me-1" aria-hidden="true"></i>Save subscriber</button>
        </div>
      </div>
    {{ form_end(form) }}
  </div>

  <div class="lg:col-5 d-flex flex-column gap-7">
    {% include 'admin/_subscriber_lists.html.twig' %}
    {% if roles is not null %}{% include 'admin/_subscriber_roles.html.twig' %}{% endif %}
    {% include 'admin/_subscriber_delivery.html.twig' %}
  </div>
</div>
{% endblock %}
