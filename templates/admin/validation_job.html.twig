{% extends 'base.html.twig' %}

{% block title %}Validation job{% endblock %}

{% block content %}
{% import 'layout/_htmx.html.twig' as hx %}
{% embed 'layout/_page_header.html.twig' with {title: job.cvj_scope ?: 'Validation job ' ~ job.cvj_id, description: 'Results as catto-mail classified them. “unknown” and “temporarily unverifiable” are not invalid; a suggestion is only a suggestion.'} %}
  {% block actions %}
    <a class="btn-outline theme-secondary" href="{{ path('admin_validation') }}"><i class="bi bi-arrow-left me-1" aria-hidden="true"></i>All jobs</a>
  {% endblock %}
{% endembed %}

{% set base = path('admin_validation_job', {id: job.cvj_id}) %}
<form method="get" action="{{ base }}" class="card card-body bg-1 mb-5" role="search" aria-label="Filter results" {{ hx.search(base, 'validation-job') }}>
  <div class="d-flex flex-wrap gap-3 align-items-end">
    <div>
      <label class="form-label small" for="v-class">Classification</label>
      <select class="form-control form-control-sm" id="v-class" name="c">
        <option value="">All</option>
        {% for c in classifications|merge(['pending']) %}<option value="{{ c }}"{{ class == c ? ' selected' }}>{{ c|replace({'_': ' '}) }}{{ (job.cvj_counts[c] ?? null) is not null ? ' (' ~ job.cvj_counts[c] ~ ')' }}</option>{% endfor %}
      </select>
    </div>
    <noscript><button class="btn-sm btn-solid theme-primary" type="submit">Filter</button></noscript>
    {% if class %}<a class="btn-sm btn-outline theme-secondary" href="{{ base }}">Clear</a>{% endif %}
    <span class="small fg-2 htmx-indicator" role="status">Loading…</span>
  </div>
</form>

{% include 'admin/_validation_job.html.twig' %}
{% endblock %}
