{% extends 'base.html.twig' %}

{% block title %}Queue{% endblock %}

{% block content %}
{% embed 'layout/_page_header.html.twig' with {title: 'Delivery queue', description: 'Messages waiting to be sent, in sending order. Nothing is sent until sending is started.'} %}
  {% block actions %}
    {% if rows is not empty %}
      <a class="btn btn-success" href="{{ path('admin_queue_process') }}"><i class="bi bi-send me-1" aria-hidden="true"></i>Start sending</a>
    {% endif %}
    <a class="btn btn-outline-secondary" href="{{ path('admin_queue_stop') }}"><i class="bi bi-pause-circle me-1" aria-hidden="true"></i>Stop sending</a>
    {% if is_granted('messages.queue') %}<a class="btn btn-outline-secondary" href="{{ path('admin_queue_rotation') }}">Queue multiple messages</a>{% endif %}
  {% endblock %}
{% endembed %}

{% if rows is empty %}
  {% include 'layout/_empty_state.html.twig' with {icon: 'send', message: 'There is nothing in the queue.', hint: 'Queue a message from the message list to add its audience.'} %}
{% else %}
  {% set can_edit_subscribers = is_granted('subscribers.manage') %}
  <div class="table-responsive">
    <table class="table table-hover align-middle">
      <thead class="table-light">
        <tr>
          <th scope="col">Message</th>
          <th scope="col">Subscriber</th>
          <th scope="col">List</th>
          <th scope="col">Added</th>
          <th scope="col">Last interaction</th>
          <th scope="col" class="text-end" title="Message priority : subscriber priority">MP:SP</th>
          <th scope="col" class="text-end"><span class="visually-hidden">Actions</span></th>
        </tr>
      </thead>
      <tbody>
      {% for row in rows %}
        <tr>
          <td><a href="{{ path('admin_message', {muid: row.q_muid}) }}" title="{{ row.q_subject }}">{{ row.q_subject|length > 80 ? row.q_subject|slice(0, 80) ~ '…' : row.q_subject }}</a></td>
          <td>{% if can_edit_subscribers %}<a href="{{ path('admin_subscriber', {token: row.q_s_uuid}) }}">{{ row.q_email }}</a>{% else %}{{ row.q_email }}{% endif %}</td>
          <td><code>{{ row.q_list_shortcode }}</code></td>
          <td class="text-nowrap">{{ row.q_date_added }}</td>
          <td class="text-nowrap">{{ row.q_last_interacted ?: '–' }}</td>
          <td class="text-end">{{ row.q_mpriority }}:{{ row.q_spriority }}</td>
          <td class="text-end">
            <form method="post" action="{{ path('admin_queue_delete') }}">
              <input type="hidden" name="csrf" value="{{ csrf_token('ctnlist') }}">
              <input type="hidden" name="queue_id" value="{{ row.q_id }}">
              <button class="btn btn-sm btn-outline-danger" type="submit" aria-label="Remove {{ row.q_email }} from the queue"><i class="bi bi-x-lg" aria-hidden="true"></i><span class="d-none d-md-inline ms-1">Remove</span></button>
            </form>
          </td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
  {% include '_pagination.html.twig' with {base: path('admin_queue')} %}

  <div class="card border-danger-subtle mt-4">
    <div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-3">
      <div>
        <h2 class="h6 mb-1">Clear the queue</h2>
        <p class="small text-body-secondary mb-0">Removes all {{ pagination.total }} queued entries. Messages can be queued again afterwards.</p>
      </div>
      <form method="post" action="{{ path('admin_queue_clear') }}" data-confirm="Clear the entire queue?">
        <input type="hidden" name="csrf" value="{{ csrf_token('ctnlist') }}">
        <button class="btn btn-outline-danger" type="submit"><i class="bi bi-trash me-1" aria-hidden="true"></i>Clear queue</button>
      </form>
    </div>
  </div>
{% endif %}
{% endblock %}
