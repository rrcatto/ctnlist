{% extends 'base.html.twig' %}

{% block title %}Queue{% endblock %}

{% block content %}
{% embed 'layout/_page_header.html.twig' with {title: 'Delivery queue', description: 'Messages waiting to be sent, in sending order. Nothing is sent until sending is started.'} %}
  {% block actions %}
    {% if rows is not empty %}
      <a class="btn-solid theme-success" href="{{ path('admin_queue_process') }}"><i class="bi bi-send me-1" aria-hidden="true"></i>Start sending</a>
    {% endif %}
    <a class="btn-outline theme-secondary" href="{{ path('admin_queue_stop') }}"><i class="bi bi-pause-circle me-1" aria-hidden="true"></i>Stop sending</a>
    {% if is_granted('messages.queue') %}<a class="btn-outline theme-secondary" href="{{ path('admin_queue_rotation') }}">Queue multiple messages</a>{% endif %}
  {% endblock %}
{% endembed %}

{% include 'admin/_queue_entries.html.twig' %}
{% endblock %}
