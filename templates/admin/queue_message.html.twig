{% extends 'base.html.twig' %}

{% block title %}Queue message{% endblock %}

{% block content %}
<form method="post" action="{{ path('admin_queue_message_submit') }}" class="card card-body">
  <input type="hidden" name="csrf" value="{{ csrf_token('ctnlist') }}">
  <input type="hidden" name="muid" value="{{ muid }}">
  <label class="form-label" for="q-limit">Maximum subscribers to add in this operation</label>
  <input class="form-control mb-3" id="q-limit" type="number" name="limit" value="{{ limit }}">
  <button class="btn btn-primary">Queue this message</button>
</form>
{% endblock %}
