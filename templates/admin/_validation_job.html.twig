{#
  A validation job's state, its actions and its results (Admin\AddressValidationController::show()):
  the page includes it, and it is the htmx region validation-job, drawn again by the filter, the
  pager and the actions, and every 15 seconds until the results are in.
#}
{% import 'admin/_cattomail_macros.html.twig' as cm %}
{% import 'layout/_htmx.html.twig' as hx %}
{% set here = path('admin_validation_job', {id: job.cvj_id, page: pagination.page}) ~ (class ? '?c=' ~ class : '') %}
{% set working = job.cvj_status in ['pending', 'queued', 'processing'] or (job.cvj_status == 'completed' and not job.cvj_results_complete) %}
<div id="validation-job" class="app-region"{% if working %} {{ hx.refresh(here, 'validation-job', '15s') }}{% endif %}>
<div class="d-flex flex-wrap align-items-center gap-3 mb-1">
  <p class="mb-0">{{ cm.job_status(job.cvj_status) }} <span class="small fg-2 ms-3">{{ job.cvj_processed }} of {{ job.cvj_total }} addresses processed{{ job.cvj_results_complete ? ' · results stored' }}</span></p>
  <div class="d-flex flex-wrap gap-3 ms-auto">
    {% if job.cvj_status == 'pending' %}
      <form method="post" action="{{ path('admin_validation_submit', {id: job.cvj_id}) }}" data-confirm="Submit this job to catto-mail now? Its stored key makes sure it is created only once." {{ hx.post(path('admin_validation_submit', {id: job.cvj_id}), 'validation-job') }}>
        <input type="hidden" name="csrf" value="{{ csrf_token('ctnlist') }}">
        <button class="btn-sm btn-outline theme-primary" type="submit"><i class="bi bi-send me-1" aria-hidden="true"></i>Retry submission</button>
      </form>
    {% endif %}
    <form method="post" action="{{ path('admin_validation_refresh', {id: job.cvj_id}) }}" {{ hx.post(path('admin_validation_refresh', {id: job.cvj_id}), 'validation-job') }}>
      <input type="hidden" name="csrf" value="{{ csrf_token('ctnlist') }}">
      <button class="btn-sm btn-outline theme-secondary" type="submit"><i class="bi bi-arrow-repeat me-1" aria-hidden="true"></i>Ask catto-mail now</button>
    </form>
  </div>
</div>
{% if working %}<p class="small fg-2 mb-1">This page updates itself every 15 seconds until the results are in.</p>{% endif %}
<p class="small fg-2">Submitted {{ job.cvj_created_at|slice(0, 16) }}{{ job.cvj_last_checked_at ? ' · last checked ' ~ job.cvj_last_checked_at|slice(0, 16) }}{{ job.cvj_completed_at ? ' · completed ' ~ job.cvj_completed_at|slice(0, 16) }}</p>
{% if job.cvj_counts %}
  <p class="small mb-3">{% for c in classifications %}<span class="me-5 text-nowrap">{{ cm.classification(c) }} {{ job.cvj_counts[c] ?? 0 }}</span>{% endfor %}</p>
{% endif %}
{% if job.cvj_detail_pruned_at %}<p class="small fg-2"><i class="bi bi-scissors me-1" aria-hidden="true"></i>Results superseded by a newer validation of the same subscriber were removed {{ job.cvj_detail_pruned_at|slice(0, 10) }} (retention); the counts above are this job's original counts.</p>{% endif %}
{% if job.cvj_remote_id and is_granted('logs.view') %}<p class="small"><a href="{{ path('admin_delivery_webhooks', {j: job.cvj_remote_id}) }}">Webhook events for this job</a></p>{% endif %}
{% if suggestions %}<p class="small"><i class="bi bi-lightbulb me-1" aria-hidden="true"></i>{{ suggestions }} suggested correction{{ suggestions == 1 ? '' : 's' }} (shown in the table; never applied: only the subscriber can change their address).</p>{% endif %}
{% if job.cvj_error %}<div class="alert theme-danger small text-break" role="alert"><div>{{ job.cvj_error }}</div></div>{% endif %}

{% if results is empty %}
  {% include 'layout/_empty_state.html.twig' with {icon: 'patch-question', message: 'No results to show.', hint: job.cvj_status in ['queued', 'processing', 'pending'] ? 'catto-mail is still working on this job.' : null} %}
{% else %}
  <div class="table-responsive">
    <table class="table table-hover align-middle">
      <thead class=""><tr><th scope="col">Address</th><th scope="col">Classification</th><th scope="col">Checks</th><th scope="col">Suggestion</th><th scope="col">Diagnostic</th></tr></thead>
      <tbody>
      {% for r in results %}
        <tr>
          <td class="text-break">{% if r.s_id and is_granted('subscribers.manage') %}<a href="{{ path('admin_subscriber', {token: r.cva_s_uuid}) }}">{{ r.cva_address }}</a>{% else %}{{ r.cva_address }}{% endif %}</td>
          <td>{{ cm.classification(r.cva_classification) }}{% if r.cva_confidence %}<div class="small fg-2">{{ r.cva_confidence }} confidence</div>{% endif %}</td>
          <td class="small text-nowrap">
            {% if r.cva_syntax_status %}syntax {{ r.cva_syntax_status }}<br>{% endif %}
            {% if r.cva_domain_status %}domain {{ r.cva_domain_status|replace({'_': ' '}) }}<br>{% endif %}
            {% if r.cva_smtp_status %}SMTP {{ r.cva_smtp_status|replace({'_': ' '}) }}{% endif %}
            {% for flag, label in {cva_is_role: 'role', cva_is_disposable: 'disposable', cva_is_catch_all: 'accept-all', cva_is_typo_suspected: 'typo?'} %}{% if r[flag] %}<span class="badge badge-subtle theme-secondary ms-1">{{ label }}</span>{% endif %}{% endfor %}
          </td>
          <td class="small text-break">{% if r.cva_suggested_address %}<span title="Suggestion only; never applied">{{ r.cva_suggested_address }}</span><div class="fg-2">suggestion only{{ r.cva_suggestion_confidence ? ', ' ~ r.cva_suggestion_confidence ~ ' confidence' }}</div>{% endif %}</td>
          <td class="small text-break">{% if r.cva_diagnostic_code %}<code>{{ r.cva_diagnostic_code }}</code>{% endif %}{% if r.cva_diagnostic_text %}<div class="fg-2">{{ r.cva_diagnostic_text|slice(0, 160) }}</div>{% endif %}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
  {% include '_pagination.html.twig' with {base: path('admin_validation_job', {id: job.cvj_id}), query: class ? '?c=' ~ class : '', region: 'validation-job'} %}
{% endif %}
</div>
