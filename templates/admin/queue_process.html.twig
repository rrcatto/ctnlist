{% extends 'base.html.twig' %}

{% block title %}Process queue{% endblock %}

{% block content %}
{% include 'layout/_page_header.html.twig' with {title: 'Start sending', description: muid ? 'Sends this message’s queued entries now, in queue order.' : 'Sends queued messages now, in queue order.'} %}

<form method="post" action="{{ path('admin_queue_process_submit') }}" class="card app-narrow ms-0">
  <div class="card-body">
    <input type="hidden" name="csrf" value="{{ csrf_token('ctnlist') }}">
    <input type="hidden" name="muid" value="{{ muid }}">
    <div class="alert alert-warning small" role="note"><i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i>This delivers email to subscribers. Sending continues until the limit is reached, the queue is empty or sending is stopped.</div>
    <label class="form-label" for="p-limit">Maximum messages to send</label>
    <input class="form-control" id="p-limit" type="number" min="0" name="limit" value="{{ limit }}">
  </div>
  <div class="card-footer d-flex flex-wrap gap-2">
    <button class="btn btn-success" type="submit"><i class="bi bi-send me-1" aria-hidden="true"></i>Start sending</button>
    <a class="btn btn-outline-secondary" href="{{ path('admin_queue') }}">Cancel</a>
  </div>
</form>
{% endblock %}
