{% extends 'base.html.twig' %}

{% block title %}{{ message.m_uniqid ? 'Edit message' : 'Create message' }}{% endblock %}

{% block content %}
<form action="{{ path('admin_message_save') }}" method="post">
  <input type="hidden" name="csrf" value="{{ csrf_token('ctnlist') }}">
  <input type="hidden" name="m_uniqid" value="{{ message.m_uniqid }}">
  <fieldset class="border rounded p-4">
    <legend>{{ message.m_uniqid ? 'Edit Message' : 'Create Message' }}</legend>
    <div class="row g-3">
      <div class="col-md-6">
        <label class="form-label" for="m-template">Template</label>
        <select class="form-select" id="m-template" name="m_t_id">
          <option value="0"{{ message.m_t_id == 0 ? ' selected' }}>none</option>
          {% for template in templates %}
            <option value="{{ template.t_id }}"{{ template.t_id == message.m_t_id ? ' selected' }}>{{ template.t_name }}</option>
          {% endfor %}
        </select>
      </div>
      <div class="col-md-6"><label class="form-label" for="m-from-name">From name</label><input class="form-control" id="m-from-name" name="m_from_name" value="{{ message.m_from_name }}"></div>
      <div class="col-md-6"><label class="form-label" for="m-from-address">From address</label><input class="form-control" id="m-from-address" type="text" name="m_from_address" value="{{ message.m_from_address }}"></div>
      <div class="col-md-3"><label class="form-label" for="m-priority">Priority</label><input class="form-control" id="m-priority" type="number" name="m_priority" value="{{ message.m_priority }}"></div>
      <div class="col-md-3"><label class="form-label" for="m-max-send">Maximum sends</label><input class="form-control" id="m-max-send" type="number" name="m_max_send" value="{{ message.m_max_send }}"></div>
      <div class="col-12">
        <label class="form-label">Send to lists</label>
        <div class="row g-2">
          {% for list in lists %}
            <div class="col-md-6"><div class="form-check border rounded p-3 ps-5">
              <input class="form-check-input" type="checkbox" name="list_ids[]" value="{{ list.l_id }}" id="message-list-{{ list.l_id }}"{{ list.l_id in selected ? ' checked' }}>
              <label class="form-check-label" for="message-list-{{ list.l_id }}"><strong>{{ list.l_name }}</strong> – {{ list.l_description }}</label>
            </div></div>
          {% endfor %}
        </div>
        <div class="form-text">A message may be saved with no list selected and assigned to one or more lists later.</div>
      </div>
      <div class="col-12"><label class="form-label" for="m-subject">Subject</label><input class="form-control" id="m-subject" name="m_subject" value="{{ message.m_subject }}"></div>
      <div class="col-12"><label class="form-label" for="mt_html">HTML part</label><textarea class="form-control" id="mt_html" name="mt_html" style="width:100%;min-height:500px">{{ message.m_html }}</textarea></div>
      <div class="col-12"><label class="form-label" for="m-text">Text part</label><textarea class="form-control" id="m-text" name="m_text" rows="15">{{ message.m_text }}</textarea></div>
      <div class="col-12"><button class="btn btn-primary" type="submit">Save Message</button></div>
    </div>
  </fieldset>
</form>
{% endblock %}
