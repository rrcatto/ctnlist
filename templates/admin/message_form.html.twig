{% extends 'admin/_editor_page.html.twig' %}

{#
  Message editor (MessageType). Only the subject is required. Invalid input
  shows the editor again with everything entered kept, including the HTML and
  text parts. Saving never sends; Proof, Queue and Activity are separate
  actions, and they refuse a blank message.
#}
{% block title %}{{ muid ? 'Edit message' : 'Create message' }}{% endblock %}

{% block content %}
{% embed 'layout/_page_header.html.twig' with {title: muid ? 'Edit message' : 'Create message', description: 'A message needs a subject. It can be saved as a draft without content or lists, which can be added later.'} %}
  {% block actions %}
    {% if muid %}
      <a class="btn-outline theme-secondary" href="{{ path('admin_proof', {muid: muid}) }}"><i class="bi bi-envelope-check me-1" aria-hidden="true"></i>Send proof</a>
      {% if is_granted('messages.queue') %}<a class="btn-outline theme-primary" href="{{ path('admin_queue_message', {muid: muid}) }}"><i class="bi bi-list-check me-1" aria-hidden="true"></i>Queue</a>{% endif %}
      {% if is_granted('logs.view') %}<a class="btn-outline theme-secondary" href="{{ path('report_message_views', {muid: muid}) }}"><i class="bi bi-bar-chart me-1" aria-hidden="true"></i>Activity</a>{% endif %}
    {% endif %}
  {% endblock %}
{% endembed %}

{{ form_start(form) }}
  {% if not form.vars.valid %}
    <div class="alert theme-danger" role="alert">
      <div>{% if form.vars.errors|length %}{{ form_errors(form) }}{% else %}Please correct the fields marked below. Nothing was saved, and everything you entered is still here.{% endif %}</div>
    </div>
  {% endif %}
  {{ form_widget(form.muid) }}

  {# Who it is from, who it goes to and how much of it is sent; then the message itself, at the page's full width. #}
  <div class="row g-5 mb-5">
    <div class="md:col-6">{{ form_row(form.fromName, {row_attr: {class: 'mb-0'}}) }}</div>
    <div class="md:col-6">{{ form_row(form.fromAddress, {row_attr: {class: 'mb-0'}}) }}</div>
  </div>

  <div class="row g-5 mb-5">
    <div class="md:col-6">
      {#
        The lists, as a menu of checkboxes that stays open while lists are
        ticked. The toggle names the ticked lists (app.js keeps it current).
      #}
      {% set chosen = form.listIds.children|filter(choice => choice.vars.checked)|map(choice => choice.vars.label) %}
      <div class="form-field">
        <label class="form-label" id="message_listIds_label" for="message_listIds_toggle">{{ form.listIds.vars.label }}</label>
        <div class="position-relative">
          <button class="form-control form-control-caret text-start text-truncate{{ form.listIds.vars.valid ? '' : ' is-invalid' }}" type="button" id="message_listIds_toggle"
                  data-bs-toggle="menu" data-bs-auto-close="outside" data-bs-placement="bottom-start" aria-expanded="false"
                  aria-labelledby="message_listIds_label message_listIds_summary" aria-describedby="message_listIds_help">
            <span id="message_listIds_summary" data-checklist-summary>{{ chosen ? chosen|join(', ') : 'No lists selected' }}</span>
          </button>
          <div class="menu app-checklist" role="group" aria-labelledby="message_listIds_label" data-checklist data-checklist-empty="No lists selected">
            {% for choice in form.listIds %}
              {% set list = lists[choice.vars.value] ?? null %}
              {{ form_widget(choice, {label_attr: list and list.l_description ? {title: list.l_description} : {}}) }}
            {% else %}
              <span class="menu-text">There are no active lists.</span>
            {% endfor %}
          </div>
        </div>
        <div class="form-text" id="message_listIds_help">Confirmed members of the selected lists are queued once each. <code>ALL</code> is never selected automatically.</div>
        {{ form_errors(form.listIds) }}
        {% do form.listIds.setRendered %}
      </div>
    </div>
    <div class="col-6 md:col-3">{{ form_row(form.priority, {row_attr: {class: 'mb-0'}}) }}</div>
    <div class="col-6 md:col-3">{{ form_row(form.maxSend, {row_attr: {class: 'mb-0'}}) }}</div>
  </div>

  {{ form_row(form.subject) }}
  <div class="row g-5 mb-5">
    <div class="md:col-6 lg:col-4">{{ form_row(form.templateId, {row_attr: {class: 'mb-0'}}) }}</div>
  </div>
  {{ form_row(form.html) }}
  {{ form_row(form.text) }}

  <div class="d-flex flex-wrap gap-3 border-top pt-5 mt-7">
    <button class="btn-solid theme-primary" type="submit"><i class="bi bi-check-lg me-1" aria-hidden="true"></i>Save message</button>
    <a class="btn-outline theme-secondary" href="{{ path('admin_messages') }}">Cancel</a>
  </div>
{{ form_end(form) }}
{% endblock %}
