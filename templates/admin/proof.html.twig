{% extends 'base.html.twig' %}

{% block title %}Proof send{% endblock %}

{% block content %}
{% include 'layout/_page_header.html.twig' with {title: 'Send proof', description: 'A proof is a single copy for checking the message. It can go to any address, which does not need to be a subscriber. It is recorded in the Send Log as PROOF and does not affect the queue, subscribers or list memberships.'} %}

{{ form_start(form, {attr: {class: 'card app-narrow ms-0'}}) }}
  <div class="card-body">
    {% if not test_email_valid %}
      <div class="alert alert-warning small" role="note"><i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i>{{ test_email is empty ? 'MAIL_TEST_ADDRESS is not set' : 'MAIL_TEST_ADDRESS (' ~ test_email ~ ') is not a valid email address' }}; enter the address to send the proof to.</div>
    {% endif %}
    {{ form_errors(form) }}
    {{ form_row(form.email, {row_attr: {class: 'mb-0'}}) }}
  </div>
  <div class="card-footer d-flex flex-wrap gap-2">
    <button class="btn btn-primary" type="submit"><i class="bi bi-envelope-check me-1" aria-hidden="true"></i>Send proof</button>
    <a class="btn btn-outline-secondary" href="{{ path('admin_message', {muid: muid}) }}">Back to the message</a>
  </div>
{{ form_end(form) }}
{% endblock %}
