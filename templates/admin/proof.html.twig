{% extends 'base.html.twig' %}

{% block title %}Proof send{% endblock %}

{% block content %}
{% include 'layout/_page_header.html.twig' with {title: 'Send proof', description: 'A proof is a single copy for checking the message. It can go to any address, which does not need to be a subscriber. It is recorded in the Send Log as PROOF and does not affect the queue, subscribers or list memberships.'} %}

{{ form_start(form, {attr: {class: 'card app-narrow ms-0'}}) }}
  <div class="card-body">
    {% if not test_email_valid %}
      <div class="alert theme-warning small" role="note"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i><div>{{ test_email is empty ? 'MAIL_TEST_ADDRESS is not set' : 'MAIL_TEST_ADDRESS (' ~ test_email ~ ') is not a valid email address' }}; enter the address to send the proof to.</div></div>
    {% endif %}
    {% if mailpit_problem %}
      <div class="alert theme-danger small" role="alert"><i class="bi bi-exclamation-octagon" aria-hidden="true"></i><div>{{ mailpit_problem }} Proofs cannot be sent until it is corrected.</div></div>
    {% elseif mailpit %}
      <div class="alert theme-info small" role="note"><i class="bi bi-inbox" aria-hidden="true"></i><div>Proofs go to <strong>Mailpit</strong> ({{ mailpit }}), not through the mail service: read the proof on Mailpit's page. It is <strong>not delivered</strong> to the address below, which only appears as its recipient.</div></div>
    {% endif %}
    {{ form_errors(form) }}
    {{ form_row(form.email, {row_attr: {class: 'mb-0'}}) }}
  </div>
  <div class="card-footer d-flex flex-wrap gap-3">
    <button class="btn-solid theme-primary" type="submit"><i class="bi bi-envelope-check me-1" aria-hidden="true"></i>Send proof</button>
    <a class="btn-outline theme-secondary" href="{{ path('admin_message', {muid: muid}) }}">Back to the message</a>
  </div>
{{ form_end(form) }}
{% endblock %}
