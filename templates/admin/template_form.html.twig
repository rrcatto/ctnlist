{% extends 'admin/_editor_page.html.twig' %}

{# Template editor (TemplateType); invalid input shows the editor again with everything kept. #}
{% block title %}{{ template_id ? 'Edit template' : 'Create template' }}{% endblock %}

{% block content %}
{% include 'layout/_page_header.html.twig' with {title: template_id ? 'Edit template' : 'Create template', description: 'Put {content} where the message body belongs, in both the HTML and the text part.'} %}

{{ form_start(form) }}
  {% if not form.vars.valid %}
    <div class="alert alert-danger" role="alert">
      {% if form.vars.errors|length %}{{ form_errors(form) }}{% else %}Please correct the fields marked below. Nothing was saved, and everything you entered is still here.{% endif %}
    </div>
  {% endif %}
  <div class="col-lg-6">{{ form_row(form.name) }}</div>
  {{ form_row(form.html) }}
  {{ form_row(form.text) }}
  <div class="d-flex flex-wrap gap-2 border-top pt-3 mt-4">
    <button class="btn btn-primary" type="submit"><i class="bi bi-check-lg me-1" aria-hidden="true"></i>Save template</button>
    <a class="btn btn-outline-secondary" href="{{ path('admin_templates') }}">Cancel</a>
  </div>
{{ form_end(form) }}
{% endblock %}
