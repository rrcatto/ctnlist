{% extends 'base.html.twig' %}

{% block title %}Stop sending{% endblock %}

{% block content %}
{% include 'layout/_page_header.html.twig' with {title: 'Stop sending', description: 'Asks a running send to stop before its next message. Queued entries stay in the queue and can be sent later.'} %}

<form method="post" action="{{ path('admin_queue_stop_submit') }}" class="card app-narrow ms-0">
  <div class="card-body d-flex flex-row flex-wrap gap-3">
    <input type="hidden" name="csrf" value="{{ csrf_token('ctnlist') }}">
    <button class="btn-solid theme-warning" type="submit"><i class="bi bi-pause-circle me-1" aria-hidden="true"></i>Stop sending</button>
    <a class="btn-outline theme-secondary" href="{{ path('admin_queue') }}">Back to the queue</a>
  </div>
</form>
{% endblock %}
