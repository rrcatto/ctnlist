{% extends 'base.html.twig' %}

{% block title %}Messages{% endblock %}

{% block content %}
{% import 'layout/_htmx.html.twig' as hx %}
{% embed 'layout/_page_header.html.twig' with {title: 'Messages', description: 'Campaign messages, newest first. Send a proof to check a message, queue it to add its audience to the delivery queue, then start sending.'} %}
  {% block actions %}
    <a class="btn-solid theme-primary" href="{{ path('admin_message') }}"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>New message</a>
    {% if is_granted('messages.queue') %}<a class="btn-outline theme-secondary" href="{{ path('admin_queue_rotation') }}">Queue multiple messages</a>{% endif %}
  {% endblock %}
{% endembed %}

<form method="get" action="{{ path('admin_messages') }}" class="card card-body bg-1 mb-7" role="search" aria-label="Find a message" {{ hx.search(path('admin_messages'), 'message-results') }}>
  <div class="d-flex flex-wrap align-items-end gap-3">
    <div class="flex-grow-1"><label class="form-label" for="f-q">Subject contains</label><input class="form-control" id="f-q" type="search" name="q" value="{{ search }}" maxlength="200"></div>
    <noscript><button class="btn-solid theme-primary" type="submit"><i class="bi bi-search me-1" aria-hidden="true"></i>Search</button></noscript>
    {% if search %}<a class="btn-outline theme-secondary" href="{{ path('admin_messages') }}">Clear</a>{% endif %}
    <span class="small fg-2 htmx-indicator pb-3" role="status">Searching…</span>
  </div>
</form>

{% include 'admin/_message_results.html.twig' %}
{% endblock %}
