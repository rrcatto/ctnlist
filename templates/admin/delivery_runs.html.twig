{% extends 'base.html.twig' %}

{% block title %}Send runs{% endblock %}

{% block content %}
{% embed 'layout/_page_header.html.twig' with {title: 'Send runs', description: 'Every queue run, proof, resend and forward handed to catto-mail, newest first. One run can be several catto-mail jobs (one per list, at most 10,000 recipients each).'} %}
  {% block actions %}<a class="btn btn-outline-secondary" href="{{ path('admin_delivery') }}"><i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Integration</a>{% endblock %}
{% endembed %}

{% if runs is empty %}
  {% include 'layout/_empty_state.html.twig' with {icon: 'send', message: 'Nothing has been handed to catto-mail yet.'} %}
{% else %}
  {% include 'admin/_delivery_runs_table.html.twig' %}
  {% include '_pagination.html.twig' with {base: path('admin_delivery_runs')} %}
{% endif %}
{% endblock %}
