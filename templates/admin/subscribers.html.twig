{% extends 'base.html.twig' %}
{% import 'admin/_macros.html.twig' as ui %}

{% block title %}{{ active ? 'Active subscribers' : 'Subscribers' }}{% endblock %}

{% block content %}
{% set base = path(active ? 'admin_subscribers_active' : 'admin_subscribers') %}
{% embed 'layout/_page_header.html.twig' with {
  title: active ? 'Active readers' : 'Subscribers',
  description: active ? 'Subscribers who have interacted with a message, most recent first.' : 'Subscriber identities and their list memberships, most recently engaged first.'
} %}
  {% block actions %}
    {% if is_granted('subscribers.manage') %}
      <a class="btn-solid theme-primary" href="{{ path('admin_bulk_subscribe') }}"><i class="bi bi-person-plus me-1" aria-hidden="true"></i>Bulk subscribe</a>
      <a class="btn-outline theme-secondary" href="{{ path('admin_import') }}"><i class="bi bi-upload me-1" aria-hidden="true"></i>Import</a>
      <a class="btn-outline theme-secondary" href="{{ path('admin_export') }}" title="Writes export files to the installation's logs/ directory"><i class="bi bi-download me-1" aria-hidden="true"></i>Export</a>
    {% endif %}
  {% endblock %}
{% endembed %}

<form method="get" action="{{ base }}" class="card card-body bg-1 mb-7" role="search" aria-label="Filter subscribers">
  <div class="row g-5 align-items-end">
    <div class="md:col-4"><label class="form-label" for="f-e">Email address contains</label><input class="form-control" id="f-e" type="search" name="e" value="{{ filters.e }}"></div>
    <div class="md:col-3"><label class="form-label" for="l">List</label>{% include 'admin/_list_select.html.twig' with {name: 'l', selected: filters.l, blank: 'All lists'} %}</div>
    <div class="col-6 md:col-2"><label class="form-label" for="f-r">Rows per page</label><input class="form-control" id="f-r" type="number" min="1" max="200" name="r" value="{{ pagination.perPage }}"></div>
    <div class="col-6 md:col-3">
      <div class="form-field mb-3"><input class="check" type="checkbox" name="u" value="1" id="include-unsubscribed"{{ filters.u ? ' checked' }}><label for="include-unsubscribed">Include unsubscribed</label></div>
    </div>
    <div class="col-12 d-flex gap-3">
      <button class="btn-solid theme-primary" type="submit"><i class="bi bi-search me-1" aria-hidden="true"></i>Search</button>
      <a class="btn-outline theme-secondary" href="{{ base }}">Clear</a>
    </div>
  </div>
</form>

{% if rows is empty %}
  {% include 'layout/_empty_state.html.twig' with {icon: 'people', message: 'There are no matching subscribers.', hint: 'Try a different search, or include unsubscribed subscribers.'} %}
{% else %}
  {% set can_edit = is_granted('subscribers.manage') %}
  <div class="table-responsive">
    <table class="table table-hover align-middle">
      <thead class="">
        <tr>
          <th scope="col">Email</th>
          <th scope="col">Name</th>
          <th scope="col">Lists</th>
          <th scope="col" class="text-end">Priority</th>
          <th scope="col" class="text-end">Bounces</th>
          <th scope="col" class="text-end">Emails left</th>
          <th scope="col">Last interaction</th>
        </tr>
      </thead>
      <tbody>
      {% for row in rows %}
        <tr>
          <td>{% if can_edit %}<a href="{{ path('admin_subscriber', {token: row.s_uuid}) }}">{{ row.s_email }}</a>{% else %}{{ row.s_email }}{% endif %}</td>
          <td>{{ (row.s_fname ~ ' ' ~ row.s_lname)|trim }}</td>
          <td>
            {% for membership in row.memberships %}
              <span class="text-nowrap me-3">{{ membership.name }} {{ ui.membership_badge(membership.state) }}</span>
            {% else %}
              <span class="fg-2">–</span>
            {% endfor %}
          </td>
          <td class="text-end">{{ row.s_priority }}</td>
          <td class="text-end">{{ row.s_bounces }}</td>
          <td class="text-end">{{ row.s_emailsleft }}</td>
          <td class="text-nowrap">{{ row.s_last_interacted ?: '–' }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
  {% include '_pagination.html.twig' with {base: base, query: query} %}
{% endif %}
{% endblock %}
