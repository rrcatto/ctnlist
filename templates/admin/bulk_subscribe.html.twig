{% extends 'base.html.twig' %}

{% block title %}Bulk subscribe{% endblock %}

{% block content %}
<form action="{{ path('admin_bulk_subscribe_submit') }}" method="post">
  <input type="hidden" name="csrf" value="{{ csrf_token('ctnlist') }}">
  <fieldset class="border rounded p-4">
    <legend>Subscribe multiple emails</legend>
    <p>Addresses are added as pending members and invited to confirm.</p>
    <div class="mb-3"><label class="form-label" for="list_id">List</label>{% include 'admin/_list_select.html.twig' with {name: 'list_id', selected: (lists|first).l_id ?? 0} %}</div>
    <div class="mb-3"><label class="form-label" for="b-priority">Priority</label><input class="form-control" id="b-priority" type="number" name="s_priority" value="10"></div>
    <div class="mb-3"><label class="form-label" for="b-emails">Email addresses</label><textarea class="form-control" id="b-emails" rows="12" name="bemail"></textarea></div>
    <button class="btn btn-primary" type="submit">Subscribe Emails</button>
  </fieldset>
</form>
{% endblock %}
