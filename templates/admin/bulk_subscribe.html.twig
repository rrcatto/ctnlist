{% extends 'base.html.twig' %}

{% block title %}Bulk subscribe{% endblock %}

{% block content %}
{% include 'layout/_page_header.html.twig' with {title: 'Bulk subscribe', description: 'Adds many addresses to a list as pending members. Each is sent an invitation to confirm; no consent is recorded.'} %}

<form action="{{ path('admin_bulk_subscribe_submit') }}" method="post" class="card">
  <div class="card-body">
    <input type="hidden" name="csrf" value="{{ csrf_token('ctnlist') }}">
    <div class="row g-3">
      <div class="col-md-8"><label class="form-label" for="list_id">List</label>{% include 'admin/_list_select.html.twig' with {name: 'list_id', selected: (lists|first).l_id ?? 0} %}</div>
      <div class="col-md-4"><label class="form-label" for="b-priority">Priority</label><input class="form-control" id="b-priority" type="number" name="s_priority" value="10"></div>
      <div class="col-12">
        <label class="form-label" for="b-emails">Email addresses</label>
        <textarea class="form-control font-monospace" id="b-emails" rows="12" name="bemail" aria-describedby="b-emails-help"></textarea>
        <div class="form-text" id="b-emails-help">Separate addresses with commas, spaces or new lines. Anything that is not a usable address is ignored.</div>
      </div>
    </div>
  </div>
  <div class="card-footer d-flex flex-wrap gap-2">
    <button class="btn btn-primary" type="submit"><i class="bi bi-person-plus me-1" aria-hidden="true"></i>Subscribe addresses</button>
    <a class="btn btn-outline-secondary" href="{{ path('admin_subscribers') }}">Cancel</a>
  </div>
</form>
{% endblock %}
