{% extends 'base.html.twig' %}
{% import 'admin/_macros.html.twig' as ui %}

{% block title %}Role: {{ role.r_name }}{% endblock %}

{% block content %}
{% set custom = not role.r_system %}
{% set can_edit_permissions = custom and is_granted('acl.manage') %}
{% set here = path('admin_role', {id: role.r_id}) %}
{% set group_labels = {acl: 'Access control', archives: 'Archives', lists: 'Lists', logs: 'Logs', messages: 'Messages', profile: 'Profile', queue: 'Queue', roles: 'Roles', subscribers: 'Subscribers', system: 'System', templates: 'Templates'} %}
{% set groups = {} %}
{% for permission in permissions %}
  {% set prefix = permission.ap_key|split('.')|first %}
  {% set groups = groups|merge({(prefix): (groups[prefix] ?? [])|merge([permission])}) %}
{% endfor %}
{% set granted_permissions = permissions|filter(permission => permission.ap_id in granted) %}

{% embed 'layout/_page_header.html.twig' with {title: role.r_name, description: role.r_description ?: (custom ? 'Custom role.' : 'System role.')} %}
  {% block actions %}<a class="btn-outline theme-secondary" href="{{ path('admin_roles') }}"><i class="bi bi-arrow-left me-1" aria-hidden="true"></i>All roles</a>{% endblock %}
{% endembed %}
<p class="mb-7">{{ ui.system_badge(role.r_system) }} <span class="ms-3 small fg-2">Key <code>{{ role.r_key }}</code> · {{ pagination.total }} {{ pagination.total == 1 ? 'member' : 'members' }} · {{ granted|length }} {{ granted|length == 1 ? 'permission' : 'permissions' }}</span></p>

{% if not custom %}
  <div class="alert theme-secondary small" role="note"><i class="bi bi-lock" aria-hidden="true"></i>
    <div>System roles are fixed: they cannot be renamed or deleted, their permissions are set by the schema, and their assignments are not removed here.
    {% if role.r_key == 'subscriber' %}Every subscriber holds this role.{% elseif role.r_key == 'administrator' %}Administrators hold every permission.{% endif %}</div>
  </div>
{% endif %}

<div class="row g-7 mb-7">
  {% if custom %}
    <div class="lg:col-5">
      {{ form_start(details_form, {attr: {class: 'card h-100', id: 'role-details'}}) }}
        <div class="card-header fw-semibold">Details</div>
        <div class="card-body">
          {{ form_errors(details_form) }}
          <div class="mb-5">
            <span class="form-label d-block">Key</span>
            <code class="fs-md">{{ role.r_key }}</code>
            <div class="form-text">The key identifies the role and cannot be changed.</div>
          </div>
          {{ form_row(details_form.name) }}
          {{ form_row(details_form.description, {row_attr: {class: 'mb-0'}}) }}
        </div>
        <div class="card-footer"><button class="btn-solid theme-primary" type="submit"><i class="bi bi-check-lg me-1" aria-hidden="true"></i>Save details</button></div>
      {{ form_end(details_form) }}
    </div>
  {% endif %}

  <div class="{{ custom ? 'lg:col-7' : 'col-12' }}">
    {{ form_start(permissions_form, {attr: {class: 'card h-100', id: 'role-permissions'}}) }}
      <div class="card-header fw-semibold d-flex flex-row justify-content-between align-items-center">
        <span>Permissions</span>
        {% if custom and not can_edit_permissions %}<span class="small fw-normal fg-2">Read only: changing them needs <code>acl.manage</code></span>{% endif %}
      </div>
      <div class="card-body">
        {% if not permissions_form.vars.valid %}<div class="alert theme-danger" role="alert"><div>{{ form_errors(permissions_form) }}{{ form_errors(permissions_form.permissions) }}</div></div>{% endif %}
        {% set by_id = {} %}
        {% for permission in permissions %}{% set by_id = by_id|merge({('p' ~ permission.ap_id): permission}) %}{% endfor %}
        <fieldset>
          <legend class="visually-hidden">Permissions for {{ role.r_name }}</legend>
          <div class="row g-5">
            {% for prefix, group in groups %}
              <div class="sm:col-6">
                <div class="small fw-semibold text-uppercase fg-2 mb-1">{{ group_labels[prefix] ?? prefix|capitalize }}</div>
                {% for choice in permissions_form.permissions|filter(c => c.vars.label|split('.')|first == prefix) %}
                  {% set permission = by_id['p' ~ choice.vars.value] %}
                  {{ form_widget(choice, {label: permission.ap_name|e ~ ' <code class="small">' ~ permission.ap_key|e ~ '</code>', label_html: true}) }}
                {% endfor %}
              </div>
            {% endfor %}
          </div>
          {% do permissions_form.permissions.setRendered %}
        </fieldset>
      </div>
      {% if can_edit_permissions %}
        <div class="card-footer"><button class="btn-solid theme-primary" type="submit"><i class="bi bi-check-lg me-1" aria-hidden="true"></i>Save permissions</button></div>
      {% endif %}
    {{ form_end(permissions_form) }}
  </div>
</div>

<div class="card mb-7">
  <div class="card-header fw-semibold d-flex flex-row flex-wrap justify-content-between align-items-center gap-3">
    <span>Members</span>
    <a class="btn-sm btn-outline theme-primary" href="{{ path('admin_roles') }}#assign"><i class="bi bi-person-plus me-1" aria-hidden="true"></i>Assign to a subscriber</a>
  </div>
  {% if members is empty %}
    <div class="card-body">{% include 'layout/_empty_state.html.twig' with {icon: 'people', message: 'Nobody holds this role.'} %}</div>
  {% else %}
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class=""><tr><th scope="col">Subscriber</th><th scope="col">Name</th><th scope="col">Assigned</th>{% if custom %}<th scope="col" class="text-end"><span class="visually-hidden">Actions</span></th>{% endif %}</tr></thead>
        <tbody>
        {% for member in members %}
          <tr>
            <td>{% if is_granted('subscribers.manage') %}<a href="{{ path('admin_subscriber', {token: member.s_uuid}) }}">{{ member.s_email }}</a>{% else %}{{ member.s_email }}{% endif %}</td>
            <td>{{ (member.s_fname ~ ' ' ~ member.s_lname)|trim }}</td>
            <td class="text-nowrap">{{ member.sr_assigned_at|slice(0, 16) }}</td>
            {% if custom %}
              <td class="text-end">
                <form method="post" action="{{ path('admin_roles_unassign') }}" data-confirm="Remove {{ role.r_name }} from {{ member.s_email }}?">
                  <input type="hidden" name="csrf" value="{{ csrf_token('ctnlist') }}">
                  <input type="hidden" name="subscriber_id" value="{{ member.s_id }}">
                  <input type="hidden" name="role_id" value="{{ role.r_id }}">
                  <input type="hidden" name="back" value="{{ pagination.page > 1 ? here ~ '/' ~ pagination.page : here }}">
                  <button class="btn-sm btn-outline theme-danger" type="submit" aria-label="Remove {{ role.r_name }} from {{ member.s_email }}"><i class="bi bi-x-lg" aria-hidden="true"></i><span class="d-none md:d-inline ms-1">Remove</span></button>
                </form>
              </td>
            {% endif %}
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
    <div class="card-body pt-0">{% include '_pagination.html.twig' with {base: here} %}</div>
  {% endif %}
</div>

{% if custom %}
  <div class="card border-subtle-danger">
    <div class="card-body">
      <h2 class="h6">Delete this role</h2>
      <p class="small mb-3">Deleting <strong>{{ role.r_name }}</strong> removes it from {{ pagination.total }} {{ pagination.total == 1 ? 'subscriber' : 'subscribers' }}
        {%- if granted_permissions is empty %} (it grants no permissions).{% else %}, who lose these permissions unless another role grants them:{% endif %}</p>
      {% if granted_permissions is not empty %}
        <p class="small">{% for permission in granted_permissions %}<code class="me-3">{{ permission.ap_key }}</code>{% endfor %}</p>
      {% endif %}
      <form method="post" action="{{ path('admin_role_delete', {id: role.r_id}) }}" data-confirm="Delete the role {{ role.r_name }} and remove it from {{ pagination.total }} {{ pagination.total == 1 ? 'subscriber' : 'subscribers' }}?">
        <input type="hidden" name="csrf" value="{{ csrf_token('ctnlist') }}">
        <button class="btn-outline theme-danger" type="submit"><i class="bi bi-trash me-1" aria-hidden="true"></i>Delete role</button>
      </form>
    </div>
  </div>
{% endif %}
{% endblock %}
