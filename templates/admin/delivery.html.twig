{% extends 'base.html.twig' %}

{% block title %}Delivery{% endblock %}

{% block content %}
{% include 'layout/_page_header.html.twig' with {title: 'Delivery through catto-mail', description: 'Campaign content (queue sends, proofs, resends and forwards) is rendered here and delivered by catto-mail. Open a message from the message list to see its send jobs.'} %}

<div class="row g-4">
  <div class="col-lg-5">
    <div class="card h-100">
      <div class="card-header fw-semibold">Connection</div>
      <div class="card-body small">
        {% if problem %}
          <div class="alert alert-warning mb-3" role="note">{{ problem }}</div>
        {% else %}
          <p><i class="bi bi-check-circle text-success me-1" aria-hidden="true"></i>API configured (key held in .env, never shown).</p>
        {% endif %}
        <p>Webhook endpoint: <code class="text-break">{{ url('cattomail_webhook') }}</code><br>
          Signing secrets configured: {{ webhook_secrets }}{{ webhook_secrets == 2 ? ' (rotation overlap)' }}{{ webhook_secrets == 0 ? ' — webhooks are refused until CATTOMAIL_WEBHOOK_SECRET is set' }}</p>
        <p class="mb-0">Global opt-out capability: {{ global_optout ? 'enabled' : 'not enabled' }}</p>
      </div>
    </div>
  </div>
  <div class="col-lg-7">
    <div class="card h-100">
      <div class="card-header fw-semibold">Recent webhook events</div>
      {% if webhooks is empty %}
        <div class="card-body">{% include 'layout/_empty_state.html.twig' with {icon: 'broadcast', message: 'No webhook events received yet.'} %}</div>
      {% else %}
        <div class="table-responsive">
          <table class="table table-sm table-hover align-middle mb-0">
            <thead class="table-light"><tr><th scope="col">Type</th><th scope="col">Received</th><th scope="col">Outcome</th></tr></thead>
            <tbody>
            {% for event in webhooks %}
              <tr>
                <td><code>{{ event.cwe_type }}</code></td>
                <td class="text-nowrap small">{{ event.cwe_received_at|slice(0, 16) }}</td>
                <td class="small text-break">{% if event.cwe_processed_at %}{{ event.cwe_outcome }}{% else %}<span class="text-warning">pending</span>{% if event.cwe_error %} — {{ event.cwe_error|slice(0, 100) }}{% endif %}{% endif %}</td>
              </tr>
            {% endfor %}
            </tbody>
          </table>
        </div>
      {% endif %}
    </div>
  </div>
</div>
{% endblock %}
