{% extends 'base.html.twig' %}

{% block title %}Delivery{% endblock %}

{% block content %}
{% embed 'layout/_page_header.html.twig' with {title: 'Delivery', description: 'This site\'s campaign mail (queue sends, resends, forwards, and proofs unless they go to Mailpit) is delivered by its mail service, catto-mail; this page shows the connection and what happened to the mail. Sign-in links and notifications go through the site\'s own SMTP server.'} %}
  {% block actions %}
    {% import 'layout/_htmx.html.twig' as hx %}
    <form method="post" action="{{ path('admin_delivery_check') }}" {{ hx.post(path('admin_delivery_check'), 'delivery-status') }}>
      <input type="hidden" name="csrf" value="{{ csrf_token('ctnlist') }}">
      <button class="btn-solid theme-primary" type="submit"{{ problem ? ' disabled' }}><i class="bi bi-plug me-1" aria-hidden="true"></i>Check connection</button>
    </form>
    <a class="btn-outline theme-secondary" href="{{ path('admin_delivery_webhooks') }}"><i class="bi bi-broadcast me-1" aria-hidden="true"></i>Webhook events</a>
  {% endblock %}
{% endembed %}

{% include 'admin/_delivery_status.html.twig' %}
{% endblock %}
