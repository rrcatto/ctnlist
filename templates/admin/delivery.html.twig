{% extends 'base.html.twig' %}
{% import 'admin/_cattomail_macros.html.twig' as cm %}

{% block title %}Delivery{% endblock %}

{% block content %}
{% embed 'layout/_page_header.html.twig' with {title: 'catto-mail integration', description: 'Campaign content (queue sends, proofs, resends and forwards) is rendered here and delivered by catto-mail. Transactional mail (sign-in links, invitations, notifications) goes through ctnlist\'s own SMTP server.'} %}
  {% block actions %}
    <form method="post" action="{{ path('admin_delivery_check') }}">
      <input type="hidden" name="csrf" value="{{ csrf_token('ctnlist') }}">
      <button class="btn btn-primary" type="submit"{{ problem ? ' disabled' }}><i class="bi bi-plug me-1" aria-hidden="true"></i>Check connection</button>
    </form>
    <a class="btn btn-outline-secondary" href="{{ path('admin_delivery_webhooks') }}"><i class="bi bi-broadcast me-1" aria-hidden="true"></i>Webhook events</a>
  {% endblock %}
{% endembed %}

<div class="row g-4">
  <div class="col-lg-6">
    <div class="card h-100">
      <div class="card-header fw-semibold">Connection</div>
      <div class="card-body small">
        {% if problem %}
          <div class="alert alert-warning" role="note"><i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i>{{ problem }}</div>
        {% endif %}
        {% if health %}
          {% set state = health_states[health.state] %}
          <p class="mb-1"><span class="badge text-bg-{{ state[0] }}">{{ state[1] }}</span> <span class="text-body-secondary">checked {{ health.checked_at|slice(0, 16) }}</span></p>
          {% if health.state != 'ok' %}<p class="mb-1">{{ state[2] }}</p>{% endif %}
          <p class="text-body-secondary text-break">{{ health.detail }}</p>
        {% elseif not problem %}
          <p class="text-body-secondary">Not checked yet: use <strong>Check connection</strong> (one read-only request; nothing is created at catto-mail).</p>
        {% endif %}
        <dl class="row mb-0">
          <dt class="col-sm-5">API</dt><dd class="col-sm-7 text-break"><code>{{ api_root ?: '—' }}</code></dd>
          {% if connect_host %}<dt class="col-sm-5">Connects through</dt><dd class="col-sm-7"><code>{{ connect_host }}</code> <span class="badge text-bg-light border">development</span></dd>{% endif %}
          <dt class="col-sm-5">API key</dt><dd class="col-sm-7">{{ problem ? 'not set' : 'set in .env (never shown)' }}</dd>
          <dt class="col-sm-5">Custom CA file</dt><dd class="col-sm-7">{{ ca_file ? 'yes' : 'no' }}</dd>
          <dt class="col-sm-5">Last successful call</dt><dd class="col-sm-7">{{ activity.last_ok ? activity.last_ok|slice(0, 16) : '—' }}</dd>
          <dt class="col-sm-5">Last API error</dt><dd class="col-sm-7 text-break">{% if activity.last_error %}<span class="text-body-secondary">{{ activity.last_error_at|slice(0, 16) }}</span> {{ activity.last_error|slice(0, 300) }}{% else %}—{% endif %}</dd>
          <dt class="col-sm-5">Open and click tracking</dt><dd class="col-sm-7">{{ tracking.opens ? 'opens' : 'no opens' }}, {{ tracking.clicks ? 'clicks' : 'no clicks' }}</dd>
          <dt class="col-sm-5">Global opt-out</dt><dd class="col-sm-7 mb-0">{{ global_optout ? 'offered to subscribers' : 'not offered' }}</dd>
        </dl>
      </div>
    </div>
  </div>

  <div class="col-lg-6">
    <div class="card h-100">
      <div class="card-header fw-semibold">Webhooks and worker</div>
      <div class="card-body small">
        <dl class="row">
          <dt class="col-sm-5">Endpoint to register</dt><dd class="col-sm-7"><code class="text-break">{{ url('cattomail_webhook') }}</code></dd>
          <dt class="col-sm-5">Signing secret</dt><dd class="col-sm-7">{% if secrets.current %}set{% else %}<span class="text-danger">not set: webhooks are refused (CATTOMAIL_WEBHOOK_SECRET)</span>{% endif %}</dd>
          <dt class="col-sm-5">Previous secret</dt><dd class="col-sm-7 mb-0">{{ secrets.previous ? 'set: the rotated-out secret is still accepted (remove it once catto-mail stops signing with it)' : 'not set' }}</dd>
        </dl>
        <hr>
        <p class="mb-1">Webhooks are the primary path; the worker (<code>ctnlist:cattomail:work</code>, from cron every minute) is the safety net: it processes stored events, retries unsent work and polls jobs not updated for {{ (reconcile_after / 60)|round }} minutes.</p>
        {% if worker_stale %}
          <div class="alert alert-warning mt-2 mb-2" role="note"><i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i>{{ activity.worker_run ? 'The worker last ran ' ~ activity.worker_run|slice(0, 16) ~ '.' : 'The worker has never run.' }} Check the cron entry.</div>
        {% endif %}
        <p class="mb-0">Last run: {{ activity.worker_run ? activity.worker_run|slice(0, 16) : '—' }}{% if activity.worker_summary %}<br><span class="text-body-secondary">{{ activity.worker_summary }}</span>{% endif %}</p>
      </div>
    </div>
  </div>

  <div class="col-12">
    <div class="card">
      <div class="card-header fw-semibold">Pending and stuck work</div>
      <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
          <tbody>
            {% set rows = [
              ['Send jobs not yet sealed at catto-mail', counts.jobs_unsealed, 'Staged or uploading; the worker finishes them once their run is over.'],
              ['Recipients staged, not yet handed off', counts.recipients_staged, 'Kept until their job is sealed; not in the Send Log yet.'],
              ['Send jobs being delivered', counts.jobs_in_flight, 'Sealed (queued, processing or dispatched); outcomes arrive by webhook and polling.'],
              ['Send jobs refused by catto-mail', counts.jobs_failed, 'Open the message\'s delivery page to see why; recipients can be returned to the queue.'],
              ['Empty jobs left collecting at catto-mail', counts.jobs_empty_remote, 'Created at catto-mail but never given recipients (a lost response); the API offers no cancel, so they stay empty and send nothing.'],
              ['Validation jobs in progress', counts.validations_pending, ''],
              ['Global opt-outs or withdrawals to report', counts.optouts_pending, ''],
              ['Global opt-outs refused by catto-mail', counts.optouts_rejected, 'Usually the opt-out capability was withdrawn by the catto-mail operator.'],
              ['Webhook events not processed yet', counts.webhooks_unprocessed, ''],
              ['Webhook events that failed', counts.webhooks_failed, 'Recorded and given up after repeated failures.'],
            ] %}
            {% for row in rows %}
              <tr>
                <th scope="row" class="fw-normal">{{ row[0] }}</th>
                <td class="text-end fw-semibold{{ row[1] > 0 and loop.index in [4, 5, 8, 10] ? ' text-danger' }}">{{ row[1] }}</td>
                <td class="small text-body-secondary d-none d-md-table-cell">{{ row[2] }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="col-12">
    <div class="card">
      <div class="card-header fw-semibold">Recent send runs</div>
      {% if runs is empty %}
        <div class="card-body">{% include 'layout/_empty_state.html.twig' with {icon: 'send', message: 'Nothing has been handed to catto-mail yet.'} %}</div>
      {% else %}
        <div class="card-body small text-body-secondary pb-0">A run is what was started here (a queue run, a proof, a resend or a forward). catto-mail jobs hold at most 10,000 recipients and one list each, so one run can be several jobs (external reference <code>&lt;run&gt;/&lt;job number&gt;</code>).</div>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light"><tr><th scope="col">Run</th><th scope="col">Message</th><th scope="col" class="text-end">Jobs</th><th scope="col" class="text-end">Recipients</th><th scope="col">Job states</th><th scope="col">Started</th></tr></thead>
            <tbody>
            {% for run in runs %}
              <tr>
                <td><a href="{{ path('admin_delivery_run', {uuid: run.cr_uuid}) }}">{{ run.cr_kind }}</a><div class="small text-body-secondary text-break">{{ run.cr_uuid }}</div></td>
                <td>{% if run.cr_muid %}<a href="{{ path('admin_delivery_message', {muid: run.cr_muid}) }}">{{ run.m_subject ?: run.cr_muid }}</a>{% else %}—{% endif %}</td>
                <td class="text-end">{{ run.jobs }}</td>
                <td class="text-end">{{ run.recipients }}</td>
                <td>{% for status in run.statuses|split(', ') %}{{ cm.job_status(status) }} {% endfor %}</td>
                <td class="small text-nowrap">{{ run.cr_created_at|slice(0, 16) }}</td>
              </tr>
            {% endfor %}
            </tbody>
          </table>
        </div>
      {% endif %}
    </div>
  </div>

  <div class="col-12">
    <div class="card">
      <div class="card-header fw-semibold d-flex justify-content-between align-items-center">Recent webhook events <a class="small fw-normal" href="{{ path('admin_delivery_webhooks') }}">All events</a></div>
      {% if webhooks is empty %}
        <div class="card-body">{% include 'layout/_empty_state.html.twig' with {icon: 'broadcast', message: 'No webhook events received yet.'} %}</div>
      {% else %}
        <div class="table-responsive">
          <table class="table table-sm table-hover align-middle mb-0">
            <thead class="table-light"><tr><th scope="col">Type</th><th scope="col">Received</th><th scope="col">Outcome</th></tr></thead>
            <tbody>
            {% for event in webhooks %}
              <tr>
                <td><code>{{ event.cwe_type }}</code></td>
                <td class="text-nowrap small">{{ event.cwe_received_at|slice(0, 16) }}</td>
                <td class="small text-break">{% if event.cwe_processed_at %}{{ event.cwe_outcome }}{% else %}<span class="text-warning">pending</span>{% if event.cwe_error %} — {{ event.cwe_error|slice(0, 100) }}{% endif %}{% endif %}</td>
              </tr>
            {% endfor %}
            </tbody>
          </table>
        </div>
      {% endif %}
    </div>
  </div>
</div>
{% endblock %}
