{% extends 'base.html.twig' %}
{% import 'layout/_htmx.html.twig' as hx %}

{% block title %}Send job {{ job.csj_id }}{% endblock %}

{% block content %}
{% embed 'layout/_page_header.html.twig' with {title: 'Send job ' ~ job.csj_id, description: (job.csj_list_shortcode ? 'List ' ~ job.csj_list_shortcode ~ ' · ' : '') ~ job.csj_message_class ~ ' · ' ~ job.csj_total ~ ' recipients'} %}
  {% block actions %}
    {% if job.csj_muid %}<a class="btn-outline theme-secondary" href="{{ path('admin_delivery_message', {muid: job.csj_muid}) }}"><i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Message</a>{% endif %}
  {% endblock %}
{% endembed %}

{% set base = path('admin_delivery_job', {id: job.csj_id}) %}
<form method="get" action="{{ base }}" class="card card-body bg-1 mb-5" role="search" aria-label="Filter recipients" {{ hx.search(base, 'send-job') }}>
  <div class="d-flex flex-wrap gap-3 align-items-end">
    <div>
      <label class="form-label small" for="d-status">Status</label>
      <select class="form-control form-control-sm" id="d-status" name="s">
        <option value="">All</option>
        {% for s in statuses %}<option value="{{ s }}"{{ status == s ? ' selected' }}>{{ s|replace({'_': ' '}) }}</option>{% endfor %}
      </select>
    </div>
    <noscript><button class="btn-sm btn-solid theme-primary" type="submit">Filter</button></noscript>
    {% if status %}<a class="btn-sm btn-outline theme-secondary" href="{{ base }}">Clear</a>{% endif %}
    <span class="small fg-2 htmx-indicator" role="status">Loading…</span>
  </div>
</form>

{% include 'admin/_delivery_job.html.twig' %}
{% endblock %}
