# A stand-in for a server that has what README "Requirements" asks for, used only by
# bin/dev test-installer (dev/installer-test/run.sh): Ubuntu 26.04 with systemd as PID 1,
# PHP 8.5 with PHP-FPM, Composer, Git, PostgreSQL and nginx. install-ctnlist does the rest.
FROM docker.io/library/ubuntu:26.04
RUN apt-get update -qq \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends \
      systemd systemd-sysv dbus iproute2 ca-certificates git curl openssl unzip nginx postgresql composer \
      php8.5-fpm php8.5-cli php8.5-pgsql php8.5-gd php8.5-mbstring php8.5-xml php8.5-intl php8.5-curl >/dev/null \
 && rm -rf /var/lib/apt/lists/*
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
