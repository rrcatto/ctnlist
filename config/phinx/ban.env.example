# Global suppression (banlist) database, read by ctnlist and config/phinx/phinx-banlist.php.
# Keep the real file outside the source tree (GDB_ENV_DIRECTORY/GDB_ENV_FILE), mode 640.
GDB_DRIVER=pgsql
GDB_HOST=127.0.0.1
GDB_PORT=5432
GDB_NAME=banlist
GDB_USER=banlist
# A generated password (openssl rand -base64 24); never a placeholder.
GDB_PASS=
GDB_SSLMODE=prefer
